+static void cuda_moe_tiering_admit_adjust_threshold(
+        uint32_t base, uint32_t *current,
+        uint64_t free_promotions, uint64_t replacements) {
+    if (!current) return;
+    const uint64_t total = free_promotions + replacements;
+    if (total == 0u) return;
+    /* Per-boundary analogue of
+     * policy_replacements/(policy_free_promotions+policy_replacements). */
+    const double pressure = (double)replacements / (double)total;
+    const uint32_t floor = std::max(1u, base);
+    if (pressure >= 0.5) {
+        if (*current < UINT16_MAX) (*current)++;
+    } else if (pressure <= 0.25 && *current > floor) {
+        (*current)--;
+    }
+}
+
+static void cuda_moe_tiering_admit_refresh_window(void) {
+    if (!g_moe_tiering.policy_admit_enabled ||
+        g_moe_tiering.policy_clock_calls == 0u) {
+        return;
+    }
+    const uint64_t epoch = g_moe_tiering.call_tick /
+        (uint64_t)g_moe_tiering.policy_clock_calls;
+    if (epoch == g_moe_tiering.policy_admit_epoch) return;
+    if (g_moe_tiering.policy_admit_epoch != UINT64_MAX) {
+        uint64_t elapsed = epoch > g_moe_tiering.policy_admit_epoch ?
+            epoch - g_moe_tiering.policy_admit_epoch : 1u;
+        if (elapsed > 16u) elapsed = 16u;
+        for (uint32_t i = 0;
+             i < CUDA_MOE_LAYER_COUNT * 256u; i++) {
+            g_moe_tiering.admit_knocks[i] =
+                (uint16_t)(g_moe_tiering.admit_knocks[i] >> elapsed);
+        }
+        if (g_moe_tiering.policy_admit_adaptive) {
+            cuda_moe_tiering_admit_adjust_threshold(
+                g_moe_tiering.policy_admit_knocks_ssd,
+                &g_moe_tiering.policy_admit_current_ssd,
+                g_moe_tiering.policy_admit_window_free_ssd,
+                g_moe_tiering.policy_admit_window_replacements_ssd);
+            cuda_moe_tiering_admit_adjust_threshold(
+                g_moe_tiering.policy_admit_knocks_warm,
+                &g_moe_tiering.policy_admit_current_warm,
+                g_moe_tiering.policy_admit_window_free_warm,
+                g_moe_tiering.policy_admit_window_replacements_warm);
+            cuda_moe_tiering_admit_adjust_threshold(
+                g_moe_tiering.policy_admit_knocks_vram,
+                &g_moe_tiering.policy_admit_current_vram,
+                g_moe_tiering.policy_admit_window_free_vram,
+                g_moe_tiering.policy_admit_window_replacements_vram);
+        }
+        g_moe_tiering.policy_admit_window_free_ssd = 0u;
+        g_moe_tiering.policy_admit_window_replacements_ssd = 0u;
+        g_moe_tiering.policy_admit_window_free_warm = 0u;
+        g_moe_tiering.policy_admit_window_replacements_warm = 0u;
+        g_moe_tiering.policy_admit_window_free_vram = 0u;
+        g_moe_tiering.policy_admit_window_replacements_vram = 0u;
+    }
+    g_moe_tiering.policy_admit_epoch = epoch;
+}
+
+static uint16_t cuda_moe_tiering_admit_note(
+        uint32_t layer, uint32_t expert) {
+    cuda_moe_tiering_admit_refresh_window();
+    const size_t index = cuda_moe_tiering_entry_index(layer, expert);
+    uint16_t &knocks = g_moe_tiering.admit_knocks[index];
+    if (knocks != UINT16_MAX) knocks++;
+    return knocks;
+}
+
+static int cuda_moe_tiering_admit_gate(
+        const cuda_moe_tier_entry &entry, uint32_t layer, uint32_t expert,
+        uint32_t threshold, double mass_bypass,
+        uint64_t *knock_skips, uint64_t *mass_bypasses) {
+    if (threshold == 0u) return 1;
+    const uint16_t knocks = g_moe_tiering.admit_knocks[
+        cuda_moe_tiering_entry_index(layer, expert)];
+    if ((uint32_t)knocks >= threshold) return 1;
+    if (mass_bypass > 0.0 && entry.mass >= mass_bypass) {
+        if (mass_bypasses) (*mass_bypasses)++;
+        return 1;
+    }
+    if (knock_skips) (*knock_skips)++;
+    return 0;
+}
