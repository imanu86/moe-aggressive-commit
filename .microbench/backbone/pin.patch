+    const uint32_t slots = g_moe_expert_cache.capacity;
+    const uint32_t resident = g_moe_expert_cache.count;
+    const uint64_t slot_bytes =
+        g_moe_expert_cache.gate_expert_bytes * 2ull +
+        g_moe_expert_cache.down_expert_bytes;
+    const uint64_t bytes = slot_bytes * (uint64_t)slots;
+
+    /* Impedisce a un fallback concorrente di ricreare subito lo stesso slab. */
+    g_vram_pin_expert_cache_shed = 1;
+    cuda_moe_expert_cache_release();
+    if (g_moe_expert_cache.capacity != 0u ||
+        g_moe_expert_cache.packed_base != NULL ||
+        g_moe_expert_cache.gate != NULL ||
+        g_moe_expert_cache.up != NULL ||
+        g_moe_expert_cache.down != NULL) {
+        g_vram_pin_expert_cache_shed_failures++;
+        fprintf(stderr,
+                "ds4: [vram-prio] PIN degrade result=blocked "
+                "category=resident-expert-slab requester=%s "
+                "slots=%u resident=%u bytes=%llu "
+                "reason=worker-not-quiescent action=backbone-failopen\n",
+                requester ? requester : "weights", slots, resident,
+                (unsigned long long)bytes);
+        return 0;
+    }
+
+    g_vram_pin_expert_cache_sheds++;
+    g_vram_pin_expert_cache_slots_ceded += slots;
+    g_vram_pin_expert_cache_resident_ceded += resident;
+    g_vram_pin_expert_cache_bytes_ceded += bytes;
+    fprintf(stderr,
+            "ds4: [vram-prio] PIN degrade result=ok "
+            "category=resident-expert-slab requester=%s "
+            "slots=%u resident=%u bytes=%llu "
+            "action=disable-cache-exact-streaming\n",
+            requester ? requester : "weights", slots, resident,
+            (unsigned long long)bytes);
+    return 1;
+}
