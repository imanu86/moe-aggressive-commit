+static int cuda_vram_pin_shed_expert_cache(const char *requester) {
+    if (!cuda_vram_pin_backbone_enabled() ||
+        g_vram_pin_expert_cache_shed ||
+        g_moe_expert_cache.capacity == 0u) {
+        return 0;
+    }
