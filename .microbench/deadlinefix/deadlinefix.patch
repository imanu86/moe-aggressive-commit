+/* Prima di riemettere la stessa lettura, prova che il kernel non possieda piu'
+ * OVERLAPPED/buffer. Il reset avviene soltanto dopo pending()==0. */
+static int cuda_moe_transient_prepare_retry_slot(
+        cuda_moe_expert_cache *cache, uint32_t sequence,
+        const char **skipped_reason) {
+    const int cancelled =
+        cache->route_transient_cancel_sequence.load(
+            std::memory_order_acquire) == sequence;
+    const int deadline_cancelled =
+        cache->route_transient_timeout_cancel_sequence.load(
+            std::memory_order_acquire) == sequence;
+    if (cancelled && !deadline_cancelled) {
+        if (skipped_reason) *skipped_reason = "cancel-sequence";
+        return 0;
+    }
+    const double cancel_ack_deadline = cuda_wall_sec() + 1.0;
+    while (os_pread_cancellable_pending(&cache->route_transient_pread)) {
+        if (cache->route_worker_safe_leaked.load(
+                std::memory_order_acquire)) {
+            if (skipped_reason) *skipped_reason = "safe-leaked";
+            return 0;
+        }
+        if (cache->route_stop.load(std::memory_order_acquire)) {
+            if (skipped_reason) *skipped_reason = "route-stop";
+            return 0;
+        }
+        if (cuda_wall_sec() >= cancel_ack_deadline) {
+            if (skipped_reason) *skipped_reason = "cancel-ack-timeout";
+            return 0;
+        }
+#ifdef _WIN32
+        (void)SwitchToThread();
+#else
+        usleep(0);
+#endif
+    }
+    os_pread_cancellable_reset(&cache->route_transient_pread);
+    if (deadline_cancelled) {
+        cache->route_transient_cancel_sequence.store(
+            0u, std::memory_order_release);
+        cache->route_transient_timeout_cancel_sequence.store(
+            0u, std::memory_order_release);
+    }
+    return 1;
+}
