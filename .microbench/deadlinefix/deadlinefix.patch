+struct cuda_moe_transient_deadline_policy {
+    double base_seconds;
+    double seconds_per_mib;
+    double floor_seconds;
+    double cap_seconds;
+    double retry_backoff_seconds;
+    double fallback_backoff_seconds;
+    uint64_t eviction_storm_threshold;
+};
+
+static double cuda_moe_transient_deadline_env_seconds(
+        const char *name, double fallback) {
+    const char *value = getenv(name);
+    if (!value || !value[0]) return fallback;
+    char *end = NULL;
+    errno = 0;
+    const double parsed = strtod(value, &end);
+    if (errno == 0 && end != value && end && *end == '\0' &&
+        isfinite(parsed) && parsed >= 0.0 && parsed <= 3600.0) {
+        return parsed;
+    }
+    fprintf(stderr, "ds4: invalid %s=%s; using %.3f\n",
+            name, value, fallback);
+    return fallback;
+}
+
+static const cuda_moe_transient_deadline_policy &
+cuda_moe_transient_deadline_policy_get(void) {
+    static int initialized = 0;
+    static cuda_moe_transient_deadline_policy policy = {};
+    if (initialized) return policy;
+    initialized = 1;
+    policy.base_seconds = cuda_g133_transient_io_timeout_seconds();
+    policy.seconds_per_mib = cuda_moe_transient_deadline_env_seconds(
+        "DS4_CUDA_TRANSIENT_DEADLINE_PER_MB_S", 0.050);
+    policy.floor_seconds = cuda_moe_transient_deadline_env_seconds(
+        "DS4_CUDA_TRANSIENT_DEADLINE_FLOOR_S", policy.base_seconds);
+    const double default_cap = std::max(5.0, policy.floor_seconds);
+    policy.cap_seconds = cuda_moe_transient_deadline_env_seconds(
+        "DS4_CUDA_TRANSIENT_DEADLINE_CAP_S", default_cap);
+    if (policy.cap_seconds < policy.floor_seconds) {
+        fprintf(stderr,
+                "ds4: DS4_CUDA_TRANSIENT_DEADLINE_CAP_S below floor; "
+                "raising cap from %.3f to %.3f\n",
+                policy.cap_seconds, policy.floor_seconds);
+        policy.cap_seconds = policy.floor_seconds;
+    }
+    policy.retry_backoff_seconds = 0.010;
+    policy.fallback_backoff_seconds = 0.025;
+    policy.eviction_storm_threshold = 4u;
+    fprintf(stderr,
+            "ds4: [transient-deadline] adaptive=1 base_s=%.3f "
+            "per_mb_s=%.3f floor_s=%.3f cap_s=%.3f "
+            "retry_backoff_ms=%.1f fallback_backoff_ms=%.1f "
+            "eviction_storm_threshold=%llu\n",
+            policy.base_seconds, policy.seconds_per_mib,
+            policy.floor_seconds, policy.cap_seconds,
+            policy.retry_backoff_seconds * 1000.0,
+            policy.fallback_backoff_seconds * 1000.0,
+            (unsigned long long)policy.eviction_storm_threshold);
+    return policy;
+}
+
+static double cuda_moe_transient_deadline_budget_seconds(uint64_t bytes) {
+    const cuda_moe_transient_deadline_policy &policy =
+        cuda_moe_transient_deadline_policy_get();
+    const double requested_mib = (double)bytes / 1048576.0;
+    const double proportional =
+        policy.base_seconds + policy.seconds_per_mib * requested_mib;
+    return std::min(
+        policy.cap_seconds, std::max(policy.floor_seconds, proportional));
+}
+
+static double cuda_moe_transient_deadline_from_now(uint64_t bytes) {
+    return cuda_wall_sec() +
+        cuda_moe_transient_deadline_budget_seconds(bytes);
+}
+
+static void cuda_moe_transient_deadline_backoff(unsigned int step) {
+    const cuda_moe_transient_deadline_policy &policy =
+        cuda_moe_transient_deadline_policy_get();
+    const double seconds = step == 0u
+        ? policy.retry_backoff_seconds : policy.fallback_backoff_seconds;
+#ifdef _WIN32
+    DWORD millis = (DWORD)ceil(seconds * 1000.0);
+    if (millis == 0u) millis = 1u;
+    Sleep(millis);
+#else
+    useconds_t micros = (useconds_t)ceil(seconds * 1000000.0);
+    if (micros == 0u) micros = 1u;
+    usleep(micros);
+#endif
+}
+
+enum cuda_moe_transient_deadline_cause {
+    CUDA_MOE_TRANSIENT_DEADLINE_SLOW_IO = 0,
+    CUDA_MOE_TRANSIENT_DEADLINE_CPU_CONTENTION = 1
+};
+
+static thread_local uint64_t g_transient_deadline_last_worker_evict_count;
+static thread_local uint64_t g_transient_deadline_worker_recent_evictions;
+
+static void cuda_moe_transient_deadline_worker_request_begin(void) {
+    if (!cuda_transient_deadline_adaptive_requested()) return;
+    const uint64_t current = g_model_evict_count;
+    g_transient_deadline_worker_recent_evictions =
+        current >= g_transient_deadline_last_worker_evict_count
+        ? current - g_transient_deadline_last_worker_evict_count : current;
+    g_transient_deadline_last_worker_evict_count = current;
+}
+
+static void cuda_moe_transient_deadline_note(
+        cuda_moe_transient_deadline_cause cause,
+        uint64_t recent_evictions, uint32_t sequence) {
+    if (!cuda_transient_deadline_adaptive_requested()) return;
+    uint32_t classified =
+        g_transient_deadline_last_classified_sequence.load(
+            std::memory_order_relaxed);
+    while (classified != sequence) {
+        if (g_transient_deadline_last_classified_sequence
+                .compare_exchange_weak(
+                    classified, sequence, std::memory_order_relaxed,
+                    std::memory_order_relaxed)) break;
+    }
+    if (classified == sequence) return;
+    const cuda_moe_transient_deadline_policy &policy =
+        cuda_moe_transient_deadline_policy_get();
+    if (recent_evictions >= policy.eviction_storm_threshold) {
+        g_transient_deadline_eviction_storm.fetch_add(
+            1u, std::memory_order_relaxed);
+    } else if (cause == CUDA_MOE_TRANSIENT_DEADLINE_SLOW_IO) {
+        g_transient_deadline_slow_io.fetch_add(
+            1u, std::memory_order_relaxed);
+    } else {
+        g_transient_deadline_cpu_contention.fetch_add(
+            1u, std::memory_order_relaxed);
+    }
+}
