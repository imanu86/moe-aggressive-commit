+/* Record one generation-local completion point after every H2D and route_ptrs
+ * publication for the layer. The consumer-side wait is armed only after this
+ * succeeds. Event reuse is protected by route_consumer_done_event: the worker
+ * cannot claim generation N+1 before stream 0 has consumed generation N. */
+static int cuda_moe_route_upload_overlap_arm(
+        cuda_moe_expert_cache *cache,
+        const cuda_moe_route_request *request) {
+    if (!cache || !request || !cache->drain_overlap_requested ||
+        request->host_generation == 0u) {
+        return 0;
+    }
+    cudaEvent_t ready =
+        cache->route_upload_ready_event[request->host_generation & 1u];
+    if (!ready ||
+        cudaEventRecord(ready, cache->route_upload_stream) != cudaSuccess) {
+        (void)cudaGetLastError();
+        return 0;
+    }
+    cache->route_upload_ready_generation.store(
+        request->host_generation, std::memory_order_release);
+    return 1;
+}
