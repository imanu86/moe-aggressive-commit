+static int cuda_moe_tiering_finish_vram_reservations_overlap(
+        cuda_moe_expert_cache *cache,
+        const cuda_moe_route_request *trace_request,
+        const uint32_t *admitted,
+        const cuda_moe_vram_promotion_reservation *reservations,
+        uint32_t count, const ds4_gpu_g133_epoch &g133_epoch,
+        int commit_on_success, double absolute_deadline,
+        int *overlap_armed_out) {
+    if (overlap_armed_out) *overlap_armed_out = 0;
+    const double sync_started = g_moe_tiering.g133_enabled
+        ? cuda_wall_sec() : 0.0;
+    const uint64_t trace_sync_started = trace_request
+        ? cuda_decode_trace_request_qpc(*trace_request) : 0u;
+    const cudaError_t pending_error = cudaGetLastError();
+    const int overlap_armed =
+        commit_on_success && pending_error == cudaSuccess &&
+        cuda_moe_route_upload_overlap_arm(cache, trace_request);
+    const cudaError_t sync_error = overlap_armed
+        ? cudaSuccess
+        : cuda_g73_finish_launched_copy(
+              cache->route_upload_stream, absolute_deadline,
+              count > 0u ? reservations[0].candidate_layer : 0u,
+              "tiering-reservation");
+    cuda_decode_trace_note_upload_drain(
+        trace_request, trace_sync_started);
+    if (sync_started != 0.0 && !overlap_armed) {
+        cuda_g133_telemetry_note_upload_sync_wait(
+            cuda_wall_sec() - sync_started);
+    }
+    const int transfer_ok =
+        pending_error == cudaSuccess && sync_error == cudaSuccess;
+    if (!transfer_ok || !commit_on_success) {
+        (void)cudaGetLastError();
+        cuda_moe_tiering_refund_failed_promotions(
+            reservations, count, g133_epoch);
+        if (count > 0u) cuda_moe_expert_cache_invalidate();
+        return transfer_ok;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        cache->slots[admitted[i]].state = CUDA_MOE_CACHE_VALID;
+    }
+    cuda_moe_tiering_commit_vram_reservations(
+        cache, reservations, count, g133_epoch);
+    if (overlap_armed_out) *overlap_armed_out = overlap_armed;
+    return 1;
+}
