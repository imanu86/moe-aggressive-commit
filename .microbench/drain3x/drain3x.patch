+/* Diagnostic-only replacement for the route drain. It deliberately uses
+ * nonblocking queries so a stuck run reports the complete host/mailbox wait
+ * graph before its ordinary watchdog aborts. DRAIN_DIAG is selected once at
+ * init; the normal route-worker specialization cannot call this function. */
+static cudaError_t cuda_moe_route_drain_deadlock_diag_wait(
+        cuda_moe_expert_cache *cache,
+        const cuda_moe_route_request *request,
+        double absolute_deadline,
+        const char *site) {
+    if (!cache || !cache->route_upload_stream) {
+        return cudaErrorInvalidResourceHandle;
+    }
+    const uint32_t sequence = request
+        ? request->sequence
+        : cache->route_submitted_sequence.load(std::memory_order_acquire);
+    const uint64_t generation = request
+        ? request->host_generation
+        : cache->route_submitted_generation.load(std::memory_order_acquire);
+    const uint32_t layer = request ? request->layer_index : UINT32_MAX;
+    const double started = cuda_wall_sec();
+    double next_report = started;
+    uint64_t polls = 0u;
+    for (;;) {
+        const cudaError_t upload_status =
+            cudaStreamQuery(cache->route_upload_stream);
+        polls++;
+        if (upload_status == cudaSuccess) {
+            fprintf(stderr,
+                    "ds4: [drain-deadlock-diag] phase=complete site=%s "
+                    "seq=%u generation=%llu layer=%u elapsed_ms=%.3f "
+                    "polls=%llu\n",
+                    site ? site : "unknown", sequence,
+                    (unsigned long long)generation, layer,
+                    (cuda_wall_sec() - started) * 1000.0,
+                    (unsigned long long)polls);
+            return cudaSuccess;
+        }
+        if (upload_status != cudaErrorNotReady) {
+            fprintf(stderr,
+                    "ds4: [drain-deadlock-diag] phase=error site=%s "
+                    "seq=%u generation=%llu layer=%u upload=%s "
+                    "elapsed_ms=%.3f polls=%llu\n",
+                    site ? site : "unknown", sequence,
+                    (unsigned long long)generation, layer,
+                    cudaGetErrorString(upload_status),
+                    (cuda_wall_sec() - started) * 1000.0,
+                    (unsigned long long)polls);
+            return upload_status;
+        }
+        const double now = cuda_wall_sec();
+        if (now >= next_report) {
+            const cudaError_t default_status = cudaStreamQuery(0);
+            const cudaError_t consumer_status =
+                cache->route_consumer_done_event
+                    ? cudaEventQuery(cache->route_consumer_done_event)
+                    : cudaErrorInvalidResourceHandle;
+            cuda_moe_route_mailbox_slot &slot =
+                cache->route_mailbox[generation & 1u];
+            const uint64_t slot_generation =
+                slot.generation.load(std::memory_order_acquire);
+            const uint32_t slot_state =
+                slot.state.load(std::memory_order_acquire);
+            const uint32_t ready = cache->route_ready_host
+                ? *(volatile uint32_t *)cache->route_ready_host : 0u;
+            const uint32_t failed = cache->route_failed_host
+                ? *(volatile uint32_t *)cache->route_failed_host : 0u;
+            fprintf(stderr,
+                    "ds4: [drain-deadlock-diag] phase=poll site=%s "
+                    "seq=%u generation=%llu layer=%u elapsed_ms=%.3f "
+                    "upload=%s default=%s consumer=%s "
+                    "consumer_event_generation=%llu "
+                    "consumer_done_generation=%llu "
+                    "slot_generation=%llu slot_state=%s "
+                    "submitted=%u/%llu consumed=%u/%llu completed=%u/%llu "
+                    "ready=%u failed=%u polls=%llu\n",
+                    site ? site : "unknown", sequence,
+                    (unsigned long long)generation, layer,
+                    (now - started) * 1000.0,
+                    cudaGetErrorString(upload_status),
+                    cudaGetErrorString(default_status),
+                    cudaGetErrorString(consumer_status),
+                    (unsigned long long)
+                        cache->route_consumer_event_generation.load(
+                            std::memory_order_acquire),
+                    (unsigned long long)
+                        cache->route_consumer_done_generation.load(
+                            std::memory_order_acquire),
+                    (unsigned long long)slot_generation,
+                    cuda_moe_route_mailbox_state_name(slot_state),
+                    cache->route_submitted_sequence.load(
+                        std::memory_order_acquire),
+                    (unsigned long long)
+                        cache->route_submitted_generation.load(
+                            std::memory_order_acquire),
+                    cache->route_consumed_sequence.load(
+                        std::memory_order_acquire),
+                    (unsigned long long)
+                        cache->route_consumed_generation.load(
+                            std::memory_order_acquire),
+                    cache->route_completed_sequence.load(
+                        std::memory_order_acquire),
+                    (unsigned long long)
+                        cache->route_completed_generation.load(
+                            std::memory_order_acquire),
+                    ready, failed, (unsigned long long)polls);
+            next_report = now + 0.250;
+        }
+        if (absolute_deadline > 0.0 && now >= absolute_deadline) {
+            fprintf(stderr,
+                    "ds4: [drain-deadlock-diag] phase=deadline site=%s "
+                    "seq=%u generation=%llu layer=%u elapsed_ms=%.3f "
+                    "polls=%llu\n",
+                    site ? site : "unknown", sequence,
+                    (unsigned long long)generation, layer,
+                    (now - started) * 1000.0,
+                    (unsigned long long)polls);
+            return cudaErrorNotReady;
+        }
+#ifdef _WIN32
+        (void)SwitchToThread();
+#else
+        usleep(0);
+#endif
+    }
+}
