+/* DRAIN4 — braccio armato: sostituisce la coppia [drain bloccante -> VALID]
+ * con [cudaEventRecord sull'upload stream -> commit ottimistico].
+ * Raggiungibile SOLO dalle istanze DOV=true.  Ritorna 1 se l'overlap e'
+ * armato (il chiamante salta il drain bloccante e invalida il batch del
+ * registro, I4); ritorna 0 su QUALUNQUE precondizione mancante o fallimento
+ * del record, e il chiamante esegue il percorso bloccante attuale riga per
+ * riga — l'eventuale errore CUDA pendente NON viene azzerato qui (Peek, non
+ * Get), cosi' la cudaGetLastError del percorso bloccante lo attribuisce
+ * esattamente come oggi (niente errori inghiottiti).
+ *
+ * reservations/g133_epoch: non-NULL solo nel percorso ENFORCE (commit del
+ * tiering sul confine ottimistico, I2); il percorso legacy non-ENFORCE
+ * passa NULL e riceve solo la promozione LOADING->VALID degli slot admitted. */
+static int cuda_moe_drain_overlap4_arm(
+        cuda_moe_expert_cache *cache,
+        const cuda_moe_route_request &request,
+        const uint32_t *admitted,
+        const cuda_moe_vram_promotion_reservation *reservations,
+        uint32_t admitted_count,
+        const ds4_gpu_g133_epoch *g133_epoch) {
+    if (!cache || !cache->route_upload_stream ||
+        request.host_generation == 0u) {
+        return 0;
+    }
+    /* §3.3 del disegno: mai armare sotto la policy condivisa G133 (Q1 /
+     * SSD-wrap): quei percorsi leggono route_completed_* ai confini
+     * (request-boundary, q1-0-mixed-entry, ...) come prova di quiescenza
+     * del lavoro di rotta, e con un overlap armato la publicazione di
+     * completed non implicherebbe piu' upload drenato. */
+    if (cuda_g133_shared_policy_active()) return 0;
+    if (!cuda_moe_drain_overlap4_events_ready()) return 0;
+    if (cudaPeekAtLastError() != cudaSuccess) return 0;
+    cudaEvent_t ready_event =
+        g_moe_drain_overlap4.ready_event[request.host_generation & 1u];
+    const cudaError_t record_error =
+        cudaEventRecord(ready_event, cache->route_upload_stream);
+    if (record_error != cudaSuccess) {
+        fprintf(stderr,
+                "ds4: [drain-overlap4] result=record-failed seq=%u layer=%u "
+                "cuda=%s; ricado sul drain bloccante\n",
+                request.sequence, request.layer_index,
+                cudaGetErrorString(record_error));
+        return 0;
+    }
+    /* Commit ottimistico (I2): nessun attore puo' osservare questi VALID
+     * con copie in volo — i kernel consumer stanno dietro il waitEvent del
+     * consumer, il riciclo degli slot dietro il claim-gate. */
+    for (uint32_t i = 0; i < admitted_count; i++) {
+        cache->slots[admitted[i]].state = CUDA_MOE_CACHE_VALID;
+    }
+    if (reservations && g133_epoch) {
+        cuda_moe_tiering_commit_vram_reservations(
+            cache, reservations, admitted_count, *g133_epoch);
+    }
+    /* I4, versione minima DICHIARATA: senza prova di completamento al
+     * finish il batch H2D va invalidato, mai contabilizzato.  Una riga di
+     * dichiarazione una-tantum accanto al registro, mai taciuta. */
+    if (!g_moe_drain_overlap4.transport_note_emitted &&
+        cuda_transport_ledger_enabled()) {
+        g_moe_drain_overlap4.transport_note_emitted = 1;
+        fprintf(stderr,
+                "ds4: [transport] drain_overlap4=minimal: i batch H2D "
+                "sotto overlap sono invalidati (ledger_complete=0 per "
+                "disegno)\n");
+    }
+    /* Pubblicazione del sidecar: prima i timestamp (relaxed), poi la
+     * generazione (release) — il consumer fa acquire sulla generazione. */
+    g_moe_drain_overlap4.complete_ns.store(0u, std::memory_order_relaxed);
+    g_moe_drain_overlap4.armed_ns.store(
+        ds4_workerprof_now_ns(), std::memory_order_relaxed);
+    g_moe_drain_overlap4.armed_generation.store(
+        request.host_generation, std::memory_order_release);
+    return 1;
+}
