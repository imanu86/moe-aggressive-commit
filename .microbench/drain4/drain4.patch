+/* =======================================================================
+ * DRAIN4 (DS4_CUDA_DRAIN_OVERLAP4=1, opt-in) — drain sovrapposto al compute.
+ *
+ * Il worker smette di drenare route_upload_stream in modo bloccante prima
+ * di pubblicare route_ready: registra un evento CUDA sull'upload stream
+ * (dopo l'ultimo publish) e il consumer accoda cudaStreamWaitEvent su
+ * stream 0 prima dei kernel che dereferenziano slot o route_ptrs in volo.
+ * Lo spigolo di visibilita' (I1) passa da host a device; la transazione
+ * slot LOADING->VALID (I2) diventa ottimistica ed e' legale perche' l'unico
+ * lettore (i kernel consumer) sta dietro il waitEvent e l'unico riciclatore
+ * (il worker alla generazione successiva) sta dietro il claim-gate, il cui
+ * done-event su stream 0 sta — in ordine di stream — DOPO il waitEvent e
+ * quindi prova transitivamente il completamento fisico degli upload (I3).
+ * Il registro dei trasporti non riceve batch non provati: sotto overlap il
+ * batch e' invalidato, versione minima dichiarata (I4).
+ *
+ * Forma: quarto parametro di template DOV su route worker / enforce /
+ * finish / submit / launch_impl, selezionato UNA VOLTA in
+ * cuda_g73_route_dispatch_init come G132 e SCOPED.  Ogni riga nuova sta in
+ * `if constexpr (DOV)`: nelle istanze false il codice non esiste nel
+ * percorso compilato.  Lo stato vive in QUESTO sidecar globale, mai dentro
+ * cuda_moe_expert_cache (lezione dei due tentativi morti: niente slittamenti
+ * di layout condiviso).  Scrittori: solo il thread worker (arm/retire) e i
+ * campi consumer_* solo il thread di decode; il consumer legge il resto con
+ * acquire.  Zero-inizializzato a memoria statica come g_workerprof_c.
+ * ======================================================================= */
+struct cuda_moe_drain_overlap4_state {
+    /* Un evento per parita' di generazione: il riuso della stessa parita'
+     * (N e N+2) e' serializzato dal claim-gate, quindi il record di N+2 non
+     * puo' precedere l'esecuzione del waitEvent di N. */
+    cudaEvent_t ready_event[2];
+    int events_created;
+    int transport_note_emitted;
+    /* Generazione armata (0 = niente in volo), pubblicata con release dopo
+     * i timestamp; complete_ns==0 con armed!=0 significa overlap ancora
+     * outstanding. */
+    std::atomic<uint64_t> armed_generation;
+    std::atomic<uint64_t> armed_ns;
+    std::atomic<uint64_t> complete_ns;
+    /* Solo thread di decode: finestra della sync del resolver usata per
+     * gpu_stall_on_drain_ms. */
+    uint64_t consumer_sync_started_ns;
+};
+static cuda_moe_drain_overlap4_state g_moe_drain_overlap4;
+
+static int cuda_moe_drain_overlap4_requested(void) {
+    static int cached = -1;
+    if (cached < 0) {
+        const char *env = getenv("DS4_CUDA_DRAIN_OVERLAP4");
+        cached = env && strcmp(env, "1") == 0;
+    }
+    return cached;
+}
+
+static int cuda_moe_drain_overlap4_events_ready(void) {
+    return g_moe_drain_overlap4.events_created &&
+        g_moe_drain_overlap4.ready_event[0] &&
+        g_moe_drain_overlap4.ready_event[1];
+}
+
+/* Creazione SOLO a flag acceso, dalla prepare (come drain2 righe 107-113,
+ * la parte giudicata giusta).  Fallimento = niente eventi = ogni arm
+ * ricade sul drain bloccante; la prepare non viene bocciata. */
+static cudaError_t cuda_moe_drain_overlap4_events_create(void) {
+    if (g_moe_drain_overlap4.events_created) return cudaSuccess;
+    for (uint32_t parity = 0; parity < 2u; parity++) {
+        const cudaError_t event_error = cudaEventCreateWithFlags(
+            &g_moe_drain_overlap4.ready_event[parity],
+            cudaEventDisableTiming);
+        if (event_error != cudaSuccess) {
+            for (uint32_t undo = 0; undo < parity; undo++) {
+                (void)cudaEventDestroy(
+                    g_moe_drain_overlap4.ready_event[undo]);
+                g_moe_drain_overlap4.ready_event[undo] = NULL;
+            }
+            g_moe_drain_overlap4.ready_event[parity] = NULL;
+            return event_error;
+        }
+    }
+    g_moe_drain_overlap4.events_created = 1;
+    return cudaSuccess;
+}
+
+static void cuda_moe_drain_overlap4_events_destroy(void) {
+    for (uint32_t parity = 0; parity < 2u; parity++) {
+        if (g_moe_drain_overlap4.ready_event[parity]) {
+            (void)cudaEventDestroy(
+                g_moe_drain_overlap4.ready_event[parity]);
+            g_moe_drain_overlap4.ready_event[parity] = NULL;
+        }
+    }
+    g_moe_drain_overlap4.events_created = 0;
+    g_moe_drain_overlap4.armed_generation.store(
+        0u, std::memory_order_release);
+    g_moe_drain_overlap4.armed_ns.store(0u, std::memory_order_relaxed);
+    g_moe_drain_overlap4.complete_ns.store(0u, std::memory_order_relaxed);
+    g_moe_drain_overlap4.consumer_sync_started_ns = 0u;
+}
+
+static int cuda_moe_drain_overlap4_outstanding(void) {
+    return g_moe_drain_overlap4.armed_generation.load(
+               std::memory_order_acquire) != 0u &&
+        g_moe_drain_overlap4.complete_ns.load(
+            std::memory_order_acquire) == 0u;
+}
+
+/* Chiusura della finestra di overlap (thread worker).  credit=1 quando il
+ * completamento e' provato (stream query Success o claim-gate): alimenta
+ * drain_overlap_ms = quota di drain avvenuta sotto il compute. */
+static void cuda_moe_drain_overlap4_retire(int wprof, int credit_overlap) {
+    const uint64_t now_ns = ds4_workerprof_now_ns();
+    const uint64_t armed_ns = g_moe_drain_overlap4.armed_ns.load(
+        std::memory_order_relaxed);
+    g_moe_drain_overlap4.complete_ns.store(
+        now_ns, std::memory_order_release);
+    if (wprof && credit_overlap) {
+        ds4_workerprof_add(WP_DRAIN_OVERLAP_NS,
+                           ds4_workerprof_span_ns(armed_ns, now_ns));
+    }
+}
+
+/* Loop idle del worker: UNA cudaStreamQuery per iterazione finche' l'upload
+ * armato non risulta completo (contratto drain_overlap_ms di
+ * .microbench/drain3/ANALISI.md §4).  Errore != NotReady: NON si inghiotte
+ * e NON si azzera (§3.4) — restera' visibile al prossimo confine CUDA
+ * (record del done-event del consumer o cudaEventQuery del claim); qui si
+ * chiude solo la finestra di telemetria per non riloggare. */
+static void cuda_moe_drain_overlap4_poll(
+        cuda_moe_expert_cache *cache, int wprof) {
+    if (!cache || !cache->route_upload_stream) return;
+    if (g_moe_drain_overlap4.armed_generation.load(
+            std::memory_order_relaxed) == 0u ||
+        g_moe_drain_overlap4.complete_ns.load(
+            std::memory_order_relaxed) != 0u) {
+        return;
+    }
+    const cudaError_t status = cudaStreamQuery(cache->route_upload_stream);
+    if (status == cudaErrorNotReady) return;
+    if (status != cudaSuccess) {
+        fprintf(stderr,
+                "ds4: [drain-overlap4] result=upload-stream-error cuda=%s "
+                "(errore lasciato pendente: sara' intercettato al prossimo "
+                "confine done-event/claim)\n",
+                cudaGetErrorString(status));
+    }
+    cuda_moe_drain_overlap4_retire(wprof, status == cudaSuccess);
+}
+
+/* Al claim della generazione N+1 il gate ha appena esatto
+ * cudaEventQuery(route_consumer_done_event) == cudaSuccess: il done-event
+ * sta, in ordine di stream 0, dopo il waitEvent dell'upload di N, quindi
+ * l'upload e' fisicamente completo (I3).  Ritiro senza query aggiuntive. */
+static void cuda_moe_drain_overlap4_retire_at_claim(int wprof) {
+    if (g_moe_drain_overlap4.armed_generation.load(
+            std::memory_order_relaxed) == 0u ||
+        g_moe_drain_overlap4.complete_ns.load(
+            std::memory_order_relaxed) != 0u) {
+        return;
+    }
+    cuda_moe_drain_overlap4_retire(wprof, 1);
+}
+
+/* Fence del consumer (§3.1): se la generazione armata coincide con quella
+ * sottomessa, i kernel consumer accodati DOPO questo punto su stream 0 non
+ * possono eseguire prima del completamento fisico delle copie (I1).
+ * Ritorna 0 solo su errore del waitEvent: il chiamante fa fail-closed
+ * (cancel_and_join + invalidate) come i percorsi watchdog esistenti. */
+static int cuda_moe_drain_overlap4_consumer_fence(
+        cuda_moe_expert_cache *cache, uint32_t sequence, const char *site) {
+    if (!cache) return 1;
+    const uint64_t armed_generation =
+        g_moe_drain_overlap4.armed_generation.load(
+            std::memory_order_acquire);
+    if (armed_generation == 0u ||
+        armed_generation != cache->route_submitted_generation.load(
+            std::memory_order_acquire)) {
+        return 1;
+    }
+    cudaEvent_t ready_event =
+        g_moe_drain_overlap4.ready_event[armed_generation & 1u];
+    const cudaError_t wait_error = ready_event
+        ? cudaStreamWaitEvent(0, ready_event, 0)
+        : cudaErrorInvalidResourceHandle;
+    if (wait_error == cudaSuccess) return 1;
+    fprintf(stderr,
+            "ds4: [drain-overlap4] result=wait-event-failed seq=%u "
+            "generation=%llu site=%s cuda=%s\n",
+            sequence, (unsigned long long)armed_generation,
+            site ? site : "unknown", cudaGetErrorString(wait_error));
+    return 0;
+}
+
+/* Telemetria gpu_stall_on_drain_ms (thread di decode, stesso punto della
+ * sync del resolver gia' cronometrata in route_resolve_sync_seconds).
+ * enter campiona l'overlap outstanding all'ingresso; exit attribuisce la
+ * porzione [inizio sync, completamento osservato dal worker] — se il worker
+ * non ha ancora stampato il completamento, l'intera sync e' il limite
+ * superiore onesto, dichiarato. */
+static void cuda_moe_drain_overlap4_consumer_sync_enter(void) {
+    g_moe_drain_overlap4.consumer_sync_started_ns = 0u;
+    if (!cuda_moe_drain_overlap4_outstanding()) return;
+    g_moe_drain_overlap4.consumer_sync_started_ns = ds4_workerprof_now_ns();
+}
+
+static void cuda_moe_drain_overlap4_consumer_sync_exit(void) {
+    const uint64_t started_ns = g_moe_drain_overlap4.consumer_sync_started_ns;
+    if (started_ns == 0u) return;
+    g_moe_drain_overlap4.consumer_sync_started_ns = 0u;
+    if (!cuda_worker_profile_enabled()) return;
+    const uint64_t now_ns = ds4_workerprof_now_ns();
+    const uint64_t complete_ns = g_moe_drain_overlap4.complete_ns.load(
+        std::memory_order_acquire);
+    uint64_t stall_end_ns = now_ns;
+    if (complete_ns >= started_ns && complete_ns < stall_end_ns) {
+        stall_end_ns = complete_ns;
+    }
+    ds4_workerprof_add(WP_GPU_STALL_ON_DRAIN_NS,
+                       ds4_workerprof_span_ns(started_ns, stall_end_ns));
+}
