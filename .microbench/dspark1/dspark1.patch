+/* MTP is a dense-attention block with its own raw SWA cache.  Logical layer
+ * 1 matches the existing GPU MTP path: no compression, base RoPE parameters,
+ * and learned routing (the MTP tensor has no token-id hash table). */
+static void mtp_cpu_layer_forward(
+        float *out_hc,
+        const ds4_model *model,
+        const ds4_layer_weights *layer,
+        ds4_layer_cache *cache,
+        const float *inp_hc,
+        uint32_t pos,
+        ds4_cpu_decode_scratch *scratch,
+        ds4_mtp_cpu_telemetry *telemetry) {
+    enum { DS4_MTP_DENSE_LOGICAL_LAYER = 1 };
+    float post[DS4_N_HC];
+    float comb[DS4_N_HC * DS4_N_HC];
+
+    if (cache->compress_ratio != 0 ||
+        cache->cap_raw == 0 ||
+        cache->cap_raw > DS4_N_SWA) {
+        ds4_die("MTP CPU cache must be raw SWA-only");
+    }
+    memcpy(
+        scratch->attn_residual,
+        inp_hc,
+        (size_t)DS4_N_HC * DS4_N_EMBD * sizeof(inp_hc[0]));
+    mtp_cpu_hc_pre_from_state_one_scratch(
+        model,
+        layer->hc_attn_fn,
+        layer->hc_attn_scale,
+        layer->hc_attn_base,
+        scratch->attn_residual,
+        scratch->attn_cur,
+        post,
+        comb,
+        scratch->hc_flat);
+    layer_attn_norm_one(
+        scratch->attn_norm, model, layer, scratch->attn_cur);
+    layer_q_projection_with_lora_one_decode_scratch(
+        model, layer,
+        scratch->attn_norm,
+        scratch->q,
+        scratch->qr_norm,
+        scratch);
+    layer_kv_projection_normed_one_decode_scratch(
+        model, layer,
+        scratch->attn_norm,
+        scratch->kv,
+        scratch);
+    rope_tail_layer_inplace(
+        scratch->q,
+        DS4_N_HEAD,
+        DS4_N_HEAD_DIM,
+        DS4_N_ROT,
+        pos,
+        DS4_MTP_DENSE_LOGICAL_LAYER,
+        false);
+    rope_tail_layer_inplace(
+        scratch->kv,
+        DS4_N_HEAD_KV,
+        DS4_N_HEAD_DIM,
+        DS4_N_ROT,
+        pos,
+        DS4_MTP_DENSE_LOGICAL_LAYER,
+        false);
+    dsv4_fp8_kv_quantize_row_inplace_cpu(
+        scratch->kv, DS4_N_HEAD_DIM, DS4_N_ROT);
+    kv_cache_push_raw(cache, scratch->kv);
+    layer_attention_rows_one(
+        scratch->heads,
+        model,
+        layer,
+        scratch->q,
+        cache->raw_kv,
+        cache->n_raw);
+    rope_tail_layer_inplace(
+        scratch->heads,
+        DS4_N_HEAD,
+        DS4_N_HEAD_DIM,
+        DS4_N_ROT,
+        pos,
+        DS4_MTP_DENSE_LOGICAL_LAYER,
+        true);
+    layer_grouped_out_one_decode_scratch(
+        scratch->attn_out, model, layer, scratch->heads, scratch);
+    hc_post_one(
+        scratch->after_attn_hc,
+        scratch->attn_out,
+        scratch->attn_residual,
+        post,
+        comb,
+        DS4_N_EMBD,
+        DS4_N_HC);
+    mtp_cpu_layer_ffn_one(
+        out_hc,
+        model,
+        layer,
+        scratch->after_attn_hc,
+        scratch,
+        telemetry);
+}
