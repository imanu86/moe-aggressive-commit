+/* Decode the packed 6-bit Q4_K scale/min pair for one 32-value group.  This
+ * is the same layout used by tools/mtp_q4k_requant.c's golden dequantizer. */
+static inline void ds4_q4_k_scale_min(
+        int j, const uint8_t scales[12], uint8_t *scale, uint8_t *minv) {
+    if (j < 4) {
+        *scale = scales[j] & 63u;
+        *minv = scales[j + 4] & 63u;
+    } else {
+        *scale = (uint8_t)((scales[j + 4] & 0x0fu) |
+                           ((scales[j - 4] >> 6) << 4));
+        *minv = (uint8_t)((scales[j + 4] >> 4) |
+                          ((scales[j] >> 6) << 4));
+    }
+}
+
+/* Q4_K routed-expert row dot Q8_K activation.  Q4 dequantization is fused
+ * into the dot: each packed nibble is multiplied by its 6-bit group scale,
+ * while Q8_K bsums apply the Q4_K per-group minimum without materializing a
+ * float row. */
+static void ds4_vec_dot_q4_K_q8_K(
+        int n,
+        float *s,
+        const block_q4_K *x,
+        const block_q8_K *y) {
+    if (n % QK_K != 0) ds4_die("Q4_K dot length is not QK_K aligned");
+
+    const int nb = n / QK_K;
+    float sumf = 0.0f;
+    for (int ib = 0; ib < nb; ib++) {
+        const float d = f16_to_f32(x[ib].d);
+        const float dmin = f16_to_f32(x[ib].dmin);
+        const float yd = y[ib].d;
+        const uint8_t *q = x[ib].qs;
+        const int8_t *q8 = y[ib].qs;
+        int is = 0;
+
+        for (int off = 0; off < QK_K; off += 64) {
+            uint8_t sc0, min0, sc1, min1;
+            ds4_q4_k_scale_min(is + 0, x[ib].scales, &sc0, &min0);
+            ds4_q4_k_scale_min(is + 1, x[ib].scales, &sc1, &min1);
+
+            int32_t dot0 = 0;
+            int32_t dot1 = 0;
+            for (int j = 0; j < 32; j++) {
+                dot0 += (int32_t)(q[j] & 0x0fu) * (int32_t)q8[j];
+                dot1 += (int32_t)(q[j] >> 4) * (int32_t)q8[32 + j];
+            }
+            const int bsum = off / 16;
+            const int32_t sum0 =
+                (int32_t)y[ib].bsums[bsum + 0] +
+                (int32_t)y[ib].bsums[bsum + 1];
+            const int32_t sum1 =
+                (int32_t)y[ib].bsums[bsum + 2] +
+                (int32_t)y[ib].bsums[bsum + 3];
+
+            sumf += yd * (
+                d * ((float)sc0 * (float)dot0 +
+                     (float)sc1 * (float)dot1) -
+                dmin * ((float)min0 * (float)sum0 +
+                        (float)min1 * (float)sum1));
+            q += 32;
+            q8 += 64;
+            is += 2;
+        }
+    }
+    *s = sumf;
+}
