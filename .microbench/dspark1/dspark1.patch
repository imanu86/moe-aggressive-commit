+static DS4_MAYBE_UNUSED void ds4_mtp_cpu_state_init(
+        ds4_mtp_cpu_state *state) {
+    if (!state) ds4_die("MTP CPU state is null");
+    memset(state, 0, sizeof(*state));
+    cpu_decode_scratch_init(&state->scratch, DS4_N_SWA);
+    state->cache.cap_raw = DS4_N_SWA;
+    state->cache.raw_kv = xmalloc_zeroed(
+        (size_t)DS4_N_SWA * DS4_N_HEAD_DIM, sizeof(float));
+    state->cache.compress_ratio = 0;
+    state->initialized = true;
+}
+
+static DS4_MAYBE_UNUSED void ds4_mtp_cpu_state_reset(
+        ds4_mtp_cpu_state *state) {
+    if (!state || !state->initialized) return;
+    state->cache.n_raw = 0;
+}
+
+static DS4_MAYBE_UNUSED void ds4_mtp_cpu_state_free(
+        ds4_mtp_cpu_state *state) {
+    if (!state) return;
+    free(state->cache.raw_kv);
+    cpu_decode_scratch_free(&state->scratch);
+    memset(state, 0, sizeof(*state));
+}
+
+/* One callable NextN draft forward.
+ *
+ * prev_hc is exactly 4x4096 F32 HC state: target final HC for the first draft,
+ * then the previous MTP out_hc for recursive drafts.  token is the known true
+ * token for the first call (and the previous draft token thereafter).
+ * out_hc is the recurrent 4x4096 state.  head_hidden is the 4096-vector after
+ * the MTP HC head and mtp.0.norm; it is ready for the base model's resident
+ * Q8_0 vocabulary matrix on GPU.  No vocabulary projection is done here. */
+static DS4_MAYBE_UNUSED void ds4_mtp_cpu_forward_nextn_q4_k(
+        ds4_mtp_cpu_state *state,
+        const ds4_model *base_model,
+        const ds4_weights *base_weights,
+        const ds4_model *mtp_model,
+        const ds4_mtp_weights *mtp,
+        const float *prev_hc,
+        int token,
+        uint32_t pos,
+        float *out_hc,
+        float *head_hidden,
+        ds4_mtp_cpu_telemetry *telemetry) {
+    if (!state || !state->initialized ||
+        !base_model || !base_weights ||
+        !mtp_model || !mtp ||
+        !prev_hc || !out_hc || !head_hidden) {
+        ds4_die("invalid MTP CPU forward argument");
+    }
+
+    ds4_mtp_cpu_telemetry local = {0};
+    ds4_mtp_cpu_telemetry *tm = telemetry ? telemetry : &local;
+    memset(tm, 0, sizeof(*tm));
+    const double total_t0 = now_sec();
+    ds4_cpu_decode_scratch *scratch = &state->scratch;
+
+    embed_token_f16(base_model, base_weights, token, scratch->plain);
+    rms_norm_weight(
+        scratch->output_embd,
+        scratch->plain,
+        tensor_data(mtp_model, mtp->enorm),
+        DS4_N_EMBD,
+        DS4_RMS_EPS);
+    matvec_q8_0_decode_scratch(
+        scratch->output_norm,
+        mtp_model,
+        mtp->e_proj,
+        scratch->output_embd,
+        scratch);
+
+    for (uint32_t h = 0; h < DS4_N_HC; h++) {
+        const float *prev = prev_hc + (uint64_t)h * DS4_N_EMBD;
+        float *hnorm = scratch->cur + (uint64_t)h * DS4_N_EMBD;
+        float *input = scratch->next + (uint64_t)h * DS4_N_EMBD;
+        rms_norm_weight(
+            hnorm,
+            prev,
+            tensor_data(mtp_model, mtp->hnorm),
+            DS4_N_EMBD,
+            DS4_RMS_EPS);
+        matvec_q8_0_decode_scratch(
+            input, mtp_model, mtp->h_proj, hnorm, scratch);
+        for (uint32_t d = 0; d < DS4_N_EMBD; d++) {
+            input[d] += scratch->output_norm[d];
+        }
+    }
+
+    mtp_cpu_layer_forward(
+        scratch->cur,
+        mtp_model,
+        &mtp->block,
+        &state->cache,
+        scratch->next,
+        pos,
+        scratch,
+        tm);
+    memcpy(
+        out_hc,
+        scratch->cur,
+        (size_t)DS4_N_HC * DS4_N_EMBD * sizeof(out_hc[0]));
+
+    const uint64_t hc_dim = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+    rms_norm_no_weight(
+        scratch->output_flat, scratch->cur, hc_dim, DS4_RMS_EPS);
+    matvec_any(
+        scratch->output_pre,
+        mtp_model,
+        mtp->hc_head_fn,
+        scratch->output_flat);
+    const float *head_scale =
+        tensor_data(mtp_model, mtp->hc_head_scale);
+    const float *head_base =
+        tensor_data(mtp_model, mtp->hc_head_base);
+    for (uint32_t h = 0; h < DS4_N_HC; h++) {
+        scratch->output_weights[h] = sigmoid_stable(
+            scratch->output_pre[h] * head_scale[0] + head_base[h]) +
+            DS4_HC_EPS;
+    }
+    hc_weighted_sum_one(
+        scratch->output_embd,
+        scratch->cur,
+        scratch->output_weights,
+        DS4_N_EMBD,
+        DS4_N_HC);
+    rms_norm_weight(
+        head_hidden,
+        scratch->output_embd,
+        tensor_data(mtp_model, mtp->norm),
+        DS4_N_EMBD,
+        DS4_RMS_EPS);
+
+    tm->total_ms = (now_sec() - total_t0) * 1000.0;
+    /* Q4_K dequantization is fused into ds4_vec_dot_q4_K_q8_K, so there is
+     * intentionally no separately materialized dequant pass. */
+    tm->q4_dequant_ms = 0.0;
+    tm->other_ms =
+        tm->total_ms -
+        tm->q8_prequant_ms -
+        tm->q4_dequant_ms -
+        tm->q4_matvec_ms;
+    if (tm->other_ms < 0.0) tm->other_ms = 0.0;
+}
