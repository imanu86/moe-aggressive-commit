+    for (uint32_t i = 0; i < DS4_N_EMBD; i++) {
+        scratch->ffn_out[i] =
+            scratch->ffn_moe[i] + scratch->ffn_shared[i];
+    }
+    hc_post_one(
+        out_hc,
+        scratch->ffn_out,
+        inp_hc,
+        post,
+        comb,
+        DS4_N_EMBD,
+        DS4_N_HC);
+}
