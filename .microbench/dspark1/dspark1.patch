+/* CPU-only state for the one-block NextN drafter.  It is deliberately
+ * detached from ds4_engine and has no call site in this patch: loader,
+ * dispatcher, speculative state, cache residency, and admission stay
+ * unchanged until the later DSPARK pieces wire it behind an explicit flag. */
+typedef struct {
+    ds4_cpu_decode_scratch scratch;
+    ds4_layer_cache cache;
+    bool initialized;
+} ds4_mtp_cpu_state;
+
+static void mtp_cpu_hc_pre_from_state_one_scratch(
+        const ds4_model *model,
+        const ds4_tensor *fn,
+        const ds4_tensor *scale_tensor,
+        const ds4_tensor *base_tensor,
+        const float *residual_hc,
+        float *out,
+        float *post,
+        float *comb,
+        float *flat) {
+    const uint64_t hc_dim = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+    float mix[2 * DS4_N_HC + DS4_N_HC * DS4_N_HC];
+    float split[2 * DS4_N_HC + DS4_N_HC * DS4_N_HC];
+
+    rms_norm_no_weight(flat, residual_hc, hc_dim, DS4_RMS_EPS);
+    matvec_any(mix, model, fn, flat);
+    hc_split_sinkhorn_one(
+        split,
+        mix,
+        tensor_data(model, scale_tensor),
+        tensor_data(model, base_tensor),
+        DS4_N_HC,
+        DS4_N_HC_SINKHORN_ITER,
+        DS4_HC_EPS);
+    hc_weighted_sum_one(
+        out, residual_hc, split, DS4_N_EMBD, DS4_N_HC);
+    memcpy(
+        post, split + DS4_N_HC,
+        (size_t)DS4_N_HC * sizeof(post[0]));
+    memcpy(
+        comb, split + 2 * DS4_N_HC,
+        (size_t)DS4_N_HC * DS4_N_HC * sizeof(comb[0]));
+}
+
+static void mtp_cpu_layer_ffn_one(
+        float *out_hc,
+        const ds4_model *model,
+        const ds4_layer_weights *layer,
+        const float *inp_hc,
+        ds4_cpu_decode_scratch *scratch,
+        ds4_mtp_cpu_telemetry *telemetry) {
+    float post[DS4_N_HC];
+    float comb[DS4_N_HC * DS4_N_HC];
+    mtp_cpu_hc_pre_from_state_one_scratch(
+        model,
+        layer->hc_ffn_fn,
+        layer->hc_ffn_scale,
+        layer->hc_ffn_base,
+        inp_hc,
+        scratch->ffn_cur,
+        post,
+        comb,
+        scratch->hc_flat);
+    rms_norm_weight(
+        scratch->ffn_norm,
+        scratch->ffn_cur,
+        tensor_data(model, layer->ffn_norm),
+        DS4_N_EMBD,
+        DS4_RMS_EPS);
+
+    layer_routed_moe_q4_k_one_prealloc(
+        scratch->ffn_moe,
+        model,
+        layer,
+        scratch->ffn_norm,
+        DS4_SWIGLU_CLAMP_EXP,
+        scratch->routed_mid_all,
+        scratch->routed_xq,
+        scratch->routed_midq,
