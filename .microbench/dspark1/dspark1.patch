+typedef struct {
+    float *out0;
+    float *out1;
+    const uint8_t *base0;
+    const uint8_t *base1;
+    const block_q8_K *xq;
+    uint64_t in_dim;
+    uint64_t row_bytes0;
+    uint64_t row_bytes1;
+} matvec_q4_k_pair_ctx;
+
+static void matvec_q4_k_pair_worker(void *vctx, uint64_t row0, uint64_t row1) {
+    matvec_q4_k_pair_ctx *ctx = vctx;
+    for (uint64_t row = row0; row < row1; row++) {
+        const block_q4_K *w0 =
+            (const block_q4_K *)(ctx->base0 + row * ctx->row_bytes0);
+        const block_q4_K *w1 =
+            (const block_q4_K *)(ctx->base1 + row * ctx->row_bytes1);
+        ds4_vec_dot_q4_K_q8_K(
+            (int)ctx->in_dim, &ctx->out0[row], w0, ctx->xq);
+        ds4_vec_dot_q4_K_q8_K(
+            (int)ctx->in_dim, &ctx->out1[row], w1, ctx->xq);
+    }
+}
+
+/* Single-expert gate/up entry point, matching the existing IQ2 pair kernel:
+ * one Q8_K activation prequant is shared and output rows are pool-parallel. */
+static DS4_MAYBE_UNUSED void matvec_q4_k_expert_pair_prequant(
+        float *out0,
+        float *out1,
+        const ds4_model *model,
+        const ds4_tensor *w0,
+        const ds4_tensor *w1,
+        const block_q8_K *xq,
+        uint32_t expert) {
+    if (w0->type != DS4_TENSOR_Q4_K ||
+        w1->type != DS4_TENSOR_Q4_K) {
+        ds4_die("expected paired Q4_K expert tensors");
+    }
+
+    uint64_t in0, out0_dim, row0;
+    uint64_t in1, out1_dim, row1;
+    const uint8_t *base0 =
+        tensor_expert_bytes(model, w0, expert, &in0, &out0_dim, &row0);
+    const uint8_t *base1 =
+        tensor_expert_bytes(model, w1, expert, &in1, &out1_dim, &row1);
+    if (in0 != in1 || out0_dim != out1_dim || in0 % QK_K != 0) {
+        ds4_die("paired Q4_K expert tensors do not share a QK_K layout");
+    }
+
+    matvec_q4_k_pair_ctx ctx = {
+        .out0 = out0,
+        .out1 = out1,
+        .base0 = base0,
+        .base1 = base1,
+        .xq = xq,
+        .in_dim = in0,
+        .row_bytes0 = row0,
+        .row_bytes1 = row1,
+    };
+    ds4_parallel_for(out0_dim, matvec_q4_k_pair_worker, &ctx);
+}
+
+typedef struct {
+    float *mid;
+    const uint8_t *gate_base[DS4_N_EXPERT_USED];
+    const uint8_t *up_base[DS4_N_EXPERT_USED];
+    const block_q8_K *xq;
+    float expert_weight[DS4_N_EXPERT_USED];
+    float clamp;
+    uint64_t in_dim;
+    uint64_t out_dim;
+    uint64_t gate_row_bytes[DS4_N_EXPERT_USED];
+    uint64_t up_row_bytes[DS4_N_EXPERT_USED];
+    int n_expert;
+} matvec_q4_k_mid_ctx;
+
+static void matvec_q4_k_mid_worker(void *vctx, uint64_t row0, uint64_t row1) {
+    matvec_q4_k_mid_ctx *ctx = vctx;
+    for (uint64_t idx = row0; idx < row1; idx++) {
+        const int slot = (int)(idx / ctx->out_dim);
+        const uint64_t row = idx - (uint64_t)slot * ctx->out_dim;
+        const block_q4_K *gate_row = (const block_q4_K *)(
+            ctx->gate_base[slot] + row * ctx->gate_row_bytes[slot]);
+        const block_q4_K *up_row = (const block_q4_K *)(
+            ctx->up_base[slot] + row * ctx->up_row_bytes[slot]);
+        float gate = 0.0f;
+        float up = 0.0f;
+        ds4_vec_dot_q4_K_q8_K(
+            (int)ctx->in_dim, &gate, gate_row, ctx->xq);
+        ds4_vec_dot_q4_K_q8_K(
+            (int)ctx->in_dim, &up, up_row, ctx->xq);
+        if (ctx->clamp > 1.0e-6f) {
+            if (gate > ctx->clamp) gate = ctx->clamp;
+            if (up > ctx->clamp) up = ctx->clamp;
+            if (up < -ctx->clamp) up = -ctx->clamp;
+        }
+        ctx->mid[idx] =
+            silu(gate) * up * ctx->expert_weight[slot];
+    }
+}
+
+static void matvec_q4_k_experts_mid_prequant(
+        float *mid,
+        const ds4_model *model,
+        const ds4_tensor *gate_w,
+        const ds4_tensor *up_w,
+        const block_q8_K *xq,
+        const int *selected,
+        const float *expert_weight,
+        int n_expert,
+        float clamp) {
+    if (gate_w->type != DS4_TENSOR_Q4_K ||
+        up_w->type != DS4_TENSOR_Q4_K) {
+        ds4_die("expected Q4_K routed gate/up tensors");
+    }
+    if (n_expert < 1 || n_expert > DS4_N_EXPERT_USED) {
+        ds4_die("unexpected Q4_K routed expert count");
+    }
+
+    matvec_q4_k_mid_ctx ctx = {
+        .mid = mid,
+        .xq = xq,
+        .clamp = clamp,
+        .n_expert = n_expert,
+    };
+    for (int i = 0; i < n_expert; i++) {
+        uint64_t gate_in, gate_out, up_in, up_out;
+        ctx.gate_base[i] = tensor_expert_bytes(
+            model, gate_w, (uint32_t)selected[i],
+            &gate_in, &gate_out, &ctx.gate_row_bytes[i]);
+        ctx.up_base[i] = tensor_expert_bytes(
+            model, up_w, (uint32_t)selected[i],
+            &up_in, &up_out, &ctx.up_row_bytes[i]);
+        if (gate_in != up_in || gate_out != up_out) {
+            ds4_die("paired Q4_K routed tensors do not match");
+        }
+        if (i == 0) {
+            ctx.in_dim = gate_in;
+            ctx.out_dim = gate_out;
+        } else if (gate_in != ctx.in_dim || gate_out != ctx.out_dim) {
+            ds4_die("Q4_K routed tensors do not share a layout");
+        }
+        ctx.expert_weight[i] = expert_weight[i];
+    }
+    if (ctx.in_dim % QK_K != 0) {
+        ds4_die("Q4_K routed gate/up row is not QK_K aligned");
+    }
+    ds4_parallel_for(
+        (uint64_t)n_expert * ctx.out_dim,
+        matvec_q4_k_mid_worker,
+        &ctx);
+}
+
+typedef struct {
+    float *out;
+    const uint8_t *base[DS4_N_EXPERT_USED];
+    const block_q8_K *xq[DS4_N_EXPERT_USED];
+    uint64_t in_dim;
+    uint64_t row_bytes[DS4_N_EXPERT_USED];
+    int n_expert;
+} matvec_q4_k_accum_ctx;
+
+static void matvec_q4_k_accum_worker(
+        void *vctx, uint64_t row0, uint64_t row1) {
+    matvec_q4_k_accum_ctx *ctx = vctx;
+    for (uint64_t row = row0; row < row1; row++) {
+        float acc = 0.0f;
+        for (int i = 0; i < ctx->n_expert; i++) {
+            const block_q4_K *w = (const block_q4_K *)(
+                ctx->base[i] + row * ctx->row_bytes[i]);
+            float v = 0.0f;
+            ds4_vec_dot_q4_K_q8_K(
+                (int)ctx->in_dim, &v, w, ctx->xq[i]);
+            acc += v;
+        }
+        ctx->out[row] = acc;
+    }
+}
+
+static void matvec_q4_k_experts_accum_prequant(
+        float *out,
+        const ds4_model *model,
+        const ds4_tensor *w,
+        const block_q8_K *xq,
+        const int *selected,
+        int n_expert) {
+    if (w->type != DS4_TENSOR_Q4_K) {
+        ds4_die("expected a Q4_K routed down tensor");
+    }
+    if (n_expert < 1 || n_expert > DS4_N_EXPERT_USED) {
+        ds4_die("unexpected Q4_K routed expert count");
+    }
+
+    matvec_q4_k_accum_ctx ctx = {
+        .out = out,
+        .n_expert = n_expert,
+    };
+    uint64_t out_dim = 0;
+    for (int i = 0; i < n_expert; i++) {
+        uint64_t in_dim_i, out_dim_i;
+        ctx.base[i] = tensor_expert_bytes(
+            model, w, (uint32_t)selected[i],
+            &in_dim_i, &out_dim_i, &ctx.row_bytes[i]);
+        if (i == 0) {
+            ctx.in_dim = in_dim_i;
+            out_dim = out_dim_i;
+        } else if (in_dim_i != ctx.in_dim || out_dim_i != out_dim) {
+            ds4_die("Q4_K routed down tensors do not share a layout");
+        }
+    }
+    if (ctx.in_dim % QK_K != 0) {
+        ds4_die("Q4_K routed down row is not QK_K aligned");
+    }
+    const uint64_t n_blocks = ctx.in_dim / QK_K;
+    for (int i = 0; i < n_expert; i++) {
+        ctx.xq[i] = xq + (uint64_t)i * n_blocks;
+    }
+    ds4_parallel_for(out_dim, matvec_q4_k_accum_worker, &ctx);
+}
+
+/* The MTP router is learned even though the GPU path uses logical layer 1 to
+ * select dense RoPE semantics.  Keep it independent of backbone hash routing
+ * and REAP masks, and accept either F16 or F32 plain GGUF router weights. */
+static void mtp_cpu_router_select(
+        int selected[DS4_N_EXPERT_USED],
+        float expert_weight[DS4_N_EXPERT_USED],
+        const ds4_model *model,
+        const ds4_layer_weights *layer,
+        const float *x) {
+    float logits[DS4_N_EXPERT];
+    float probs[DS4_N_EXPERT];
+    float selection[DS4_N_EXPERT];
+    matvec_any(logits, model, layer->ffn_gate_inp, x);
+    for (int i = 0; i < DS4_N_EXPERT; i++) {
+        probs[i] = sqrtf(softplus_stable(logits[i]));
+        selection[i] = probs[i];
+    }
+    if (layer->ffn_exp_probs_b) {
+        const float *bias = tensor_data(model, layer->ffn_exp_probs_b);
+        for (int i = 0; i < DS4_N_EXPERT; i++) {
+            selection[i] += bias[i];
+        }
+    }
+    topk_desc(selection, DS4_N_EXPERT, DS4_N_EXPERT_USED, selected);
+
+    float sum = 0.0f;
+    for (int i = 0; i < DS4_N_EXPERT_USED; i++) {
+        expert_weight[i] = probs[selected[i]];
+        sum += expert_weight[i];
+    }
+    if (sum < 6.103515625e-5f) sum = 6.103515625e-5f;
+    for (int i = 0; i < DS4_N_EXPERT_USED; i++) {
+        expert_weight[i] =
+            expert_weight[i] / sum * DS4_EXPERT_WEIGHT_SCALE;
+    }
+}
+
+static void layer_routed_moe_q4_k_one_prealloc(
+        float *out,
+        const ds4_model *model,
+        const ds4_layer_weights *layer,
+        const float *x,
+        float clamp,
+        float *mid_all,
+        block_q8_K *xq,
+        block_q8_K *midq,
+        ds4_mtp_cpu_telemetry *telemetry) {
+    if (layer->ffn_gate_exps->type != DS4_TENSOR_Q4_K ||
+        layer->ffn_up_exps->type != DS4_TENSOR_Q4_K ||
+        layer->ffn_down_exps->type != DS4_TENSOR_Q4_K) {
+        ds4_die("MTP CPU routed path requires Q4_K gate/up/down tensors");
+    }
+    const uint64_t in_dim = layer->ffn_gate_exps->dim[0];
+    const uint64_t mid_dim = layer->ffn_gate_exps->dim[1];
+    const uint64_t down_in = layer->ffn_down_exps->dim[0];
+    /* mid_all/xq/midq scratch buffers are sized on DS4_N_FF_EXP, so this
+     * guard must stay in sync with layer_routed_moe_one_prealloc's checks. */
+    if (in_dim % QK_K != 0 ||
+        mid_dim != down_in ||
+        down_in != DS4_N_FF_EXP ||
+        down_in % QK_K != 0 ||
+        layer->ffn_down_exps->dim[1] != DS4_N_EMBD) {
+        ds4_die("MTP Q4_K routed tensor layout is unexpected");
+    }
+
+    int selected[DS4_N_EXPERT_USED];
+    float expert_weight[DS4_N_EXPERT_USED];
+    mtp_cpu_router_select(selected, expert_weight, model, layer, x);
+
+    double t0 = telemetry ? now_sec() : 0.0;
+    ds4_quantize_row_q8_K(x, xq, (int64_t)in_dim);
+    if (telemetry) {
+        telemetry->q8_prequant_ms += (now_sec() - t0) * 1000.0;
+        t0 = now_sec();
+    }
+    matvec_q4_k_experts_mid_prequant(
+        mid_all, model,
+        layer->ffn_gate_exps,
+        layer->ffn_up_exps,
+        xq, selected, expert_weight,
+        DS4_N_EXPERT_USED, clamp);
+    if (telemetry) {
+        telemetry->q4_matvec_ms += (now_sec() - t0) * 1000.0;
+        t0 = now_sec();
+    }
+
+    for (int i = 0; i < DS4_N_EXPERT_USED; i++) {
+        ds4_quantize_row_q8_K(
+            mid_all + (uint64_t)i * down_in,
+            midq + (uint64_t)i * (down_in / QK_K),
+            (int64_t)down_in);
+    }
+    if (telemetry) {
+        telemetry->q8_prequant_ms += (now_sec() - t0) * 1000.0;
+        t0 = now_sec();
+    }
+    matvec_q4_k_experts_accum_prequant(
+        out, model, layer->ffn_down_exps,
+        midq, selected, DS4_N_EXPERT_USED);
+    if (telemetry) {
+        telemetry->q4_matvec_ms += (now_sec() - t0) * 1000.0;
+    }
+}
