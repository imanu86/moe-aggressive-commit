+/* =========================================================================
+ * DSPARK-2 (pieces 3-5): asynchronous NextN CPU draft cycle.
+ * =========================================================================
+ *
+ * One drafter thread per session runs the pieces 1-2 forward as a k-step
+ * autoregressive chain.  The pipeline hides the chain under the target's own
+ * work: at the end of a speculative cycle the next true token is already
+ * determined (the verify path only engages at temperature<=0, where
+ * ds4_session_sample is sample_argmax), so the chain for the NEXT cycle is
+ * kicked immediately with (backbone HC of the committed frontier, predicted
+ * next token) and runs while the server streams text and the GPU decodes
+ * that token.  The next cycle then takes whatever drafts are ready - never
+ * waiting - and feeds them to the existing k<=16 batch verifier unchanged.
+ *
+ * Chain conditioning matches the existing GPU recursion contract
+ * (metal_graph_eval_mtp_draft_from_hc): each step consumes the token at
+ * position p with the previous step's HC state and RoPE position p, and
+ * emits the draft for p+1.  The first step anchors on the backbone HC of the
+ * last committed position - the "token corrente + hidden dell'ultimo
+ * forward" pairing of DSPARK.md sez. 3 - which is one position staler than
+ * the GPU probe's same-position anchor; the acceptance telemetry below is
+ * what measures the difference.
+ *
+ * The CPU MTP KV window (sliding, kv_cache_push_raw) must stay contiguous:
+ * a draft is deliverable only once the KV row of its own commit position has
+ * been written by the following step (row-holdback), and the chain runs one
+ * extra row-fill step past k, so a fully accepted prefix never leaves a hole
+ * in the window.  An EOS draft is terminal for the request and is exempt.
+ * Rows past the committed prefix are dropped by the worker itself at the
+ * next job intake (n_raw decrement); discontinuities (rewind, invalidate,
+ * missed prediction, prefill jumps) force a window reset.
+ */
+
+enum {
+    DS4_NEXTN_DRAFT_MAX = 16,       /* batch verifier contract: drafts[16] */
+    DS4_NEXTN_DRAFT_K_DEFAULT = 7,
+};
+
+enum {
+    DS4_NEXTN_ANCHOR_NONE = 0,      /* telemetry only, no next kick */
+    DS4_NEXTN_ANCHOR_CUR_HC = 1,    /* g->cur_hc after a one-token decode */
+    DS4_NEXTN_ANCHOR_BATCH_ROW = 2, /* g->batch_cur_hc row after batch verify */
+};
+
+typedef struct ds4_nextn_drafter {
+    /* Immutable after create. */
+    const ds4_model *base_model;
+    const ds4_weights *base_weights;
+    const ds4_model *mtp_model;
+    const ds4_mtp_weights *mtp;
+    int k;                          /* drafts requested per cycle */
+
+    /* Mailbox and published results: mu-protected. */
+    os_mutex_t mu;
+    os_cond_t cv;
+    bool mu_ready;
+    bool cv_ready;
+    bool shutdown;
+    uint64_t job_seq;               /* bumped by every kick */
+    bool job_consumed;              /* rendezvous happened for job_seq */
+    int job_first_token;            /* predicted next true token */
+    uint32_t job_first_pos;         /* position it will be committed at */
+    uint32_t job_q_valid;           /* last committed position */
+    int job_eos_token;
+    bool job_reset_kv;
+    float *job_anchor_hc;           /* [DS4_N_HC * DS4_N_EMBD] */
+
+    int pub_drafts[DS4_NEXTN_DRAFT_MAX];
+    float pub_margin[DS4_NEXTN_DRAFT_MAX];
+    int pub_runner[DS4_NEXTN_DRAFT_MAX];
+    int pub_count;                  /* deliverable drafts, row-holdback applied */
+    int pub_steps;                  /* NextN forwards completed for pub_seq */
+    double pub_ms;                  /* chain wall time so far */
+    uint64_t pub_seq;
+
+    /* Worker-thread-owned; other threads never touch these. */
+    os_thread_t thread;
+    bool thread_ready;
+    ds4_mtp_cpu_state cpu;
+    uint32_t kv_last_pos;           /* position of the newest CPU KV row */
+    bool kv_any;                    /* any row pushed since the last reset */
+    float *hc_a;                    /* [DS4_N_HC * DS4_N_EMBD] chain ping */
+    float *hc_b;                    /* [DS4_N_HC * DS4_N_EMBD] chain pong */
+    float *head_hidden;             /* [DS4_N_EMBD] */
+    float *head_logits;             /* [DS4_N_VOCAB] */
+    int8_t *head_xq;                /* [DS4_N_EMBD] Q8_0 activation */
+    float *head_xscale;             /* [DS4_N_EMBD / 32] */
+
+    /* Decode-thread-owned cycle and request telemetry. */
+    bool needs_reset;
+    int cycle_gen;
+    double cycle_ms;
+    bool cycle_stale;
+    uint64_t req_cycles;
+    uint64_t req_generated;
+    uint64_t req_delivered;
+    uint64_t req_accepted;
+    double req_draft_ms;
+    uint64_t req_offered_pos[DS4_NEXTN_DRAFT_MAX];
+    uint64_t req_accepted_pos[DS4_NEXTN_DRAFT_MAX];
+} ds4_nextn_drafter;
+
+/* Base-model Q8_0 vocabulary head for one draft, on the lane pool.  This is
+ * the exact tail of metal_graph_encode_output_head_mtp: head_hidden is
+ * already through the MTP HC head and mtp.0.norm, so the logits are one
+ * plain Q8_0 matvec against the shared output matrix with no further
+ * normalization; top-2 gives both the greedy draft and the margin. */
+static DS4_MAYBE_UNUSED void ds4_nextn_head_top2(
+        ds4_nextn_drafter *d,
+        int *top0, float *v0,
+        int *top1, float *v1) {
+    const ds4_tensor *w = d->base_weights->output;
+    const uint64_t in_dim = w->dim[0];
+    const uint64_t out_dim = w->dim[1];
+    quantize_q8_0_activation(d->head_hidden, d->head_xq, d->head_xscale, in_dim);
+    matvec_q8_0_ctx ctx = {
+        .out = d->head_logits,
+        .data = tensor_data(d->base_model, w),
+        .xq = d->head_xq,
+        .xscale = d->head_xscale,
+        .in_dim = in_dim,
+        .row0 = 0,
+        .blocks = (in_dim + 31) / 32,
+    };
+    ds4_nextn_parallel_for(out_dim, matvec_q8_0_worker, &ctx);
+    int b0 = -1, b1 = -1;
+    float x0 = DS4_NEG_INF, x1 = DS4_NEG_INF;
+    for (uint64_t i = 0; i < out_dim; i++) {
+        const float v = d->head_logits[i];
+        if (v > x0) {
+            x1 = x0;
+            b1 = b0;
+            x0 = v;
+            b0 = (int)i;
+        } else if (v > x1) {
+            x1 = v;
+            b1 = (int)i;
+        }
+    }
+    *top0 = b0;
+    *v0 = x0;
+    *top1 = b1;
+    *v1 = x1;
+}
+
+static DS4_MAYBE_UNUSED void *ds4_nextn_worker_main(void *arg) {
+    ds4_nextn_drafter *d = arg;
+    /* Existing helpers reused by the pieces 1-2 forward must not submit to
+     * the process-global pool from this thread: pinning the thread-local
+     * parallel depth makes every nested ds4_parallel_for run inline, while
+     * the routed Q4_K kernels and the head go through the G132 lane pool via
+     * ds4_nextn_parallel_for. */
+    g_parallel_depth = 1;
+    g_nextn_drafter_thread = true;
+
+    uint64_t seen_seq = 0;
+    for (;;) {
+        os_mutex_lock(&d->mu);
+        while (!d->shutdown &&
+               (d->job_seq == seen_seq || d->job_consumed)) {
+            os_cond_wait(&d->cv, &d->mu);
+        }
+        if (d->shutdown) {
+            os_mutex_unlock(&d->mu);
+            return NULL;
+        }
+        const uint64_t seq = d->job_seq;
+        const int first_token = d->job_first_token;
+        const uint32_t first_pos = d->job_first_pos;
+        const uint32_t q_valid = d->job_q_valid;
+        const int eos_token = d->job_eos_token;
+        const bool reset_kv = d->job_reset_kv;
+        const int k = d->k;
+        memcpy(d->hc_a, d->job_anchor_hc,
+               (size_t)DS4_N_HC * DS4_N_EMBD * sizeof(float));
+        d->pub_seq = seq;
+        d->pub_count = 0;
+        d->pub_steps = 0;
+        d->pub_ms = 0.0;
+        os_mutex_unlock(&d->mu);
+        seen_seq = seq;
+
+        /* Reconcile the sliding KV window with the committed prefix before
+         * appending: drop the newest rows past q_valid, or reset on any
+         * discontinuity.  All KV mutations stay on this thread. */
+        if (reset_kv || !d->kv_any || d->kv_last_pos < q_valid) {
+            ds4_mtp_cpu_state_reset(&d->cpu);
+            d->kv_any = false;
+        } else if (d->kv_last_pos > q_valid) {
+            const uint32_t drop = d->kv_last_pos - q_valid;
+            if (drop >= d->cpu.cache.n_raw) {
+                ds4_mtp_cpu_state_reset(&d->cpu);
+                d->kv_any = false;
+            } else {
+                d->cpu.cache.n_raw -= drop;
+            }
+        }
+        d->kv_last_pos = q_valid;
+
+        const double t0 = now_sec();
+        float *prev = d->hc_a;
+        float *next = d->hc_b;
+        int token = first_token;
+        uint32_t pos = first_pos;
+
+        for (int step = 1; step <= k + 1; step++) {
+            os_mutex_lock(&d->mu);
+            const bool abandon =
+                d->shutdown || d->job_seq != seq || d->job_consumed;
+            os_mutex_unlock(&d->mu);
+            if (abandon) break;
+
+            ds4_mtp_cpu_forward_nextn_q4_k(
+                &d->cpu,
+                d->base_model, d->base_weights,
+                d->mtp_model, d->mtp,
+                prev, token, pos,
+                next, d->head_hidden, NULL);
+            d->kv_last_pos = pos;
+            d->kv_any = true;
+
+            int top0 = -1, top1 = -1;
+            float v0 = 0.0f, v1 = 0.0f;
+            ds4_nextn_head_top2(d, &top0, &v0, &top1, &v1);
+            if (top0 < 0) break;
+
+            bool hit_eos = false;
+            os_mutex_lock(&d->mu);
+            if (d->job_seq == seq) {
+                d->pub_steps = step;
+                d->pub_ms = (now_sec() - t0) * 1000.0;
+                if (step <= k) {
+                    d->pub_drafts[step - 1] = top0;
+                    d->pub_margin[step - 1] = v0 - v1;
+                    d->pub_runner[step - 1] = top1;
+                }
+                /* Row-holdback: draft i becomes deliverable once step i+1
+                 * has written the KV row of its commit position.  An EOS
+                 * draft ends the request, so no later row can be needed. */
+                int deliverable = step - 1;
+                if (step <= k && top0 == eos_token) {
+                    deliverable = step;
+                    hit_eos = true;
+                }
+                if (deliverable > d->pub_count) d->pub_count = deliverable;
+            }
+            os_mutex_unlock(&d->mu);
+            if (hit_eos) break;
+
+            token = top0;
+            pos++;
+            {
+                float *tmp = prev;
+                prev = next;
+                next = tmp;
+            }
+        }
+    }
+}
