+/* DSPARK-2: parallel dispatch for the NextN CPU draft cycle.
+ *
+ * The draft cycle runs on a dedicated drafter thread while the CUDA decode
+ * thread may still be submitting to the process-global pool, whose single
+ * mutable fn/ctx/done slot supports one submitter (see the G132 lane comment
+ * above ds4_g132_worker_main).  A drafter thread therefore (a) pins its own
+ * thread-local g_parallel_depth to 1 so every existing helper it reuses runs
+ * inline instead of submitting to g_pool, and (b) routes the heavy kernels it
+ * owns (routed Q4_K and the vocabulary head) to the independent G132 lane
+ * pool through this shim.  The G132 submit slot is single-submitter as well,
+ * so one mutex serializes drafter submissions; the backbone lane itself is
+ * mutually exclusive with the drafter (enforced at engine open).  On any
+ * other thread the shim is byte-identical to ds4_parallel_for. */
+static _Thread_local bool g_nextn_drafter_thread;
+static os_once_t g_nextn_submit_once = OS_ONCE_INIT;
+static os_mutex_t g_nextn_submit_mu;
+
+static void ds4_nextn_submit_mutex_init(void) {
+    if (os_mutex_init(&g_nextn_submit_mu) != 0) {
+        ds4_die("NextN drafter submit mutex init failed");
+    }
+}
+
+static void ds4_nextn_parallel_for(
+        uint64_t n_rows, ds4_parallel_fn fn, void *ctx) {
+    if (g_nextn_drafter_thread) {
+        os_once(&g_nextn_submit_once, ds4_nextn_submit_mutex_init);
+        os_mutex_lock(&g_nextn_submit_mu);
+        const int ok = ds4_g132_parallel_for(n_rows, fn, ctx);
+        os_mutex_unlock(&g_nextn_submit_mu);
+        if (ok) return;
+        fn(ctx, 0, n_rows);
+        return;
+    }
+    ds4_parallel_for(n_rows, fn, ctx);
+}
