+#ifndef DS4_NO_GPU
+/* ==== DSPARK-2: session-facing drafter plumbing (flag-gated) ============ */
+
+static bool ds4_nextn_drafter_create(ds4_session *s) {
+    ds4_engine *e = s->engine;
+    ds4_nextn_drafter *d = xcalloc(1, sizeof(*d));
+    const uint64_t hc_dim = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+    d->base_model = &e->model;
+    d->base_weights = &e->weights;
+    d->mtp_model = &e->mtp_model;
+    d->mtp = &e->mtp_weights;
+    d->k = e->nextn_draft_k;
+    if (d->k < 1) d->k = 1;
+    if (d->k > DS4_NEXTN_DRAFT_MAX) d->k = DS4_NEXTN_DRAFT_MAX;
+    d->job_anchor_hc = xmalloc(hc_dim * sizeof(float));
+    d->hc_a = xmalloc(hc_dim * sizeof(float));
+    d->hc_b = xmalloc(hc_dim * sizeof(float));
+    d->head_hidden = xmalloc((size_t)DS4_N_EMBD * sizeof(float));
+    d->head_logits = xmalloc((size_t)DS4_N_VOCAB * sizeof(float));
+    d->head_xq = xmalloc((size_t)DS4_N_EMBD);
+    d->head_xscale = xmalloc(((size_t)DS4_N_EMBD / 32) * sizeof(float));
+    ds4_mtp_cpu_state_init(&d->cpu);
+    d->needs_reset = true;
+    bool ok = os_mutex_init(&d->mu) == 0;
+    d->mu_ready = ok;
+    if (ok) {
+        ok = os_cond_init(&d->cv) == 0;
+        d->cv_ready = ok;
+    }
+    if (ok) {
+        ok = os_thread_create(&d->thread, ds4_nextn_worker_main, d) == 0;
+        d->thread_ready = ok;
+    }
+    if (!ok) {
+        if (d->cv_ready) os_cond_destroy(&d->cv);
+        if (d->mu_ready) os_mutex_destroy(&d->mu);
+        ds4_mtp_cpu_state_free(&d->cpu);
+        free(d->job_anchor_hc);
+        free(d->hc_a);
+        free(d->hc_b);
+        free(d->head_hidden);
+        free(d->head_logits);
+        free(d->head_xq);
+        free(d->head_xscale);
+        free(d);
+        return false;
+    }
+    s->nextn = d;
+    return true;
+}
+
+static void ds4_nextn_drafter_destroy(ds4_session *s) {
+    ds4_nextn_drafter *d = s->nextn;
+    if (!d) return;
+    if (d->thread_ready) {
+        os_mutex_lock(&d->mu);
+        d->shutdown = true;
+        os_cond_broadcast(&d->cv);
+        os_mutex_unlock(&d->mu);
+        os_thread_join(d->thread);
+    }
+    if (d->cv_ready) os_cond_destroy(&d->cv);
+    if (d->mu_ready) os_mutex_destroy(&d->mu);
+    ds4_mtp_cpu_state_free(&d->cpu);
+    free(d->job_anchor_hc);
+    free(d->hc_a);
+    free(d->hc_b);
+    free(d->head_hidden);
+    free(d->head_logits);
+    free(d->head_xq);
+    free(d->head_xscale);
+    free(d);
+    s->nextn = NULL;
+}
+
+/* Rendezvous: called right after ds4_session_eval(first_token) committed the
+ * true token.  Takes whatever the pending chain has published - never waits.
+ * A pending job is valid only if it predicted exactly this token at exactly
+ * this position; anything else marks the CPU KV window for reset.  Either
+ * way the job is consumed so the worker stops burning cores on dead drafts. */
+static int ds4_nextn_drafter_take(
+        ds4_session *s, int first_token, int *drafts, int draft_cap,
+        float *out_margin, int *out_top0, int *out_top1) {
+    ds4_nextn_drafter *d = s->nextn;
+    if (!d) return 0;
+    if (draft_cap > DS4_NEXTN_DRAFT_MAX) draft_cap = DS4_NEXTN_DRAFT_MAX;
+    int n = 0;
+    d->cycle_gen = 0;
+    d->cycle_ms = 0.0;
+    d->cycle_stale = true;
+    os_mutex_lock(&d->mu);
+    const bool addressed = d->job_seq != 0 && !d->job_consumed &&
+        d->job_first_token == first_token &&
+        d->job_first_pos == (uint32_t)(s->checkpoint.len - 1);
+    const bool ready = addressed && d->pub_seq == d->job_seq;
+    if (d->job_seq != 0) d->job_consumed = true;
+    if (ready) {
+        d->cycle_stale = false;
+        d->cycle_gen = d->pub_steps;
+        d->cycle_ms = d->pub_ms;
+        n = d->pub_count;
+        if (n > draft_cap) n = draft_cap;
+        if (n > 0) {
+            for (int i = 0; i < n; i++) drafts[i] = d->pub_drafts[i];
+            *out_margin = d->pub_margin[n - 1];
+            *out_top0 = d->pub_drafts[n - 1];
+            *out_top1 = d->pub_runner[n - 1];
+        }
+    } else if (!addressed) {
+        /* Wrong token or wrong position: the pending chain (and its KV
+         * rows) belong to a trajectory the stream did not take. */
+        d->needs_reset = true;
+    }
+    os_mutex_unlock(&d->mu);
+    return n;
+}
+
+/* Kick the chain for the NEXT cycle.  anchor_kind selects where the
+ * committed-frontier backbone HC lives; the 64 KB D2H read is the same
+ * bridge class as the measured lane input (DSPARK.md sez. 3). */
+static void ds4_nextn_drafter_kick(
+        ds4_session *s, int anchor_kind, uint32_t anchor_row, int eos_token) {
+    ds4_nextn_drafter *d = s->nextn;
+    if (!d || anchor_kind == DS4_NEXTN_ANCHOR_NONE) return;
+    if (s->checkpoint.len <= 0) return;
+    const int next_pred = sample_argmax(s->logits, DS4_N_VOCAB);
+    if (next_pred < 0 || next_pred == eos_token) return;
+    const uint64_t hc_bytes =
+        (uint64_t)DS4_N_HC * DS4_N_EMBD * sizeof(float);
+    os_mutex_lock(&d->mu);
+    bool ok;
+    if (anchor_kind == DS4_NEXTN_ANCHOR_CUR_HC) {
+        ok = ds4_gpu_tensor_read(s->graph.cur_hc, 0,
+                                 d->job_anchor_hc, hc_bytes) != 0;
+    } else {
+        ok = ds4_gpu_tensor_read(s->graph.batch_cur_hc,
+                                 (uint64_t)anchor_row * hc_bytes,
+                                 d->job_anchor_hc, hc_bytes) != 0;
+    }
+    if (ok) {
+        d->job_seq++;
+        d->job_consumed = false;
+        d->job_first_token = next_pred;
+        d->job_first_pos = (uint32_t)s->checkpoint.len;
+        d->job_q_valid = (uint32_t)(s->checkpoint.len - 1);
+        d->job_eos_token = eos_token;
+        d->job_reset_kv = d->needs_reset;
+        d->needs_reset = false;
+        os_cond_signal(&d->cv);
+    }
+    os_mutex_unlock(&d->mu);
+}
+
+/* Per-cycle [nextn-draft] telemetry plus the next kick.  Call once per
+ * speculative cycle at the point where the commit outcome is known and the
+ * final logits row is on the host. */
+static void ds4_nextn_cycle_end(
+        ds4_session *s, int delivered, int accepted,
+        int anchor_kind, uint32_t anchor_row,
+        int eos_token, bool continue_ok, bool hit_eos) {
+    ds4_nextn_drafter *d = s->nextn;
+    if (!d) return;
+    d->req_cycles++;
+    if (d->cycle_gen > 0) d->req_generated += (uint64_t)d->cycle_gen;
+    d->req_delivered += (uint64_t)delivered;
+    d->req_accepted += (uint64_t)accepted;
+    d->req_draft_ms += d->cycle_ms;
