+/* =========================================================================
+ * DSPARK-2fix2: NextN module warm-up (prewarm + pin).
+ * =========================================================================
+ *
+ * Misura 2026-07-29 (binario 3DE06FD01C7CFB4D): step_ms_avg=186, max=523 -
+ * ogni passo di catena pagava first-touch page fault dal mmap PAGEABLE del
+ * modulo (il gate (a) lo lascia deliberatamente non registrato/non pinnato
+ * lato CUDA).  Working set per passo: denso ~178 MB (attn 113,8 + e/h_proj
+ * 35,7 + shexp 26,7 + hc/router ~1,6) sempre uguale, 6 esperti Q4_K da
+ * 14,16 MB variabili per token (pool 3,54 GiB), testa base Q8_0 562,6 MB.
+ *
+ * Rimedio in due tempi, una volta sola a engine-open:
+ *  - PREWARM (DS4_NEXTN_PREWARM, default 1): una passata sequenziale su
+ *    tutta la finestra tensori del modulo e sulla testa - il first-touch
+ *    si paga a velocita' di readahead all'avvio invece che a fault sparsi
+ *    per passo;
+ *  - PIN (DS4_NEXTN_PIN, default 1): VirtualLock/mlock del working set
+ *    per-passo garantito (denso del modulo + testa, ~741 MB) cosi' la
+ *    pressione di memoria non lo sfratta; DS4_NEXTN_PIN=2 blocca anche i
+ *    256 esperti (~+3,54 GiB), DS4_NEXTN_PIN=0 disattiva.
+ * Fallimenti di lock sono soft: una riga di log, si resta su page cache. */
+#ifndef _WIN32
+#include <sys/mman.h>
+#endif
+
+static uint64_t ds4_nextn_touch_region(const uint8_t *base, uint64_t bytes) {
+    uint64_t sum = 0;
+    for (uint64_t off = 0; off < bytes; off += 4096u) {
+        sum += base[off];
+    }
+    if (bytes != 0) sum += base[bytes - 1u];
+    return sum;
+}
+
+static bool ds4_nextn_lock_region(const void *base, uint64_t bytes) {
+    if (!base || bytes == 0) return true;
+    const uintptr_t page = 4096u;
+    const uintptr_t lo = (uintptr_t)base & ~(page - 1u);
+    const uintptr_t hi =
+        ((uintptr_t)base + (uintptr_t)bytes + page - 1u) & ~(page - 1u);
+#ifdef _WIN32
+    return VirtualLock((LPVOID)lo, (SIZE_T)(hi - lo)) != 0;
+#else
+    return mlock((const void *)lo, (size_t)(hi - lo)) == 0;
+#endif
+}
+
+#ifdef _WIN32
+static void ds4_nextn_grow_working_set(uint64_t bytes) {
+    /* VirtualLock is capped by the process minimum working set: grow it
+     * first (own process, no privilege needed), with headroom. */
+    SIZE_T cur_min = 0;
+    SIZE_T cur_max = 0;
+    HANDLE self = GetCurrentProcess();
+    if (!GetProcessWorkingSetSize(self, &cur_min, &cur_max)) return;
+    const SIZE_T grow = (SIZE_T)bytes + (SIZE_T)(64u << 20);
+    (void)SetProcessWorkingSetSize(self, cur_min + grow, cur_max + grow);
+}
+#endif
+
+static void ds4_nextn_engine_warmup(ds4_engine *e) {
+    const char *pw_env = getenv("DS4_NEXTN_PREWARM");
+    const char *pin_env = getenv("DS4_NEXTN_PIN");
+    const bool do_prewarm = !(pw_env && strcmp(pw_env, "0") == 0);
+    long pin_mode = 1;
+    if (pin_env && pin_env[0]) pin_mode = strtol(pin_env, NULL, 10);
+
+    const uint8_t *mod_base = (const uint8_t *)e->mtp_model.map +
+                              e->mtp_model.tensor_data_pos;
+    const uint64_t mod_bytes =
+        e->mtp_model.size - e->mtp_model.tensor_data_pos;
+    const ds4_tensor *head_t = e->weights.output;
+    const uint8_t *head_base =
+        (const uint8_t *)tensor_data(&e->model, head_t);
+    const uint64_t head_bytes = head_t->bytes;
+
+    if (do_prewarm) {
+        volatile uint64_t sink = 0;
+        const double t0 = now_sec();
+        sink += ds4_nextn_touch_region(mod_base, mod_bytes);
+        const double t_mod = now_sec();
+        sink += ds4_nextn_touch_region(head_base, head_bytes);
+        const double t_head = now_sec();
+        (void)sink;
+        fprintf(stderr,
+                "ds4: [nextn-cpu] prewarm module=%.1f MB in %.0f ms, "
+                "head=%.1f MB in %.0f ms\n",
+                (double)mod_bytes / 1048576.0,
+                (t_mod - t0) * 1000.0,
+                (double)head_bytes / 1048576.0,
+                (t_head - t_mod) * 1000.0);
+    }
+    if (pin_mode <= 0) return;
+
+    const ds4_mtp_weights *mw = &e->mtp_weights;
+    const ds4_layer_weights *bl = &mw->block;
+    const ds4_tensor *dense[] = {
+        mw->e_proj, mw->h_proj, mw->enorm, mw->hnorm, mw->norm,
+        mw->hc_head_base, mw->hc_head_fn, mw->hc_head_scale,
+        bl->hc_attn_fn, bl->hc_attn_scale, bl->hc_attn_base,
+        bl->attn_norm, bl->attn_q_a, bl->attn_q_a_norm, bl->attn_q_b,
+        bl->attn_kv, bl->attn_kv_a_norm, bl->attn_sinks,
+        bl->attn_output_a, bl->attn_output_b,
+        bl->hc_ffn_fn, bl->hc_ffn_scale, bl->hc_ffn_base, bl->ffn_norm,
+        bl->ffn_gate_inp, bl->ffn_exp_probs_b,
+        bl->ffn_gate_shexp, bl->ffn_up_shexp, bl->ffn_down_shexp,
+    };
+    const ds4_tensor *exps[] = {
+        bl->ffn_gate_exps, bl->ffn_up_exps, bl->ffn_down_exps,
+    };
+    uint64_t want = head_bytes;
+    for (size_t i = 0; i < sizeof(dense) / sizeof(dense[0]); i++) {
+        want += dense[i]->bytes;
+    }
+    if (pin_mode >= 2) {
+        for (size_t i = 0; i < sizeof(exps) / sizeof(exps[0]); i++) {
+            want += exps[i]->bytes;
+        }
+    }
+#ifdef _WIN32
+    ds4_nextn_grow_working_set(want);
+#endif
+    uint64_t locked = 0;
+    uint64_t failed = 0;
+    for (size_t i = 0; i < sizeof(dense) / sizeof(dense[0]); i++) {
+        const ds4_tensor *t = dense[i];
+        if (ds4_nextn_lock_region(tensor_data(&e->mtp_model, t), t->bytes)) {
+            locked += t->bytes;
+        } else {
+            failed += t->bytes;
+        }
+    }
+    if (ds4_nextn_lock_region(head_base, head_bytes)) locked += head_bytes;
+    else failed += head_bytes;
+    if (pin_mode >= 2) {
+        for (size_t i = 0; i < sizeof(exps) / sizeof(exps[0]); i++) {
+            const ds4_tensor *t = exps[i];
+            if (ds4_nextn_lock_region(tensor_data(&e->mtp_model, t),
+                                      t->bytes)) {
+                locked += t->bytes;
+            } else {
+                failed += t->bytes;
+            }
+        }
+    }
+    fprintf(stderr,
+            "ds4: [nextn-cpu] pin mode=%ld locked=%.1f MB failed=%.1f MB "
+            "(1=dense+head, 2=+experts, 0=off)\n",
+            pin_mode,
+            (double)locked / 1048576.0,
+            (double)failed / 1048576.0);
+}
