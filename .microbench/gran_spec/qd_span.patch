+/* Cap one logical QD span's individual ReadFile requests.  The default keeps
+ * the historical whole-span submit.  This is buffered Windows I/O, so no
+ * sector/device alignment is required; the KiB unit is an operational knob,
+ * not an alignment contract. */
+static uint64_t cuda_route_io_qd_span_bytes_requested(void) {
+    static int initialized = 0;
+    static uint64_t span_bytes = UINT64_MAX;
+    if (initialized) return span_bytes;
+    initialized = 1;
+    const char *env = getenv("DS4_CUDA_ROUTE_IO_QD_SPAN_KB");
+    if (!env || !env[0]) return span_bytes;
+    char *end = NULL;
+    errno = 0;
+    const unsigned long long value = strtoull(env, &end, 10);
+    while (end && (*end == ' ' || *end == '\t')) end++;
+    if (end == env || errno != 0 || !end || *end != '\0' ||
+        value == 0ull || value > 0xffffffffull / 1024ull) {
+        fprintf(stderr,
+                "ds4: invalid DS4_CUDA_ROUTE_IO_QD_SPAN_KB=%s; "
+                "using whole logical span\n",
+                env);
+        return span_bytes;
+    }
+    span_bytes = (uint64_t)value * 1024ull;
+    return span_bytes;
+}
