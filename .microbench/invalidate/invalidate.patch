+/* =======================================================================
+ * INVALIDATE-SCOPED (DS4_CUDA_SCOPED_INVALIDATE=1, opt-in).
+ *
+ * Invariante protetto — lo stesso del reset totale: ogni voce della mappa
+ * device (layer,expert)->slot visibile al resolver deve puntare a uno slot
+ * i cui byte VRAM sono i pesi COMPLETI e CORRENTI di quella coppia, e gli
+ * indici host (slots[], host_slot_by_layer_expert, count) devono
+ * concordare.  Su una richiesta fallita le sole voci che possono violarlo
+ * sono quelle del registro di prenotazione della richiesta stessa
+ * (promotion_reservations): lo slot prenotato (byte eventualmente
+ * sovrascritti a meta' dagli H2D accodati), la chiave candidata (publish
+ * eventualmente eseguito) e la chiave vittima (publish eventualmente NON
+ * eseguito con H2D gia' passato: mappa device stantia su byte
+ * sovrascritti).  Ogni altro slot resta intatto per costruzione:
+ * pick_vram_slot reclama solo gli slot del registro e le richieste sono
+ * serializzate dalla mailbox.
+ *
+ * Il rollback mirato e' lecito SOLO a stream di upload provato quieto:
+ * con publish ancora in volo la mappa device puo' mutare in un istante
+ * arbitrario (ds4_cuda.cu, commento "A joined host worker is not a drained
+ * CUDA producer").  transfer_ok del drain e' la prova nel caso comune
+ * (G73_OPEN=0: poll senza deadline fino a quiescenza); altrimenti si
+ * ri-polla con lo stesso bound di cancel_and_join e, se non si dimostra,
+ * si ricade sul reset totale di oggi.
+ *
+ * Tutto il codice nuovo e' raggiungibile solo dalle specializzazioni
+ * SCOPED=true del route worker, selezionate una volta all'init: a flag
+ * spento le istanze compilate del percorso attivo sono le stesse di oggi.
+ * ======================================================================= */
+static std::atomic<uint32_t> g_moe_route_failure_scoped_sequence(0u);
+
+static void cuda_moe_route_failure_scoped_sign(
+        uint32_t sequence, uint32_t reservations,
+        uint32_t slots_emptied, uint32_t victims_unmapped,
+        const char *note) {
+    if (sequence == 0u) return;
+    g_moe_route_failure_scoped_sequence.store(
+        sequence, std::memory_order_release);
+    if (cuda_worker_profile_enabled()) {
+        ds4_workerprof_add(WP_CACHE_INVALIDATES_SCOPED, 1u);
+        ds4_workerprof_add(WP_CACHE_SCOPED_ENTRIES_DROPPED, slots_emptied);
+        fprintf(stderr,
+                "ds4: [cache-invalidate] scope=scoped seq=%u reservations=%u "
+                "slots_emptied=%u victims_unmapped=%u note=%s\n",
+                sequence, reservations, slots_emptied, victims_unmapped,
+                note ? note : "none");
+    }
+}
+
+static int cuda_moe_route_failure_scoped_consume(uint32_t sequence) {
+    return sequence != 0u &&
+        g_moe_route_failure_scoped_sequence.load(
+            std::memory_order_acquire) == sequence;
+}
+
+static int cuda_moe_tiering_scoped_invalidate(
+        cuda_moe_expert_cache *cache,
+        const cuda_moe_vram_promotion_reservation *reservations,
+        uint32_t count, uint32_t sequence, int stream_known_quiet) {
+    if (!cache || !reservations || sequence == 0u) return 0;
+    if (!stream_known_quiet && cache->route_upload_stream) {
+        /* Drain fallito o non concluso: prova la quiescenza con lo stesso
+         * bound del percorso cancel_and_join prima di toccare la mappa. */
+        const double quiesce_deadline = cuda_wall_sec() + 5.0;
+        cudaError_t status = cudaStreamQuery(cache->route_upload_stream);
+        while (status == cudaErrorNotReady &&
+               cuda_wall_sec() < quiesce_deadline) {
+#ifdef _WIN32
+            (void)SwitchToThread();
+#else
+            usleep(0);
+#endif
+            status = cudaStreamQuery(cache->route_upload_stream);
+        }
+        if (status != cudaSuccess) {
+            (void)cudaGetLastError();
+            return 0;
+        }
+    }
+    uint32_t slots_emptied = 0u;
+    uint32_t victims_unmapped = 0u;
+    const int32_t empty_map_entry = -1;
+    for (uint32_t i = 0; i < count; i++) {
+        const cuda_moe_vram_promotion_reservation &reservation =
+            reservations[i];
+        if (!reservation.active ||
+            reservation.cache_slot >= cache->capacity ||
+            reservation.candidate_layer >= CUDA_MOE_LAYER_COUNT ||
+            reservation.candidate_expert >= 256u) {
+            continue;
+        }
+        cuda_moe_cache_slot &entry = cache->slots[reservation.cache_slot];
+        /* Idempotente: il drain anticipato fallito e quello finale possono
+         * rieseguire lo stesso registro; il secondo passaggio trova lo slot
+         * gia' EMPTY e non riconta ne' ridecrementa. */
+        const int first_pass = entry.state != CUDA_MOE_CACHE_EMPTY;
+        const size_t new_map_index = cuda_moe_tiering_entry_index(
+            reservation.candidate_layer, reservation.candidate_expert);
+        if (new_map_index < cache->host_slot_by_layer_expert.size() &&
+            cache->host_slot_by_layer_expert[new_map_index] ==
+                (int32_t)reservation.cache_slot) {
+            cache->host_slot_by_layer_expert[new_map_index] = -1;
+        }
+        if (cache->device_slot_by_layer_expert &&
+            cudaMemcpy(cache->device_slot_by_layer_expert + new_map_index,
+                       &empty_map_entry, sizeof(int32_t),
+                       cudaMemcpyHostToDevice) != cudaSuccess) {
+            (void)cudaGetLastError();
+            return 0;
+        }
+        if (reservation.victim_valid &&
+            reservation.victim_layer < CUDA_MOE_LAYER_COUNT &&
+            reservation.victim_expert < 256u) {
+            const size_t old_map_index = cuda_moe_tiering_entry_index(
+                reservation.victim_layer, reservation.victim_expert);
+            if (old_map_index < cache->host_slot_by_layer_expert.size() &&
+                cache->host_slot_by_layer_expert[old_map_index] ==
+                    (int32_t)reservation.cache_slot) {
+                cache->host_slot_by_layer_expert[old_map_index] = -1;
+            }
+            if (cache->device_slot_by_layer_expert &&
+                cudaMemcpy(cache->device_slot_by_layer_expert + old_map_index,
+                           &empty_map_entry, sizeof(int32_t),
+                           cudaMemcpyHostToDevice) != cudaSuccess) {
+                (void)cudaGetLastError();
+                return 0;
+            }
+            if (first_pass) {
+                victims_unmapped++;
+                if (cache->count > 0u) cache->count--;
+            }
+        }
+        /* Il rollback di stato tier (candidato ripristinato, vittima
+         * demansionata) e' gia' stato fatto da refund_failed_promotions,
+         * chiamata prima di questa funzione: qui si azzera solo l'indice. */
+        entry.state = CUDA_MOE_CACHE_EMPTY;
+        entry.age = 0;
+        entry.layer_key = 0;
+        entry.layer_index = UINT32_MAX;
+        entry.expert_id = UINT32_MAX;
+        entry.layer_owned = 0;
+        if (first_pass) slots_emptied++;
+    }
+    cuda_moe_route_failure_scoped_sign(
+        sequence, count, slots_emptied, victims_unmapped,
+        stream_known_quiet ? "drain-clean" : "quiesced");
+    return 1;
+}
