+/* Split hit/miss starts its hit kernels before the route worker has finished.
+ * A G132 CPU route is necessarily a miss and is deliberately left unpublished,
+ * so publish its ownership into the split mask only after the worker has
+ * assigned it and zero its split-down slot before the ordinary miss kernels.
+ * Stream-0 ordering makes the existing split kernels skip the zero route_ptr
+ * and makes both split reducers add an exact zero for the CPU-owned slot. */
+__global__ static void moe_g132_split_mask_cpu_routes_kernel(
+        float *split_down,
+        uint32_t *route_hit_mask,
+        uint32_t cpu_mask,
+        uint32_t route_count,
+        uint32_t out_dim) {
+    const uint64_t gid =
+        (uint64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    const uint64_t count = (uint64_t)route_count * out_dim;
+    if (gid < count) {
+        const uint32_t route = (uint32_t)(gid / out_dim);
+        if ((cpu_mask & (1u << route)) != 0u) {
+            split_down[gid] = 0.0f;
+        }
+    }
+    if (gid == 0u) {
+        *route_hit_mask |= cpu_mask;
+    }
+}
