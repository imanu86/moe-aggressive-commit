+static int cuda_g132_general_plan_admit(
+        cuda_moe_expert_cache *cache,
+        const cuda_moe_route_request &request,
+        uint32_t route,
+        uint32_t expert,
+        const char *host_gate,
+        const char *host_up,
+        const char *host_down,
+        int have_ram,
+        int from_nested,
+        int demand_pipeline_active,
+        uint32_t arena_slot,
+        uint32_t ssd_wrap_h2d_ring) {
+    cuda_g132_general_plan &plan = cache->route_cpu_plan;
+    if (plan.sequence != request.sequence ||
+        plan.generation != request.host_generation ||
+        plan.target_cpu == 0u || route >= request.route_count ||
+        !host_gate || !host_up || !host_down) {
+        return 0;
+    }
+    plan.eligible++;
+    if (plan.cpu_count >= plan.target_cpu) {
+        if (plan.target_cpu >= g_g132_cpu_lane.max_experts_per_layer) {
+            plan.rejected_cap++;
+        } else {
+            plan.rejected_balance++;
+        }
+        return 0;
+    }
+    if (from_nested) {
+        g_g132_cpu_lane.general_fallback_contract++;
+        return 0;
+    }
+    if (!have_ram && demand_pipeline_active) {
+        /* P4a compacts later GPU misses toward route_host slot zero.  A CPU
+         * reader of an earlier SSD slice would otherwise be overwritten. */
+        g_g132_cpu_lane.general_fallback_pipeline++;
+        return 0;
+    }
+    if (ssd_wrap_h2d_ring != UINT32_MAX) {
+        g_g132_cpu_lane.general_fallback_wrap++;
+        return 0;
+    }
+
+    cuda_g132_general_route admitted = {};
+    admitted.gate = host_gate;
+    admitted.up = host_up;
+    admitted.down = host_down;
+    admitted.route = route;
+    admitted.expert = (int32_t)expert;
+    admitted.weight = request.weights[route];
+    admitted.slot_identity = UINT32_MAX;
+    admitted.slot_generation = 0u;
+    admitted.backing = have_ram
+        ? CUDA_G132_CPU_LANE_BACKING_ARENA
+        : CUDA_G132_CPU_LANE_BACKING_ROUTE_STAGING;
+    if (have_ram) {
+        if (arena_slot >= g_dynamic_arena.slots.size()) {
+            g_g132_cpu_lane.general_fallback_reservation++;
+            return 0;
+        }
+        cuda_dynamic_arena_slot &slot = g_dynamic_arena.slots[arena_slot];
+        const int reader_acquired =
+            cuda_dynamic_arena_slot_reader_acquire(&slot);
+        if (!reader_acquired || slot.pageable || !slot.host_ptr ||
+            slot.layer != request.layer_index || slot.expert != expert ||
+            slot.content_generation == 0u ||
+            host_gate != slot.host_ptr ||
+            host_up != slot.host_ptr + cache->gate_expert_bytes ||
+            host_down != host_up + cache->gate_expert_bytes) {
+            if (reader_acquired) {
+                cuda_dynamic_arena_slot_reader_release(&slot);
+            }
+            g_g132_cpu_lane.general_fallback_reservation++;
+            return 0;
+        }
+        admitted.slot_identity = arena_slot;
+        admitted.slot_generation = slot.content_generation;
+    } else {
+        uint64_t expected = 0u;
+        if (!cache->route_cpu_staging_generation.compare_exchange_strong(
+                expected, request.host_generation,
+                std::memory_order_acq_rel, std::memory_order_acquire) &&
+            expected != request.host_generation) {
+            g_g132_cpu_lane.general_fallback_reservation++;
+            return 0;
+        }
+        plan.staging_count++;
+    }
+    plan.routes[plan.cpu_count++] = admitted;
+    plan.cpu_mask |= 1u << route;
+    return 1;
+}
