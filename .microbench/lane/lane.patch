+/* The route worker deliberately leaves CPU-owned entries unpublished.  Once
+ * its upload stream has drained, compact the remaining route pointers and
+ * router weights on stream 0 without ever materializing a CPU route in VRAM. */
+__global__ static void moe_g132_compact_gpu_routes_kernel(
+        uint64_t *compact_route_ptrs,
+        float *compact_weights,
+        const uint64_t *route_ptrs,
+        const float *weights,
+        uint32_t route_count,
+        uint32_t cpu_mask,
+        uint32_t gpu_count) {
+    if (blockIdx.x != 0 || threadIdx.x != 0 || !compact_route_ptrs ||
+        !compact_weights || !route_ptrs || !weights ||
+        route_count == 0u || route_count > 6u || gpu_count == 0u ||
+        gpu_count >= route_count) {
+        return;
+    }
+    uint32_t gpu = 0u;
+    for (uint32_t route = 0; route < route_count; route++) {
+        if ((cpu_mask & (1u << route)) != 0u) continue;
+        if (gpu >= gpu_count) return;
+        compact_route_ptrs[gpu] = route_ptrs[route];
+        compact_route_ptrs[gpu_count + gpu] =
+            route_ptrs[route_count + route];
+        compact_route_ptrs[2u * gpu_count + gpu] =
+            route_ptrs[2u * route_count + route];
+        compact_weights[gpu] = weights[route];
+        gpu++;
+    }
+}
