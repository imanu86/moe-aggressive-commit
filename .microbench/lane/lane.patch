+static void CUDART_CB cuda_g132_cpu_lane_gpu_started_callback(void *arg) {
+    cuda_g132_cpu_lane *lane = (cuda_g132_cpu_lane *)arg;
+    os_mutex_lock(&lane->mutex);
+    if (lane->job_active && lane->general_active) {
+        lane->gpu_started = cuda_wall_sec();
+    }
+    os_mutex_unlock(&lane->mutex);
+}
+
+static void CUDART_CB cuda_g132_cpu_lane_gpu_finished_callback(void *arg) {
+    cuda_g132_cpu_lane *lane = (cuda_g132_cpu_lane *)arg;
+    os_mutex_lock(&lane->mutex);
+    if (lane->job_active && lane->general_active) {
+        lane->gpu_finished = cuda_wall_sec();
+        lane->gpu_done = 1;
+        os_cond_signal(&lane->done_cond);
+    }
+    os_mutex_unlock(&lane->mutex);
+}
