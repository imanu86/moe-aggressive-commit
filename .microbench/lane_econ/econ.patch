+static void CUDART_CB cuda_g132_cpu_lane_join_gate_callback(void *arg) {
+    cuda_g132_cpu_lane *lane = (cuda_g132_cpu_lane *)arg;
+    os_mutex_lock(&lane->mutex);
+    while (lane->job_active && lane->join_enqueued &&
+           lane->completed_jobs < lane->job_count) {
+        (void)os_cond_wait(&lane->done_cond, &lane->mutex);
+    }
+    if (lane->job_active && lane->join_enqueued) {
+        lane->cpu_join_done = 1;
+        if (lane->job_failed) {
+            /* The worker zeroed host_partial: the H2D+add behind this
+             * callback joins an exact zero.  Latch the fault so the next
+             * engagement fails closed instead of trusting the lane. */
+            lane->async_fault = 1;
+            lane->failures++;
+            lane->general_fallback_runtime++;
+            fprintf(stderr,
+                    "ds4: [g132-general] result=async-fault layer=%u "
+                    "jobs=%u; partial joined as zeros, lane fails closed "
+                    "from the next engagement\n",
+                    lane->layer_index, lane->completed_jobs);
+        }
+        /* Workers are done: no CPU path touches resident expert bytes
+         * after this point, so the arena readers and the staging lease can
+         * go now instead of at a caller-side join.  The cache plan is NOT
+         * reset here: prepare_general already took ownership
+         * (plan.cpu_count = 0) and the route worker of the NEXT request
+         * may be writing the plan concurrently. */
+        cuda_g132_cpu_lane_release_reservations_locked(lane);
+        {
+            uint64_t expected = lane->source_generation;
+            (void)g_moe_expert_cache.route_cpu_staging_generation
+                .compare_exchange_strong(
+                    expected, 0u, std::memory_order_acq_rel,
+                    std::memory_order_acquire);
+        }
+        cuda_g132_cpu_lane_emit_general_stats_locked(lane);
+    }
+    os_mutex_unlock(&lane->mutex);
+}
+
+static void CUDART_CB cuda_g132_cpu_lane_dispatch_idle_callback(void *arg) {
+    cuda_g132_cpu_lane *lane = (cuda_g132_cpu_lane *)arg;
+    os_mutex_lock(&lane->mutex);
+    if (lane->join_enqueued) {
+        /* The partial H2D ahead of this callback has completed: only now
+         * may a new dispatch reuse host_partial and the job slots. */
+        lane->join_enqueued = 0;
+        lane->job_active = 0;
+        lane->input_ready = 0;
+        lane->general_active = 0;
+        os_cond_broadcast(&lane->work_cond);
+        os_cond_broadcast(&lane->done_cond);
+    }
+    os_mutex_unlock(&lane->mutex);
+}
+
+static int cuda_g132_cpu_lane_enqueue_join_general(
+        ds4_gpu_tensor *out, uint32_t layer_index) {
+    cuda_g132_cpu_lane &lane = g_g132_cpu_lane;
+    if (!lane.general_active || !out || !out->ptr) return 0;
+    const double enqueue_started = cuda_wall_sec();
+    os_mutex_lock(&lane.mutex);
+    lane.join_enqueued = 1;
+    lane.prev_dispatch_layer = layer_index;
+    lane.prev_dispatch_valid = 1;
+    os_mutex_unlock(&lane.mutex);
+    const size_t bytes = (size_t)lane.out_dim * sizeof(float);
+    int chain_ok =
+        cuda_ok(cudaLaunchHostFunc(
+                    lane.bridge_stream,
+                    cuda_g132_cpu_lane_join_gate_callback, &lane),
+                "G132 general join gate") &&
+        cuda_ok(cudaMemcpyAsync(
+                    lane.device_partial, lane.host_partial, bytes,
+                    cudaMemcpyHostToDevice, lane.bridge_stream),
+                "G132 CPU lane partial H2D") &&
+        cuda_ok(cudaEventRecord(lane.partial_copy_done, lane.bridge_stream),
+                "G132 CPU lane partial event") &&
+        cuda_ok(cudaLaunchHostFunc(
+                    lane.bridge_stream,
+                    cuda_g132_cpu_lane_dispatch_idle_callback, &lane),
+                "G132 general dispatch idle") &&
+        cuda_ok(cudaStreamWaitEvent(0, lane.partial_copy_done, 0),
+                "G132 CPU lane join wait");
+    if (chain_ok) {
+        /* Stream 0 already contains the hit/miss accumulation; the event
+         * wait publishes the one CPU partial after those writes, exactly
+         * like the old synchronous tail. */
+        add_f32_u64_kernel<<<(lane.out_dim + 255u) / 256u, 256>>>(
+            (float *)out->ptr, (const float *)out->ptr,
+            lane.device_partial, lane.out_dim);
+        chain_ok = cuda_ok(cudaGetLastError(), "G132 CPU lane output join");
+    }
+    os_mutex_lock(&lane.mutex);
+    lane.dispatch_enqueue_seconds = cuda_wall_sec() - enqueue_started;
+    if (!chain_ok) {
+        /* Revoke the join ownership: whatever part of the chain was
+         * enqueued becomes inert (both callbacks check join_enqueued under
+         * this mutex) and the synchronous cancel below cleans the
+         * dispatch.  The caller fails the request, so the layer output the
+         * add never reached is not consumed. */
+        lane.join_enqueued = 0;
+        os_cond_broadcast(&lane.done_cond);
+    }
+    os_mutex_unlock(&lane.mutex);
+    if (!chain_ok) {
+        lane.general_fallback_runtime++;
+        cuda_g132_cpu_lane_cancel_dispatch();
+        return 0;
+    }
+    return 1;
+}
