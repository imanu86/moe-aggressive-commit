+/* =======================================================================
+ * lane_econ: asynchronous join for the GENERAL lane.
+ *
+ * Measured 28/7 (run 2250-2600 tok, ctx 150k, kernel row-parallel): the
+ * blocking wait_and_join cost the caller thread ~1,1 ms per engaged layer
+ * (gpu_wall ~0,2 + gpu_wait_cpu 0,89 + wake/reduce/enqueue) - within noise
+ * of the WHOLE measured lane loss (47-50 ms/token / 43 layer).  The toll it
+ * was supposed to buy back (one route's transport quota) is NOT on the
+ * serial path in the demand-pipeline config: admission excludes staging
+ * routes, and an arena route's H2D drains overlapped with the other
+ * routes' SSD reads.  So the join must cost ~zero for the lane to have any
+ * economy at all.
+ *
+ * New shape: the caller ENQUEUES the join and returns.
+ *   bridge:  [gate hostfunc: wait CPU done, release reservations+lease,
+ *             emit stats]  ->  [H2D partial]  ->  [event]  ->
+ *            [idle hostfunc: dispatch reusable]
+ *   stream0: [waitEvent]  ->  [add partial]
+ * The CPU tail then hides under the NEXT layer's relay; the only residual
+ * critical-path cost is the bounded wait in prepare_general when the tail
+ * outlives that relay - measured and fed to the balancer.
+ *
+ * Failure semantics (job_failed after the chain is enqueued): the worker
+ * zeroed host_partial, the add joins an exact zero, the gate callback
+ * latches async_fault and the lane fails closed from the next engagement.
+ * The old path aborted the whole request instead; the fault is unreachable
+ * with the reservations/lease held (admit+prepare validated them) and is
+ * counted in fallback_runtime plus a loud stderr line.
+ * ======================================================================= */
+static void cuda_g132_cpu_lane_emit_general_stats_locked(
+        cuda_g132_cpu_lane *lane) {
+    if (!lane->stats_pending || !lane->gpu_done || !lane->cpu_join_done) {
+        return;
+    }
+    lane->stats_pending = 0;
+    const uint32_t layer_index = lane->layer_index;
+    const uint32_t count = lane->completed_jobs;
+    const uint32_t gpu_routes = lane->general_gpu_routes;
+    const uint32_t eligible = lane->general_current_eligible;
+    const uint32_t rejected_cap = lane->general_current_rejected_cap;
+    const uint32_t rejected_balance =
+        lane->general_current_rejected_balance;
+    const double cpu_seconds = lane->cpu_finished >= lane->cpu_started
+        ? lane->cpu_finished - lane->cpu_started : 0.0;
+    const double expert_seconds = lane->cpu_expert_seconds;
+    const uint32_t expert_count = lane->cpu_expert_count;
+    const double expert_ms = expert_count != 0u
+        ? expert_seconds * 1000.0 / (double)expert_count : 0.0;
+    const double gpu_seconds =
+        lane->gpu_started > 0.0 && lane->gpu_finished >= lane->gpu_started
+        ? lane->gpu_finished - lane->gpu_started : 0.0;
+    const double gpu_wait_cpu_seconds =
+        lane->gpu_finished > 0.0 && lane->cpu_finished > lane->gpu_finished
+        ? lane->cpu_finished - lane->gpu_finished : 0.0;
+    const double cpu_wait_gpu_seconds =
+        lane->gpu_finished > lane->cpu_finished
+        ? lane->gpu_finished - lane->cpu_finished : 0.0;
+    const uint64_t native_bytes =
+        g_moe_expert_cache.gate_expert_bytes * 2ull +
+        g_moe_expert_cache.down_expert_bytes;
+    lane->general_calls++;
+    lane->general_join_async++;
+    lane->general_route_cpu += count;
+    lane->general_route_gpu += gpu_routes;
+    lane->general_bytes_not_crossed += (uint64_t)count * native_bytes;
+    lane->general_expert_seconds += expert_seconds;
+    lane->general_cpu_seconds += cpu_seconds;
+    lane->general_gpu_seconds += gpu_seconds;
+    lane->general_gpu_wait_cpu_seconds += gpu_wait_cpu_seconds;
+    lane->general_cpu_wait_gpu_seconds += cpu_wait_gpu_seconds;
+    lane->general_wake_seconds += lane->cpu_wake_seconds;
+    lane->general_quant_seconds += lane->cpu_quant_seconds;
+    lane->general_reduce_seconds += lane->cpu_reduce_seconds;
+    lane->general_enqueue_seconds += lane->dispatch_enqueue_seconds;
+    lane->routes += count;
+    lane->partial_h2d_bytes += (uint64_t)lane->out_dim * sizeof(float);
+    if (layer_index < CUDA_G132_CPU_LANE_LAYER_COUNT) {
+        lane->general_layer_calls[layer_index]++;
+        lane->general_layer_cpu_routes[layer_index] += count;
+        lane->general_layer_cpu_seconds[layer_index] += cpu_seconds;
+        lane->general_layer_expert_seconds[layer_index] += expert_seconds;
+        lane->layer_gpu_routes[layer_index] += gpu_routes;
+        lane->layer_bytes_not_crossed[layer_index] +=
+            (uint64_t)count * native_bytes;
+        lane->layer_gpu_seconds[layer_index] += gpu_seconds;
+        lane->layer_gpu_wait_cpu_seconds[layer_index] +=
+            gpu_wait_cpu_seconds;
+        lane->layer_cpu_wait_gpu_seconds[layer_index] +=
+            cpu_wait_gpu_seconds;
+        lane->layer_calls[layer_index]++;
+        lane->layer_routes[layer_index] += count;
+        lane->layer_cpu_seconds[layer_index] += cpu_seconds;
+    }
+    fprintf(stderr,
+            "ds4: [g132-general-layer] layer=%u route_cpu=%u "
+            "route_gpu=%u bytes_non_attraversati=%llu "
+            "cpu_wall_ms=%.6f gpu_wall_ms=%.6f "
+            "expert_ms=%.6f "
+            "gpu_wait_cpu_ms=%.6f cpu_wait_gpu_ms=%.6f "
+            "wake_ms=%.6f quant_ms=%.6f reduce_ms=%.6f enqueue_ms=%.6f "
+            "worker_window_ms=%.6f prepare_wait_ms=%.6f join=async "
+            "eligible=%u rejected_cap=%u rejected_balance=%u "
+            "target_cpu=%u\n",
+            layer_index, count, gpu_routes,
+            (unsigned long long)((uint64_t)count * native_bytes),
+            cpu_seconds * 1000.0, gpu_seconds * 1000.0,
+            expert_ms, gpu_wait_cpu_seconds * 1000.0,
+            cpu_wait_gpu_seconds * 1000.0,
+            lane->cpu_wake_seconds * 1000.0,
+            lane->cpu_quant_seconds * 1000.0,
+            lane->cpu_reduce_seconds * 1000.0,
+            lane->dispatch_enqueue_seconds * 1000.0,
+            lane->dispatch_worker_window_seconds * 1000.0,
+            lane->dispatch_prepare_wait_seconds * 1000.0,
+            eligible, rejected_cap, rejected_balance,
+            layer_index < CUDA_G132_CPU_LANE_LAYER_COUNT
+                ? lane->layer_target_cpu[layer_index] : 0u);
+}
