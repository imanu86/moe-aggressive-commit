+/* Split hit/miss overlaps its hit kernels with the route worker, so a CPU
+ * route (a miss the worker deliberately left unpublished: its route_ptrs
+ * stay zero and its hit-mask bit stays zero) cannot be consumed by the
+ * pointer compaction the non-split path uses.  Instead, once the worker has
+ * drained, take device-side ownership on stream 0: mark the CPU routes as
+ * non-miss in the hit mask and zero their split-down slots.  The hit
+ * kernels already queued ahead of this launch saw the original mask; the
+ * miss kernels queued after it skip the CPU slots and never dereference
+ * the zero route_ptrs; both split reducers add an exact zero for those
+ * slots.  The 16 KiB CPU partial joins the output afterwards. */
+__global__ static void moe_g132_split_own_cpu_routes_kernel(
+        float *split_down,
+        uint32_t *route_hit_mask,
+        uint32_t cpu_mask,
+        uint32_t route_count,
+        uint32_t out_dim) {
+    if (!split_down || !route_hit_mask ||
+        route_count == 0u || route_count > 6u || out_dim == 0u) {
+        return;
+    }
+    const uint64_t gid =
+        (uint64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    const uint64_t count = (uint64_t)route_count * out_dim;
+    if (gid < count) {
+        const uint32_t route = (uint32_t)(gid / out_dim);
+        if ((cpu_mask & (1u << route)) != 0u) {
+            split_down[gid] = 0.0f;
+        }
+    }
+    if (gid == 0u) {
+        *route_hit_mask |= cpu_mask;
+    }
+}
