index 22be838..1e56bd9 100644
--- a/ds4-p4a/ds4.c
+++ b/ds4-p4a/ds4.c
@@ -822,6 +822,140 @@ static void ds4_parallel_for(uint64_t n_rows, ds4_parallel_fn fn, void *ctx) {
