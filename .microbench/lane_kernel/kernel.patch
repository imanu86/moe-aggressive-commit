+/*
+ * G132 runs while the CUDA decode thread is still submitting work.  The
+ * process-global pool above has one mutable fn/ctx/done slot and therefore
+ * does not support concurrent submitters.  Give the opt-in lane an independent
+ * pool instead of adding locking or a branch to every normal parallel_for.
+ * One lane orchestrator is the caller thread; n_threads-1 persistent helpers
+ * cover the remaining row partitions.
+ */
+static ds4_thread_pool g_g132_pool;
+static uint32_t g_g132_threads_started;
+static bool g_g132_mutex_ready;
+static bool g_g132_work_cond_ready;
+static bool g_g132_done_cond_ready;
+
+static void *ds4_g132_worker_main(void *arg) {
+    const uint32_t tid = (uint32_t)(uintptr_t)arg;
+    uint32_t seen_generation = 0;
+
+    for (;;) {
+        os_mutex_lock(&g_g132_pool.mutex);
+        while (seen_generation == g_g132_pool.generation &&
+               !g_g132_pool.shutdown) {
+            os_cond_wait(&g_g132_pool.work_cond, &g_g132_pool.mutex);
+        }
+        if (g_g132_pool.shutdown) {
+            os_mutex_unlock(&g_g132_pool.mutex);
+            return NULL;
+        }
+
+        seen_generation = g_g132_pool.generation;
+        ds4_parallel_fn fn = g_g132_pool.fn;
+        void *ctx = g_g132_pool.ctx;
+        const uint64_t n_rows = g_g132_pool.n_rows;
+        const uint32_t n_threads = g_g132_pool.n_threads;
+        os_mutex_unlock(&g_g132_pool.mutex);
+
+        const uint64_t rows_per_thread =
+            (n_rows + n_threads - 1) / n_threads;
+        const uint64_t row0 = (uint64_t)tid * rows_per_thread;
+        uint64_t row1 = row0 + rows_per_thread;
+        if (row1 > n_rows) row1 = n_rows;
+        if (row0 < row1) fn(ctx, row0, row1);
+
+        os_mutex_lock(&g_g132_pool.mutex);
+        g_g132_pool.done++;
+        if (g_g132_pool.done == g_g132_pool.n_workers) {
+            os_cond_signal(&g_g132_pool.done_cond);
+        }
+        os_mutex_unlock(&g_g132_pool.mutex);
+    }
+}
+
+void ds4_g132_lane_parallel_shutdown(void) {
+    if (!g_g132_pool.initialized) return;
+    os_mutex_lock(&g_g132_pool.mutex);
+    g_g132_pool.shutdown = true;
+    g_g132_pool.generation++;
+    os_cond_broadcast(&g_g132_pool.work_cond);
+    os_mutex_unlock(&g_g132_pool.mutex);
+    for (uint32_t i = 0; i < g_g132_threads_started; i++) {
+        os_thread_join(g_g132_pool.threads[i + 1u]);
+    }
+    if (g_g132_done_cond_ready) os_cond_destroy(&g_g132_pool.done_cond);
+    if (g_g132_work_cond_ready) os_cond_destroy(&g_g132_pool.work_cond);
+    if (g_g132_mutex_ready) os_mutex_destroy(&g_g132_pool.mutex);
+    memset(&g_g132_pool, 0, sizeof(g_g132_pool));
+    g_g132_threads_started = 0;
+    g_g132_mutex_ready = false;
+    g_g132_work_cond_ready = false;
+    g_g132_done_cond_ready = false;
+}
+
+int ds4_g132_lane_parallel_init(void) {
+    if (g_g132_pool.initialized) return 1;
+    ds4_threads_init();
+    if (os_mutex_init(&g_g132_pool.mutex) != 0) return 0;
+    g_g132_mutex_ready = true;
+    if (os_cond_init(&g_g132_pool.work_cond) != 0) goto fail;
+    g_g132_work_cond_ready = true;
+    if (os_cond_init(&g_g132_pool.done_cond) != 0) goto fail;
+    g_g132_done_cond_ready = true;
+    g_g132_pool.n_threads = g_pool.n_threads;
+    g_g132_pool.n_workers =
+        g_g132_pool.n_threads > 0 ? g_g132_pool.n_threads - 1u : 0u;
+    g_g132_pool.initialized = true;
+    for (uint32_t i = 1; i < g_g132_pool.n_threads; i++) {
+        if (os_thread_create(&g_g132_pool.threads[i],
+                             ds4_g132_worker_main,
+                             (void *)(uintptr_t)i) != 0) {
+            g_g132_pool.n_workers = g_g132_threads_started;
+            goto fail;
+        }
+        g_g132_threads_started++;
+    }
+    return 1;
+fail:
+    if (g_g132_pool.initialized) {
+        ds4_g132_lane_parallel_shutdown();
+    } else {
+        if (g_g132_done_cond_ready) os_cond_destroy(&g_g132_pool.done_cond);
+        if (g_g132_work_cond_ready) os_cond_destroy(&g_g132_pool.work_cond);
+        if (g_g132_mutex_ready) os_mutex_destroy(&g_g132_pool.mutex);
+        memset(&g_g132_pool, 0, sizeof(g_g132_pool));
+        g_g132_mutex_ready = false;
+        g_g132_work_cond_ready = false;
+        g_g132_done_cond_ready = false;
+    }
+    return 0;
+}
+
+static int ds4_g132_parallel_for(
+        uint64_t n_rows, ds4_parallel_fn fn, void *ctx) {
+    if (!g_g132_pool.initialized || !fn || n_rows == 0) return 0;
+    os_mutex_lock(&g_g132_pool.mutex);
+    g_g132_pool.fn = fn;
+    g_g132_pool.ctx = ctx;
+    g_g132_pool.n_rows = n_rows;
+    g_g132_pool.done = 0;
+    g_g132_pool.generation++;
+    os_cond_broadcast(&g_g132_pool.work_cond);
+    const uint64_t rows_per_thread =
+        (n_rows + g_g132_pool.n_threads - 1) / g_g132_pool.n_threads;
+    const uint64_t row1 = rows_per_thread < n_rows
+        ? rows_per_thread : n_rows;
+    os_mutex_unlock(&g_g132_pool.mutex);
+    if (row1 > 0) fn(ctx, 0, row1);
+    os_mutex_lock(&g_g132_pool.mutex);
+    while (g_g132_pool.done < g_g132_pool.n_workers) {
+        os_cond_wait(&g_g132_pool.done_cond, &g_g132_pool.mutex);
+    }
+    os_mutex_unlock(&g_g132_pool.mutex);
+    return 1;
+}
