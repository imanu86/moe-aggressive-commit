+int ds4_g132_quantize_row_q8_K(
+        const float *x, void *xq, uint64_t count) {
+    if (!x || !xq || count == 0 || count % QK_K != 0 ||
+        count > INT64_MAX) {
+        return 0;
+    }
+    ds4_quantize_row_q8_K(x, (block_q8_K *)xq, (int64_t)count);
+    return 1;
+}
+
+int ds4_g132_matvec_q2_k_expert(
+        float       *out,
+        const void  *base,
+        const float *x,
+        uint64_t     in_dim,
+        uint64_t     out_dim,
+        uint64_t     row_bytes) {
+    if (!out || !base || !x || in_dim == 0 || in_dim % QK_K != 0 ||
+        out_dim == 0 || in_dim > INT64_MAX) {
+        return 0;
+    }
+    block_q8_K *xq =
+        malloc((size_t)(in_dim / QK_K) * sizeof(xq[0]));
+    if (!xq) return 0;
+    ds4_quantize_row_q8_K(x, xq, (int64_t)in_dim);
+    matvec_q2_k_ctx ctx = {
+        .out = out,
+        .base = base,
+        .xq = xq,
+        .in_dim = in_dim,
+        .row_bytes = row_bytes,
+    };
+    const int ok = ds4_g132_parallel_for(
+        out_dim, matvec_q2_k_worker, &ctx);
+    free(xq);
+    return ok;
+}
