@@ -4660,6 +4777,34 @@ static void matvec_iq2_xxs_expert_pair_prequant(
     ds4_parallel_for(out_dim0, matvec_iq2_xxs_pair_worker, &ctx);
 }
 
+int ds4_g132_matvec_iq2_xxs_expert_pair_prequant(
+        float       *out0,
+        float       *out1,
+        const void  *base0,
+        const void  *base1,
+        const void  *xq,
+        uint64_t     in_dim,
+        uint64_t     out_dim,
+        uint64_t     row_bytes0,
+        uint64_t     row_bytes1) {
+    if (!out0 || !out1 || !base0 || !base1 || !xq ||
+        in_dim == 0 || in_dim % QK_K != 0 || out_dim == 0) {
+        return 0;
+    }
+    matvec_iq2_xxs_pair_ctx ctx = {
+        .out0 = out0,
+        .out1 = out1,
+        .base0 = base0,
+        .base1 = base1,
+        .xq = xq,
+        .in_dim = in_dim,
+        .row_bytes0 = row_bytes0,
+        .row_bytes1 = row_bytes1,
+    };
+    return ds4_g132_parallel_for(
+        out_dim, matvec_iq2_xxs_pair_worker, &ctx);
+}
