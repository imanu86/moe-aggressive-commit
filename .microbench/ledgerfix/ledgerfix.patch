+/* =======================================================================
+ * LEDGERFIX (29/7) - commit DIFFERITO per il percorso DOV (drain overlap 4).
+ *
+ * Sotto DS4_CUDA_DRAIN_OVERLAP4=1 l'arm sostituisce il drain bloccante e il
+ * worker non ha la prova di completamento al finish: il batch veniva
+ * INVALIDATO (I4 "versione minima" di drain4) e i byte SPARIVANO dal
+ * registro — misurato il 29/7 su lavoro bit-identico: h2d_bytes_total
+ * 8,4 GB sotto DOV contro 3070,6 GB del controllo, a parita' di transienti
+ * (432.968) e di volume letto.  I byte si muovono comunque; la prova di
+ * completamento ESISTE, solo piu' tardi, negli stessi punti che gia' oggi
+ * chiudono la finestra di overlap: cudaStreamQuery(upload)==Success nel
+ * poll idle del worker, oppure il claim-gate della generazione successiva
+ * (done-event dietro il waitEvent del consumer, invariante I3).  Quindi:
+ *
+ *   defer          = al posto del finish, il batch passa (per copia) a uno
+ *                    slot pendente del chiamante; la finestra h2d_active
+ *                    resta APERTA (le copie sono davvero in volo).
+ *   finish_deferred = stesso corpo del finish (chiusura finestra + commit
+ *                    per-pair prima-volta/ripetizione) MA sotto guardia di
+ *                    epoca nella STESSA presa di lock: niente TOCTOU col
+ *                    clear() del thread di decode.  drain_ok=0 (errore
+ *                    osservato sull'upload stream) = semantica del batch
+ *                    errato del percorso classico: finestra chiusa, byte
+ *                    omessi, complete=0.
+ *
+ * Il contratto del registro ("H2D bytes are committed only after the stream
+ * carrying the expert payload drained successfully") resta LETTERALE: cambia
+ * solo il momento in cui la prova arriva.  Il tempo attivo del tubo e' per
+ * OSSERVAZIONE (il retire e' quando il worker VEDE il completamento, non
+ * quando avviene): limite superiore onesto, nessuna sync aggiunta.  Limiti
+ * dichiarati (riga una-tantum [transport] drain_overlap4=deferred): il
+ * batch di CODA di una richiesta puo' essere ritirato dopo il report final
+ * (sottoconteggio <= 1 batch ~ 6 esperti) o dopo il clear successivo
+ * (scartato dalla guardia di epoca, mai contato altrove).
+ * ======================================================================= */
+static void ds4_transport_h2d_batch_finish_deferred(
+        ds4_transport_h2d_batch *batch, uint64_t epoch, int drain_ok) {
+    if (!batch || !batch->active) return;
+    const double now = cuda_wall_sec();
+    ds4_transport_lock();
+    if (g_transport_ledger.epoch != epoch) {
+        /* Il registro e' stato azzerato fra l'arm e la prova: il batch
+         * appartiene a un report gia' emesso (che ha sottocontato questo
+         * solo batch).  Scartare senza toccare il registro nuovo: il clear
+         * ha gia' azzerato finestra e contatori. */
+        ds4_transport_unlock();
+        *batch = ds4_transport_h2d_batch{};
+        return;
+    }
+    if (g_transport_ledger.h2d_active_batches == 0u) {
+        g_transport_ledger.complete = 0;
+    } else if (--g_transport_ledger.h2d_active_batches == 0u) {
+        const double elapsed = now - g_transport_ledger.h2d_active_started;
+        if (elapsed >= 0.0) {
+            g_transport_ledger.h2d_active_seconds += elapsed;
+        } else {
+            g_transport_ledger.complete = 0;
+        }
+        g_transport_ledger.h2d_active_started = 0.0;
+    }
+    if (!drain_ok || !batch->complete) {
+        /* CUDA does not reveal which subset of an errored async batch crossed
+         * PCIe.  Keep all byte totals exact by omitting it and expose the gap. */
+        g_transport_ledger.complete = 0;
+    } else {
+        for (uint32_t i = 0; i < batch->count; i++) {
+            const ds4_transport_h2d_batch_entry &entry = batch->entries[i];
+            uint32_t index = 0;
+            if (!ds4_transport_pair_index(
+                    entry.layer, entry.expert, &index)) {
+                g_transport_ledger.complete = 0;
+                continue;
+            }
+            ds4_transport_pair_counters &pair =
+                g_transport_ledger.pair[index];
+            const int repeat = pair.h2d_transfers != 0u;
+            if (pair.h2d_transfers == UINT32_MAX) {
+                g_transport_ledger.complete = 0;
+            } else {
+                pair.h2d_transfers++;
+            }
+            uint64_t *classification = repeat
+                ? &g_transport_ledger.repeat_h2d_bytes
+                : &g_transport_ledger.first_touch_bytes;
+            if (!ds4_transport_add_u64(classification, entry.bytes) ||
+                !ds4_transport_add_u64(
+                    &g_transport_ledger.h2d_bytes_total, entry.bytes)) {
+                g_transport_ledger.complete = 0;
+            }
+        }
+    }
+    ds4_transport_unlock();
+    *batch = ds4_transport_h2d_batch{};
+}
+
+static int ds4_transport_h2d_batch_defer(
+        ds4_transport_h2d_batch *batch,
+        ds4_transport_h2d_batch *pending,
+        uint64_t *pending_epoch) {
+    if (!batch || !pending || !pending_epoch) return 0;
+    if (!batch->active) {
+        /* Registro spento o generazione senza H2D (all-hit/zero-copy):
+         * niente da differire, stesso no-op del finish. */
+        *batch = ds4_transport_h2d_batch{};
+        return 0;
+    }
+    if (pending->active) {
+        /* Impossibile per costruzione (al piu' UN overlap outstanding e il
+         * retire-at-claim precede il servizio successivo).  Fail-safe: si
+         * chiude il pendente stantio come batch errato (finestra chiusa,
+         * byte omessi, gap dichiarato via complete=0). */
+        ds4_transport_h2d_batch_finish_deferred(pending, *pending_epoch, 0);
+    }
+    ds4_transport_lock();
+    *pending_epoch = g_transport_ledger.epoch;
+    ds4_transport_unlock();
+    *pending = *batch;
+    *batch = ds4_transport_h2d_batch{};
+    return 1;
+}
