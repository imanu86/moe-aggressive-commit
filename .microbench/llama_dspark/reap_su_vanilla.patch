 }
 
+static ggml_moe_ids_observer_t g_moe_ids_observer = NULL;
+
+void ggml_cpu_set_moe_ids_observer(ggml_moe_ids_observer_t obs) {
+    g_moe_ids_observer = obs;
+}
+
 static void ggml_compute_forward_mul_mat_id(
         const struct ggml_compute_params * params,
               struct ggml_tensor * dst) {
@@ -1634,6 +1640,13 @@ static void ggml_compute_forward_mul_mat_id(
                 matrix_row_counts[i02] += 1;
             }
         }
+
+        // reap-loop: gli id sono gia' qui, in memoria host, letti da questo
+        // stesso thread. Osservarli non costa ne' trasferimenti ne' barriere.
+        if (g_moe_ids_observer) {
+            g_moe_ids_observer(ids->name, (const int32_t *) ids->data,
+                               n_ids, ids->ne[1], ids->nb[0], ids->nb[1]);
+        }
     }
 
