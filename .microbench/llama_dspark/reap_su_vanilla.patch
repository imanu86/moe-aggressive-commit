@@ -138,6 +138,22 @@ extern "C" {
 
     GGML_BACKEND_API void ggml_backend_cpu_set_use_ref(ggml_backend_t backend_cpu, bool use_ref);
 
+
+    // MoE expert-selection observer.
+    //
+    // Called once per mul_mat_id node, from the single thread that already walks
+    // the ids buffer to group rows (ggml-cpu.c, `if (ith == 0)`). The ids live in
+    // host memory there because the CPU op needs them: reading them costs nothing
+    // and forces no device synchronisation.
+    //
+    // Reading the same ids through the eval callback instead costs a synchronous
+    // device->host read per layer (43 per token) and splits the graph: measured
+    // 2026-08-02, prefill 1,12 -> 0,92 t/s.
+    typedef void (*ggml_moe_ids_observer_t)(
+            const char * name, const int32_t * ids,
+            int64_t n_used, int64_t n_tokens, size_t nb0, size_t nb1);
+    GGML_BACKEND_API void ggml_cpu_set_moe_ids_observer(ggml_moe_ids_observer_t obs);
+
     GGML_BACKEND_API ggml_backend_reg_t ggml_backend_cpu_reg(void);
 
     GGML_BACKEND_API void ggml_cpu_fp32_to_fp32(const float *,       float *, int64_t);
