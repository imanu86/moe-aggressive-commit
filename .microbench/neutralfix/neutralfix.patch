+     * verificabile e in ogni caso impedisce di azzerare lo stato di
+     * un'incarnazione altrui. */
+    const uint32_t incarnation = g_shared1_dedicated_gen;
     os_mutex_unlock(&p->mutex);
     for (uint32_t i = 0; i < started; i++) os_thread_join(p->threads[i]);
