+/* Budget di polling attivo del route worker dopo ogni job durante un token.
+ * Zero conserva il percorso storico: yield immediato a ogni poll vuoto. */
+static uint32_t cuda_worker_pickup_spin_us(void) {
+    static int resolved = 0;
+    static uint32_t cached = 0u;
+    if (resolved) return cached;
+    resolved = 1;
+    const char *env = getenv("DS4_CUDA_WORKER_PICKUP_SPIN_US");
+    if (!env || !env[0] || strcmp(env, "0") == 0) return cached;
+    char *end = NULL;
+    errno = 0;
+    const unsigned long value = strtoul(env, &end, 10);
+    if (errno == 0 && end != env && end && *end == '\0' &&
+        value <= 1000000ul) {
+        cached = (uint32_t)value;
+    } else {
+        fprintf(stderr,
+                "ds4: invalid DS4_CUDA_WORKER_PICKUP_SPIN_US=%s "
+                "(expected 0..1000000); using 0\n",
+                env);
+    }
+    return cached;
+}
+
+static inline void ds4_worker_pickup_pause(void) {
+#ifdef _WIN32
+    YieldProcessor();
+#elif defined(__i386__) || defined(__x86_64__)
+    __builtin_ia32_pause();
+#else
+    std::atomic_signal_fence(std::memory_order_seq_cst);
+#endif
+}
