+     * non ancora al publish_completed). Sul tree corrente la finestra
+     * begin->finish non contiene stream_alloc (verificato: i range_ptr
+     * "moe_*" stanno sui rami fallback, mutuamente esclusivi con la route),
+     * quindi questo ramo non dovrebbe MAI scattare: e' una cintura contro
+     * derive future del tree. Costo: due load acquire per shed tentato. */
+    if (g_moe_expert_cache.route_thread_started &&
+        g_moe_expert_cache.route_submitted_sequence.load(
+            std::memory_order_acquire) !=
+        g_moe_expert_cache.route_completed_sequence.load(
+            std::memory_order_acquire)) {
+        g_vram_pin_shed_deferrals++;
+        if (g_vram_pin_shed_deferrals <= 8ull ||
+            (g_vram_pin_shed_deferrals % 256ull) == 0ull) {
+            fprintf(stderr,
+                    "ds4: [vram-prio] PIN degrade result=deferred "
+                    "category=resident-expert-slab requester=%s "
+                    "reason=route-job-in-flight action=backbone-failopen\n",
+                    requester ? requester : "weights");
+        }
+        return 0;
+    }
+
+    const uint32_t slots = g_moe_expert_cache.capacity;
+    const uint32_t resident = g_moe_expert_cache.count;
+    const uint64_t slot_bytes =
+        g_moe_expert_cache.gate_expert_bytes * 2ull +
+        g_moe_expert_cache.down_expert_bytes;
+    const uint64_t bytes = slot_bytes * (uint64_t)slots;
