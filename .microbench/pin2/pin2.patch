+            "ds4: [vram-prio] PIN degrade result=ok "
+            "category=resident-expert-slab requester=%s "
+            "slots=%u resident=%u bytes=%llu rebuild_target_slots=%u "
+            "action=exact-streaming-until-rebuild\n",
