+/* PINBUDGETFIX: tetto opzionale sulla SOMMA host-pinned CUDA del processo
+ * (tutti i kind, ledger dei wrapper).  0 = nessun tetto (default, invariato). */
+static uint64_t cuda_host_pin_total_budget_bytes(void) {
+    static int cached_read = 0;
+    static uint64_t cached = 0;
+    if (!cached_read) {
+        const char *env = getenv("DS4_CUDA_HOST_PIN_TOTAL_BUDGET_GB");
+        uint64_t v = 0;
+        if (env && env[0]) {
+            const double gv = atof(env);
+            if (gv > 0.0) v = (uint64_t)(gv * 1073741824.0);
+        }
+        cached = v;
+        cached_read = 1;
+    }
+    return cached;
+}
+
+/* PINBUDGETFIX: UNA riga per kind a ogni allocazione host-pinned dichiarata
+ * (window/range/kv_arena/model_stage/route_stage).  indexer_zc e' escluso dal
+ * log per-alloc (42 allocazioni; il suo consumo e' gia' dichiarato dalle righe
+ * [indexer-zc] active/pin_failed), "other" e' escluso per non inondare il log
+ * con i piccoli buffer di controllo: entrambi restano nel totale.  masked_mib
+ * e' l'accumulatore del budget DS4_CUDA_STREAM_FROM_RAM_MASKED_BUDGET_GB
+ * (window+range+indexer_zc) fotografato PRIMA che il sito lo aggiorni. */
+static void ds4_hostpin_log_alloc(int kind, uint64_t bytes,
+                                  uint64_t kind_live, uint64_t total_live,
+                                  uint64_t total_peak) {
+    if (kind == DS4_HOSTPIN_KIND_OTHER || kind == DS4_HOSTPIN_KIND_INDEXER_ZC) {
+        return;
+    }
+    const uint64_t total_budget = cuda_host_pin_total_budget_bytes();
+    fprintf(stderr,
+            "ds4: [host-pin] kind=%s bytes=%llu kind_live_mib=%.1f "
+            "total_live_mib=%.1f total_peak_mib=%.1f masked_mib=%.1f "
+            "masked_budget_mib=%.1f total_budget_mib=%.1f\n",
+            g_hostpin_kind_name[kind], (unsigned long long)bytes,
+            (double)kind_live / 1048576.0,
+            (double)total_live / 1048576.0,
+            (double)total_peak / 1048576.0,
+            (double)g_model_registered_range_bytes / 1048576.0,
+            (double)cuda_host_register_budget_bytes() / 1048576.0,
+            total_budget ? (double)total_budget / 1048576.0 : 0.0);
+}
