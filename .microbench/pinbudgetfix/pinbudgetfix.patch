+/* ==================== PINBUDGETFIX: ledger host-pin SEMPRE ATTIVO ==========
+ * Audit10 01-B1/06-ZC1/07-B1/09-#1: il tetto "da 2 GiB" contava solo
+ * register-mmap per-range + indexerzc; finestra masked, arena KV staged,
+ * staging modello e staging route restavano invisibili (~4,5 GiB pinnati
+ * reali con contatore a 2 GiB).  Questo ledger vive nei wrapper del tracer
+ * (che intercettano OGNI cudaMallocHost/cudaHostAlloc/cudaHostRegister/
+ * cudaFreeHost/cudaHostUnregister del TU), quindi il totale dichiarato
+ * coincide col pinnato CUDA reale per costruzione, anche per i kind non
+ * enumerati ("other").  E' indipendente da DS4_CUDA_ALLOC_TRACE e gira SOLO
+ * alle allocazioni/free (percorsi freddi): i percorsi caldi per-token non
+ * passano di qui.
+ * Budget: il kind masked (window+range+indexer_zc) resta gestito da
+ * g_model_registered_range_bytes contro DS4_CUDA_STREAM_FROM_RAM_MASKED_
+ * BUDGET_GB (ora onesto: la finestra lo consuma).  kv_arena/model_stage/
+ * route_stage sono costi funzionali determinati dalla config (ctx, chunk,
+ * route count): non vengono ammessi contro il budget masked (gate-arli li'
+ * spegnerebbe KV-staged e lo streaming pesi alla config di campagna); sono
+ * dichiarati per-kind nel log e sommati nel totale.  Il tetto opzionale
+ * sulla SOMMA e' DS4_CUDA_HOST_PIN_TOTAL_BUDGET_GB (default: nessun tetto,
+ * comportamento invariato). */
+enum {
+    DS4_HOSTPIN_KIND_OTHER = 0,
+    DS4_HOSTPIN_KIND_WINDOW,      /* finestra masked contigua (cudaHostRegister) */
+    DS4_HOSTPIN_KIND_RANGE,       /* register-mmap per-range (cudaHostRegister) */
+    DS4_HOSTPIN_KIND_INDEXER_ZC,  /* buffer indexer zero-copy (cudaHostAlloc) */
+    DS4_HOSTPIN_KIND_KV_ARENA,    /* arena KV staged (cudaHostAlloc) */
+    DS4_HOSTPIN_KIND_MODEL_STAGE, /* 4 buffer staging modello (cudaMallocHost) */
+    DS4_HOSTPIN_KIND_ROUTE_STAGE, /* staging host route worker (cudaHostAlloc) */
+    DS4_HOSTPIN_KIND_COUNT
+};
+static const char *const g_hostpin_kind_name[DS4_HOSTPIN_KIND_COUNT] = {
+    "other", "window", "range", "indexer_zc", "kv_arena", "model_stage",
+    "route_stage"
+};
+struct ds4_hostpin_rec {
+    uint64_t bytes;
+    int kind;
+};
+static std::mutex g_hostpin_mutex;
+static std::unordered_map<const void *, ds4_hostpin_rec> g_hostpin_map;
+static uint64_t g_hostpin_kind_live[DS4_HOSTPIN_KIND_COUNT];
+static uint64_t g_hostpin_total_live = 0;
+static uint64_t g_hostpin_total_peak = 0;
+static int g_hostpin_pending_kind = DS4_HOSTPIN_KIND_OTHER;
+static uint64_t g_hostpin_admit_refusals = 0;
+
+/* Definite dopo cuda_host_register_budget_bytes/g_model_registered_range_bytes
+ * (servono per la riga di log e per il tetto opzionale sulla somma). */
+static void ds4_hostpin_log_alloc(int kind, uint64_t bytes,
+                                  uint64_t kind_live, uint64_t total_live,
+                                  uint64_t total_peak);
+static uint64_t cuda_host_pin_total_budget_bytes(void);
+
+/* Tag del kind per la PROSSIMA allocazione host-pinned (stesso pattern di
+ * ds4_gpu_alloc_site_label): chiamare immediatamente prima della cuda call. */
+static void ds4_hostpin_tag(int kind) {
+    std::lock_guard<std::mutex> lock(g_hostpin_mutex);
+    g_hostpin_pending_kind = kind;
+}
+
+static uint64_t ds4_hostpin_total_bytes_now(void) {
+    std::lock_guard<std::mutex> lock(g_hostpin_mutex);
+    return g_hostpin_total_live;
+}
+
+/* Tetto opzionale sulla SOMMA host-pinned CUDA del processo: rifiuta PRIMA di
+ * chiamare il driver.  Ogni chiamante ha gia' un percorso di failure gestito
+ * (fail-open indexer, sticky-off KV, prepare fallita cache, window skipped). */
+static int ds4_hostpin_admit(uint64_t bytes, const char *fn, int line) {
+    const uint64_t cap = cuda_host_pin_total_budget_bytes();
+    if (cap == 0) return 1;
+    uint64_t total = 0;
+    int refuse = 0;
+    {
+        std::lock_guard<std::mutex> lock(g_hostpin_mutex);
+        total = g_hostpin_total_live;
+        if (bytes > cap || total + bytes > cap) {
+            refuse = 1;
+            g_hostpin_pending_kind = DS4_HOSTPIN_KIND_OTHER;
+            g_hostpin_admit_refusals++;
+        }
+    }
+    if (refuse && g_hostpin_admit_refusals <= 8ull) {
+        fprintf(stderr,
+                "ds4: [host-pin] refused site=%s@%d bytes=%llu "
+                "total_live_mib=%.1f total_budget_mib=%.1f (somma host-pin "
+                "oltre DS4_CUDA_HOST_PIN_TOTAL_BUDGET_GB)\n",
+                fn ? fn : "?", line, (unsigned long long)bytes,
+                (double)total / 1048576.0, (double)cap / 1048576.0);
+    }
+    return refuse ? 0 : 1;
+}
+
+static void ds4_hostpin_note_alloc(const void *ptr, uint64_t bytes) {
+    if (!ptr) return;
+    int kind = DS4_HOSTPIN_KIND_OTHER;
+    uint64_t kind_live = 0;
+    uint64_t total_live = 0;
+    uint64_t total_peak = 0;
+    {
+        std::lock_guard<std::mutex> lock(g_hostpin_mutex);
+        kind = g_hostpin_pending_kind;
+        g_hostpin_pending_kind = DS4_HOSTPIN_KIND_OTHER;
+        ds4_hostpin_rec rec;
+        rec.bytes = bytes;
+        rec.kind = kind;
+        g_hostpin_map[ptr] = rec;
+        g_hostpin_kind_live[kind] += bytes;
+        g_hostpin_total_live += bytes;
+        if (g_hostpin_total_live > g_hostpin_total_peak) {
+            g_hostpin_total_peak = g_hostpin_total_live;
+        }
+        kind_live = g_hostpin_kind_live[kind];
+        total_live = g_hostpin_total_live;
+        total_peak = g_hostpin_total_peak;
+    }
+    ds4_hostpin_log_alloc(kind, bytes, kind_live, total_live, total_peak);
+}
+
+static void ds4_hostpin_note_alloc_failed(void) {
+    std::lock_guard<std::mutex> lock(g_hostpin_mutex);
+    g_hostpin_pending_kind = DS4_HOSTPIN_KIND_OTHER;
+}
+
+static void ds4_hostpin_note_free(const void *ptr) {
+    if (!ptr) return;
+    std::lock_guard<std::mutex> lock(g_hostpin_mutex);
+    std::unordered_map<const void *, ds4_hostpin_rec>::iterator it =
+        g_hostpin_map.find(ptr);
+    if (it == g_hostpin_map.end()) return;
+    const uint64_t bytes = it->second.bytes;
+    const int kind = it->second.kind;
+    g_hostpin_kind_live[kind] =
+        g_hostpin_kind_live[kind] >= bytes ? g_hostpin_kind_live[kind] - bytes
+                                           : 0;
+    g_hostpin_total_live =
+        g_hostpin_total_live >= bytes ? g_hostpin_total_live - bytes : 0;
+    g_hostpin_map.erase(it);
+}
