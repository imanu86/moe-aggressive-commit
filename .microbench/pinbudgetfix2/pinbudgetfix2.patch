+            (double)live[DS4_HOSTPIN_KIND_WINDOW] / 1048576.0,
+            (double)live[DS4_HOSTPIN_KIND_RANGE] / 1048576.0,
+            (double)live[DS4_HOSTPIN_KIND_INDEXER_ZC] / 1048576.0,
+            (double)live[DS4_HOSTPIN_KIND_KV_ARENA] / 1048576.0,
+            (double)live[DS4_HOSTPIN_KIND_MODEL_STAGE] / 1048576.0,
+            (double)live[DS4_HOSTPIN_KIND_ROUTE_STAGE] / 1048576.0,
+            (double)live[DS4_HOSTPIN_KIND_DYNAMIC_ARENA] / 1048576.0,
+            (double)live[DS4_HOSTPIN_KIND_MTP_WINDOW] / 1048576.0,
+            (double)cuda_total / 1048576.0,
+            (double)os_locked / 1048576.0,
+            (double)os_locked / 1048576.0,
+            (double)combined / 1048576.0);
+}
 
