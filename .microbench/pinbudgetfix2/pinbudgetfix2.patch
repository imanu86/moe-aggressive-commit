+static void ds4_hostpin_summary(const char *phase) {
+    uint64_t live[DS4_HOSTPIN_KIND_COUNT] = {};
+    uint64_t cuda_total = 0;
+    {
+        std::lock_guard<std::mutex> lock(g_hostpin_mutex);
+        for (int kind = 0; kind < DS4_HOSTPIN_KIND_COUNT; kind++) {
+            live[kind] = g_hostpin_kind_live[kind];
+        }
+        cuda_total = g_hostpin_total_live;
+    }
+    const uint64_t os_locked = ds4_nextn_os_locked_bytes();
+    const uint64_t combined =
+        cuda_total > UINT64_MAX - os_locked ? UINT64_MAX
+                                             : cuda_total + os_locked;
+    fprintf(stderr,
+            "ds4: [host-pin-summary] phase=%s other_mib=%.1f "
+            "window_mib=%.1f range_mib=%.1f indexer_zc_mib=%.1f "
+            "kv_arena_mib=%.1f model_stage_mib=%.1f route_stage_mib=%.1f "
+            "dynamic_arena_mib=%.1f mtp_window_mib=%.1f "
+            "cuda_pinned_total_mib=%.1f "
+            "nextn_os_lock_mib=%.1f os_locked_total_mib=%.1f "
+            "combined_mib=%.1f\n",
