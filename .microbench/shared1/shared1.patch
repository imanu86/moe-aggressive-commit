+/* =========================================================================
+ * shared1 - shared expert su CPU (DS4_CPU_SHARED_EXPERT=1).
+ * =========================================================================
+ *
+ * Traccia 6 della fattibilita' (.microbench/pilot/ANALISI_FABLE.md): lo
+ * shared expert e' deterministico (nessun router), pesa 26.738.688 B/layer
+ * in Q8_0 e alla GPU costa ~0,09 ms/layer di calcolo: il suo valore in VRAM
+ * e' residenza, non velocita'.  Qui il forward gate/up/SwiGLU/down gira su
+ * CPU dal mmap del modello - stessa matematica di layer_shared_ffn_one -
+ * in concorrenza con la fase routed dello stesso layer:
+ *
+ *   ffn_norm (GPU) --D2H 16 KiB ordinato su stream 0--> worker CPU
+ *   worker: quantizza Q8_0, pair gate/up, SwiGLU, down (row-parallel sul
+ *           pool g132 se libero, altrimenti single-thread)
+ *   join (main thread, punto di somma non fuso): attende il worker SOLO
+ *           li', H2D asincrono 16 KiB in g->shared_out, poi il kernel
+ *           esistente ds4_gpu_hc_expand_add_split_tensor fa la somma.
+ *
+ * Fallimento di QUALUNQUE passo => ricalcolo GPU dello shared come oggi,
+ * mai silenzioso (contatore + log).  La residenza VRAM dei range shexp e'
+ * gestita in tre punti: esclusione dal pre-cache di avvio
+ * (accelerator_cache_model_tensor_spans), blocco delle cache dequant
+ * f16/f32 (registro CPU-owned lato CUDA) e rilascio per-range dei residui
+ * dopo ogni uso GPU batch - prefill/verify/fallback - via
+ * ds4_gpu_model_span_release al primo layer del token successivo.
+ * Il D2H dell'input riusa il ring pinnato del probe SPEX (stesso ponte da
+ * 16 KiB della lane); l'H2D del parziale e' il gemello in scrittura
+ * (ds4_gpu_tensor_write_async_ordered_slot).  Un solo job in volo per
+ * costruzione: schedule(il) e join(il) stanno nello stesso encode.
+ */
+
+enum {
+    DS4_SHARED1_SLOTS = 4,
+    DS4_SHARED1_HIST = 512,     /* bucket da 50 us -> quantili fino a 25,6 ms */
+};
+
+enum {
+    DS4_SHARED1_FREE = 0,
+    DS4_SHARED1_RESERVED = 1,
+    DS4_SHARED1_QUEUED = 2,
+    DS4_SHARED1_RUNNING = 3,
+    DS4_SHARED1_DONE_OK = 4,
+    DS4_SHARED1_DONE_FAIL = 5,
+};
+
+typedef struct {
+    uint64_t seq;
+    uint32_t layer;
+    uint8_t state;
+    double cpu_ms;
+} ds4_shared1_job;
+
+/* Il pool g132 ha un solo slot di submit e nessun lock per i submitter: se
+ * due grafi armassero shared1 nello stesso processo i due worker sarebbero
+ * due submitter.  Questo mutex di processo serializza le submit di shared1
+ * (la lane resta esclusa a monte: con i suoi env il pool non viene usato). */
+static os_once_t g_shared1_pool_once = OS_ONCE_INIT;
+static os_mutex_t g_shared1_pool_mutex;
+static int g_shared1_pool_mutex_ready;
+
+static void ds4_shared1_pool_mutex_init(void) {
+    g_shared1_pool_mutex_ready = os_mutex_init(&g_shared1_pool_mutex) == 0;
+}
+
+struct ds4_shared1 {
+    os_thread_t thread;
+    os_mutex_t mutex;
+    os_cond_t work_cond;
+    os_cond_t done_cond;
+    bool thread_started;
+    bool sync_ready;
+    bool shutdown;
+    bool use_pool;
+    bool verbose;
+
+    const ds4_model *model;
+    const ds4_tensor *gate_w[DS4_N_LAYER];
+    const ds4_tensor *up_w[DS4_N_LAYER];
+    const ds4_tensor *down_w[DS4_N_LAYER];
+
+    /* ponti pinnati da 16 KiB: D2H di ffn_norm e H2D del parziale */
+    ds4_gpu_async_read *read_ring;
+    ds4_gpu_async_read *write_ring;
+
+    /* scratch del worker (un solo job RUNNING per costruzione) */
+    float *gate;
+    float *up;
+    float *mid;
+    int8_t *xq_in;
+    float *xscale_in;
+    int8_t *xq_mid;
+    float *xscale_mid;
+
+    uint64_t seq;               /* token corrente: il==0 lo avanza */
+    int vram_dirty;             /* un percorso GPU ha ritoccato range shexp */
+
+    ds4_shared1_job job[DS4_SHARED1_SLOTS];
+
+    /* telemetria [shared-cpu] */
+    uint64_t scheduled;
+    uint64_t dropped;           /* nessuno slot libero allo schedule */
+    uint64_t sched_failures;    /* D2H non accodabile */
+    uint64_t completed;
+    uint64_t joins;
+    uint64_t fallbacks;
+    uint64_t stale_reclaimed;
+    uint64_t vram_release_sweeps;
+    uint64_t vram_released_bytes;
+    uint64_t vram_release_blocked_bytes;
+    double d2h_wait_s;
+    double cpu_s;
+    double wait_s;
+    uint32_t hist_cpu[DS4_SHARED1_HIST];
+    uint32_t hist_wait[DS4_SHARED1_HIST];
+};
+
+static void ds4_shared1_hist_note(uint32_t *hist, double seconds) {
+    double bucket = seconds * 20000.0;      /* 50 us per bucket */
+    uint32_t idx = bucket <= 0.0 ? 0u : (uint32_t)bucket;
+    if (idx >= DS4_SHARED1_HIST) idx = DS4_SHARED1_HIST - 1u;
+    hist[idx]++;
+}
+
+/* Quantile in millisecondi dall'istogramma (0 se vuoto). */
+static double ds4_shared1_hist_quantile(const uint32_t *hist, double q) {
+    uint64_t total = 0;
+    for (uint32_t i = 0; i < DS4_SHARED1_HIST; i++) total += hist[i];
+    if (total == 0) return 0.0;
+    const uint64_t target = (uint64_t)(q * (double)(total - 1u));
+    uint64_t seen = 0;
+    for (uint32_t i = 0; i < DS4_SHARED1_HIST; i++) {
+        seen += hist[i];
+        if (seen > target) return ((double)i + 0.5) * 0.05;
+    }
+    return ((double)DS4_SHARED1_HIST - 0.5) * 0.05;
+}
+
+/* Forward CPU: identico nella matematica a layer_shared_ffn_one (pair Q8_0
+ * prequantizzato, SwiGLU senza clamp, down Q8_0 su mid riquantizzato), ma
+ * scritto sui worker row-parallel esistenti cosi' da girare sul pool g132
+ * (quello della lane, fermo in decode) invece che sul pool del backend CPU,
+ * che non sopporta submitter concorrenti. */
+static int ds4_shared1_eval(
+        ds4_shared1 *s,
+        uint32_t il,
+        const float *x,
+        float *out) {
+    const ds4_tensor *gate_w = s->gate_w[il];
+    const ds4_tensor *up_w = s->up_w[il];
+    const ds4_tensor *down_w = s->down_w[il];
+    const uint64_t in_dim = gate_w->dim[0];
+    const uint64_t hidden = gate_w->dim[1];
+
+    quantize_q8_0_activation(x, s->xq_in, s->xscale_in, in_dim);
+    matvec_q8_0_pair_ctx pctx = {
+        .out0 = s->gate,
+        .out1 = s->up,
+        .data0 = tensor_data(s->model, gate_w),
+        .data1 = tensor_data(s->model, up_w),
+        .xq = s->xq_in,
+        .xscale = s->xscale_in,
+        .in_dim = in_dim,
+        .blocks = (in_dim + 31) / 32,
+    };
+    matvec_q8_0_ctx dctx = {
+        .out = out,
+        .data = tensor_data(s->model, down_w),
+        .xq = s->xq_mid,
+        .xscale = s->xscale_mid,
+        .in_dim = hidden,
+        .row0 = 0,
+        .blocks = (hidden + 31) / 32,
+    };
+    const int pooled = s->use_pool && g_shared1_pool_mutex_ready;
+    if (pooled) {
+        os_mutex_lock(&g_shared1_pool_mutex);
+        if (!ds4_g132_parallel_for(hidden, matvec_q8_0_pair_worker, &pctx)) {
+            matvec_q8_0_pair_worker(&pctx, 0, hidden);
+        }
+        swiglu(s->mid, s->gate, s->up, hidden);
+        quantize_q8_0_activation(s->mid, s->xq_mid, s->xscale_mid, hidden);
+        if (!ds4_g132_parallel_for(down_w->dim[1], matvec_q8_0_worker, &dctx)) {
+            matvec_q8_0_worker(&dctx, 0, down_w->dim[1]);
+        }
+        os_mutex_unlock(&g_shared1_pool_mutex);
+    } else {
+        matvec_q8_0_pair_worker(&pctx, 0, hidden);
+        swiglu(s->mid, s->gate, s->up, hidden);
+        quantize_q8_0_activation(s->mid, s->xq_mid, s->xscale_mid, hidden);
+        matvec_q8_0_worker(&dctx, 0, down_w->dim[1]);
+    }
+    return 1;
+}
+
+static void *ds4_shared1_worker_main(void *arg) {
+    ds4_shared1 *s = (ds4_shared1 *)arg;
+    for (;;) {
+        uint32_t slot = DS4_SHARED1_SLOTS;
+        os_mutex_lock(&s->mutex);
+        for (;;) {
+            for (uint32_t i = 0; i < DS4_SHARED1_SLOTS; i++) {
+                if (s->job[i].state != DS4_SHARED1_QUEUED) continue;
+                if (s->job[i].seq != s->seq) {
+                    /* token passato: nessun join lo aspetta piu' */
+                    s->job[i].state = DS4_SHARED1_FREE;
+                    s->stale_reclaimed++;
+                    continue;
+                }
+                slot = i;
+                break;
+            }
+            if (slot != DS4_SHARED1_SLOTS || s->shutdown) break;
+            os_cond_wait(&s->work_cond, &s->mutex);
+        }
+        if (slot == DS4_SHARED1_SLOTS) {
+            os_mutex_unlock(&s->mutex);
+            return NULL;
+        }
+        ds4_shared1_job *job = &s->job[slot];
+        job->state = DS4_SHARED1_RUNNING;
+        const uint64_t seq = job->seq;
+        const uint32_t layer = job->layer;
+        os_mutex_unlock(&s->mutex);
+
+        const double d2h0 = now_sec();
+        const int read_ok = ds4_gpu_async_read_wait_slot(s->read_ring, slot);
+        const double cpu0 = now_sec();
+        int ok = read_ok;
+        if (ok) {
+            const float *hidden = (const float *)
+                ds4_gpu_async_read_host_slot(s->read_ring, slot);
+            float *partial = (float *)
+                ds4_gpu_async_read_host_slot(s->write_ring, slot);
+            ok = hidden && partial && layer < DS4_N_LAYER &&
+                 ds4_shared1_eval(s, layer, hidden, partial);
+        }
+        const double cpu1 = now_sec();
+
+        os_mutex_lock(&s->mutex);
+        s->d2h_wait_s += cpu0 - d2h0;
+        s->cpu_s += cpu1 - cpu0;
+        ds4_shared1_hist_note(s->hist_cpu, cpu1 - cpu0);
+        s->completed++;
+        if (job->state == DS4_SHARED1_RUNNING && job->seq == seq) {
+            job->cpu_ms = (cpu1 - cpu0) * 1000.0;
+            job->state = ok ? DS4_SHARED1_DONE_OK : DS4_SHARED1_DONE_FAIL;
+        } else {
+            job->state = DS4_SHARED1_FREE;
+        }
+        os_cond_broadcast(&s->done_cond);
+        os_mutex_unlock(&s->mutex);
+    }
+}
+
+static void ds4_shared1_summary(ds4_shared1 *s) {
+    fprintf(stderr,
+            "ds4: [shared-cpu] final scheduled=%llu completed=%llu joins=%llu "
+            "fallback_count=%llu dropped=%llu sched_failures=%llu stale=%llu "
+            "shared_cpu_ms{p50/p90}=%.3f/%.3f shared_wait_ms{p50/p90}=%.3f/%.3f "
+            "d2h_wait_total_ms=%.1f cpu_total_ms=%.1f wait_total_ms=%.1f "
+            "vram_freed_mb=%.1f vram_release_blocked_mb=%.1f vram_sweeps=%llu "
+            "startup_excluded_mb=%.1f pool=%s\n",
+            (unsigned long long)s->scheduled,
+            (unsigned long long)s->completed,
+            (unsigned long long)s->joins,
+            (unsigned long long)s->fallbacks,
+            (unsigned long long)s->dropped,
+            (unsigned long long)s->sched_failures,
+            (unsigned long long)s->stale_reclaimed,
+            ds4_shared1_hist_quantile(s->hist_cpu, 0.5),
+            ds4_shared1_hist_quantile(s->hist_cpu, 0.9),
+            ds4_shared1_hist_quantile(s->hist_wait, 0.5),
+            ds4_shared1_hist_quantile(s->hist_wait, 0.9),
+            1000.0 * s->d2h_wait_s,
+            1000.0 * s->cpu_s,
+            1000.0 * s->wait_s,
+            (double)s->vram_released_bytes / 1048576.0,
+            (double)s->vram_release_blocked_bytes / 1048576.0,
+            (unsigned long long)s->vram_release_sweeps,
+            (double)g_shared1_startup_excluded_bytes / 1048576.0,
+            s->use_pool ? "g132" : "single-thread");
+}
+
+static void ds4_shared1_destroy(ds4_shared1 *s) {
+    if (!s) return;
+    if (s->thread_started) {
+        os_mutex_lock(&s->mutex);
+        s->shutdown = true;
+        os_cond_broadcast(&s->work_cond);
+        os_mutex_unlock(&s->mutex);
+        os_thread_join(s->thread);
+        ds4_shared1_summary(s);
+    }
+    ds4_gpu_async_read_free(s->read_ring);
+    ds4_gpu_async_read_free(s->write_ring);
+    free(s->xscale_mid);
+    free(s->xq_mid);
+    free(s->xscale_in);
+    free(s->xq_in);
+    free(s->mid);
+    free(s->up);
+    free(s->gate);
+    if (s->sync_ready) {
+        os_cond_destroy(&s->done_cond);
+        os_cond_destroy(&s->work_cond);
+        os_mutex_destroy(&s->mutex);
+    }
+    free(s);
+}
+
+static ds4_shared1 *ds4_shared1_create(
+        const ds4_model *model,
+        const ds4_weights *weights) {
+    if (!ds4_shared1_env_requested()) return NULL;
+    if (!model || !weights) return NULL;
+
+    ds4_shared1 *s = calloc(1, sizeof(*s));
+    if (!s) return NULL;
+    s->model = model;
+    s->verbose = getenv("DS4_CPU_SHARED_EXPERT_VERBOSE") != NULL;
+
+    uint64_t in_dim = 0;
+    uint64_t hidden = 0;
+    for (uint32_t il = 0; il < DS4_N_LAYER; il++) {
+        const ds4_layer_weights *layer = &weights->layer[il];
+        const ds4_tensor *gate_w = layer->ffn_gate_shexp;
+        const ds4_tensor *up_w = layer->ffn_up_shexp;
+        const ds4_tensor *down_w = layer->ffn_down_shexp;
+        if (!gate_w || !up_w || !down_w ||
+            gate_w->type != 8 || up_w->type != 8 || down_w->type != 8 ||
+            gate_w->ndim != 2 || up_w->ndim != 2 || down_w->ndim != 2 ||
+            gate_w->dim[0] != up_w->dim[0] || gate_w->dim[1] != up_w->dim[1] ||
+            down_w->dim[0] != gate_w->dim[1] || down_w->dim[1] != gate_w->dim[0] ||
+            gate_w->dim[0] != DS4_N_EMBD || gate_w->dim[1] != DS4_N_FF_EXP) {
+            fprintf(stderr,
+                    "ds4: [shared-cpu] layer %u shared tensors are not the "
+                    "expected Q8_0 layout; DS4_CPU_SHARED_EXPERT disabled\n", il);
+            free(s);
+            return NULL;
+        }
+        if (il == 0) {
+            in_dim = gate_w->dim[0];
+            hidden = gate_w->dim[1];
+        }
+        s->gate_w[il] = gate_w;
+        s->up_w[il] = up_w;
+        s->down_w[il] = down_w;
+    }
+
+    if (os_mutex_init(&s->mutex) != 0) {
+        free(s);
+        return NULL;
+    }
+    if (os_cond_init(&s->work_cond) != 0) {
+        os_mutex_destroy(&s->mutex);
+        free(s);
+        return NULL;
+    }
+    if (os_cond_init(&s->done_cond) != 0) {
+        os_cond_destroy(&s->work_cond);
+        os_mutex_destroy(&s->mutex);
+        free(s);
+        return NULL;
+    }
+    s->sync_ready = true;
+    os_once(&g_shared1_pool_once, ds4_shared1_pool_mutex_init);
+
+    const uint64_t blocks_in = (in_dim + 31) / 32;
+    const uint64_t blocks_mid = (hidden + 31) / 32;
+    s->gate = xmalloc((size_t)hidden * sizeof(s->gate[0]));
+    s->up = xmalloc((size_t)hidden * sizeof(s->up[0]));
+    s->mid = xmalloc((size_t)hidden * sizeof(s->mid[0]));
+    s->xq_in = xmalloc((size_t)blocks_in * 32);
+    s->xscale_in = xmalloc((size_t)blocks_in * sizeof(s->xscale_in[0]));
+    s->xq_mid = xmalloc((size_t)blocks_mid * 32);
+    s->xscale_mid = xmalloc((size_t)blocks_mid * sizeof(s->xscale_mid[0]));
+    s->read_ring = ds4_gpu_async_read_ring_alloc(
+        (uint64_t)DS4_N_EMBD * sizeof(float), DS4_SHARED1_SLOTS);
+    s->write_ring = ds4_gpu_async_read_ring_alloc(
+        (uint64_t)DS4_N_EMBD * sizeof(float), DS4_SHARED1_SLOTS);
+    if (!s->read_ring || !s->write_ring) {
+        fprintf(stderr,
+                "ds4: [shared-cpu] pinned ring allocation failed; "
+                "DS4_CPU_SHARED_EXPERT disabled\n");
+        ds4_shared1_destroy(s);
+        return NULL;
+    }
+
+    /* Il pool g132 ha un solo slot di submit: se la lane CPU e' richiesta
+     * dall'ambiente glielo si lascia e qui si degrada a single-thread. */
+    if (getenv("DS4_G132_CPU_LANE") != NULL ||
+        getenv("DS4_G132_CPU_LANE_GENERAL") != NULL) {
+        s->use_pool = false;
+        fprintf(stderr,
+                "ds4: [shared-cpu] g132 pool ceded to the CPU lane env flags; "
+                "shared expert runs single-thread\n");
+    } else {
+        s->use_pool = g_shared1_pool_mutex_ready &&
+                      ds4_g132_lane_parallel_init() != 0;
+        if (!s->use_pool) {
+            fprintf(stderr,
+                    "ds4: [shared-cpu] g132 pool init failed; "
+                    "shared expert runs single-thread\n");
+        }
+    }
+
+    if (os_thread_create(&s->thread, ds4_shared1_worker_main, s) != 0) {
+        fprintf(stderr,
+                "ds4: [shared-cpu] worker thread creation failed; "
+                "DS4_CPU_SHARED_EXPERT disabled\n");
+        ds4_shared1_destroy(s);
+        return NULL;
+    }
+    s->thread_started = true;
+    fprintf(stderr,
+            "ds4: [shared-cpu] armed layers=%u q8_bytes_per_layer=%llu slots=%u "
+            "bridge=16KiB/16KiB pool=%s\n",
+            (unsigned)DS4_N_LAYER,
+            (unsigned long long)((blocks_in * 34) * hidden * 2u +
+                                 (blocks_mid * 34) * in_dim),
+            (unsigned)DS4_SHARED1_SLOTS,
+            s->use_pool ? "g132" : "single-thread");
+    return s;
+}
