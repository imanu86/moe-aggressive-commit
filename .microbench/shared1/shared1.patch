+/* Identita' dei tensori: vale solo per i layer base catturati alla create.
+ * Qualsiasi altro chiamante (blocco MTP, layout inattesi) resta sul percorso
+ * GPU odierno per costruzione. */
+static bool metal_graph_shared1_layer_owned(
+        const ds4_gpu_graph *g,
+        const ds4_layer_weights *layer,
+        uint32_t il) {
+    return g->shared1 && layer && il < DS4_N_LAYER &&
+           layer->ffn_gate_shexp == g->shared1->gate_w[il] &&
+           layer->ffn_up_shexp == g->shared1->up_w[il] &&
+           layer->ffn_down_shexp == g->shared1->down_w[il];
+}
+
+/* Spazzata di rilascio per-range dei byte shexp ancora in VRAM.  Chiamata
+ * dal solo thread di decode (stesso thread che muta g_model_ranges via
+ * cuda_model_range_ptr): nessuna nuova concorrenza sul registro dei range. */
+static void metal_graph_shared1_release_spans(ds4_shared1 *s) {
+    uint64_t released = 0;
+    uint64_t blocked = 0;
+    for (uint32_t il = 0; il < DS4_N_LAYER; il++) {
+        const ds4_tensor *w[3] = {s->gate_w[il], s->up_w[il], s->down_w[il]};
+        for (uint32_t i = 0; i < 3; i++) {
+            uint64_t rel = 0;
+            uint64_t blk = 0;
+            (void)ds4_gpu_model_span_release(s->model->map,
+                                             w[i]->abs_offset,
+                                             w[i]->bytes,
+                                             &rel, &blk);
+            released += rel;
+            blocked += blk;
+        }
+    }
+    s->vram_release_sweeps++;
+    s->vram_released_bytes += released;
+    s->vram_release_blocked_bytes += blocked;
+    if (released != 0 || blocked != 0) {
+        fprintf(stderr,
+                "ds4: [shared-cpu] vram sweep #%llu released=%.2f MiB "
+                "blocked=%.2f MiB\n",
+                (unsigned long long)s->vram_release_sweeps,
+                (double)released / 1048576.0,
+                (double)blocked / 1048576.0);
+    }
+}
+
+static void metal_graph_shared1_init(
+        ds4_gpu_graph *g,
+        const ds4_model *model,
+        const ds4_weights *weights) {
+    if (!g || g->shared1) return;
+    g->shared1 = ds4_shared1_create(model, weights);
+    if (!g->shared1) return;
+    /* Prima spazzata: nel regime a esclusione trova 0 byte (mai caricati);
+     * nei regimi window zero-copy o copia-intera trova 0 e blocked=0 - la'
+     * il beneficio di capacita' non esiste e il summary lo rende visibile. */
+    metal_graph_shared1_release_spans(g->shared1);
+}
+
+static void metal_graph_shared1_release(ds4_gpu_graph *g) {
+    if (!g || !g->shared1) return;
+    ds4_shared1_destroy(g->shared1);
+    g->shared1 = NULL;
+}
+
+/* Un percorso GPU (prefill/verify batch, o il fallback del join) ha toccato
+ * i pesi shexp: i loro range vanno rilasciati alla prossima spazzata. */
+static void metal_graph_shared1_note_gpu_use(ds4_gpu_graph *g) {
+    if (g && g->shared1) g->shared1->vram_dirty = 1;
+}
+
+static void metal_graph_shared1_schedule(
+        ds4_gpu_graph *g,
+        const ds4_layer_weights *layer,
+        uint32_t il) {
+    ds4_shared1 *s = g->shared1;
+    if (!s || !metal_graph_shared1_layer_owned(g, layer, il)) return;
+
+    if (il == 0) {
+        os_mutex_lock(&s->mutex);
+        s->seq++;
+        os_mutex_unlock(&s->mutex);
+        if (s->vram_dirty) {
+            s->vram_dirty = 0;
+            metal_graph_shared1_release_spans(s);
+        }
+    }
+
+    uint32_t slot = DS4_SHARED1_SLOTS;
+    os_mutex_lock(&s->mutex);
+    for (uint32_t i = 0; i < DS4_SHARED1_SLOTS; i++) {
+        if (s->job[i].state == DS4_SHARED1_FREE) {
+            slot = i;
+            break;
+        }
+        if ((s->job[i].state == DS4_SHARED1_DONE_OK ||
+             s->job[i].state == DS4_SHARED1_DONE_FAIL) &&
+            s->job[i].seq != s->seq) {
+            s->job[i].state = DS4_SHARED1_FREE;   /* orfano del token scorso */
+            s->stale_reclaimed++;
+            slot = i;
+            break;
+        }
+    }
+    if (slot == DS4_SHARED1_SLOTS) {
+        s->dropped++;
+        os_mutex_unlock(&s->mutex);
+        return;
+    }
+    ds4_shared1_job *job = &s->job[slot];
+    job->seq = s->seq;
+    job->layer = il;
+    job->cpu_ms = 0.0;
+    job->state = DS4_SHARED1_RESERVED;
+    os_mutex_unlock(&s->mutex);
+
+    /* D2H ordinato su stream 0: parte appena la GPU ha prodotto ffn_norm,
+     * cioe' prima del router e della fase routed dello stesso layer. */
+    if (!ds4_gpu_tensor_read_async_ordered_slot(
+            s->read_ring, slot, g->ffn_norm, 0,
+            (uint64_t)DS4_N_EMBD * sizeof(float))) {
+        os_mutex_lock(&s->mutex);
+        job->state = DS4_SHARED1_FREE;
+        s->sched_failures++;
+        os_mutex_unlock(&s->mutex);
+        return;
+    }
+
+    os_mutex_lock(&s->mutex);
+    job->state = DS4_SHARED1_QUEUED;
+    s->scheduled++;
+    os_cond_signal(&s->work_cond);
+    os_mutex_unlock(&s->mutex);
+}
+
+static void metal_graph_shared1_fallback_note(
+        ds4_shared1 *s,
+        uint32_t il,
+        const char *reason) {
+    s->fallbacks++;
+    /* mai silenzioso, mai una tempesta: primi 8 eventi + uno ogni 256 */
+    if (s->fallbacks <= 8u || (s->fallbacks & 255u) == 0u) {
+        fprintf(stderr,
+                "ds4: [shared-cpu] fallback #%llu layer=%u reason=%s "
+                "(shared ricalcolato su GPU)\n",
+                (unsigned long long)s->fallbacks, il, reason);
+    }
+}
+
+/* Punto di somma: attende il parziale CPU, lo accoda come H2D asincrono in
+ * g->shared_out e lascia il join al kernel non fuso esistente.  Su qualunque
+ * fallimento ricalcola lo shared su GPU (identico al percorso odierno
+ * non-overlap) e marca i range shexp da ripulire. */
+static bool metal_graph_shared1_join_or_gpu(
+        ds4_gpu_graph *g,
+        const ds4_model *model,
+        const ds4_layer_weights *layer,
+        uint32_t il,
+        bool fuse_shared_gate_up,
+        uint32_t shared_dim) {
+    ds4_shared1 *s = g->shared1;
+    const char *reason = NULL;
+    uint32_t slot = DS4_SHARED1_SLOTS;
+
+    os_mutex_lock(&s->mutex);
+    for (uint32_t i = 0; i < DS4_SHARED1_SLOTS; i++) {
+        if (s->job[i].seq != s->seq || s->job[i].layer != il) continue;
+        if (s->job[i].state == DS4_SHARED1_QUEUED ||
+            s->job[i].state == DS4_SHARED1_RUNNING ||
+            s->job[i].state == DS4_SHARED1_DONE_OK ||
+            s->job[i].state == DS4_SHARED1_DONE_FAIL) {
+            slot = i;
+            break;
+        }
+    }
+    if (slot == DS4_SHARED1_SLOTS) {
+        os_mutex_unlock(&s->mutex);
+        reason = "not-scheduled";
+    } else {
+        ds4_shared1_job *job = &s->job[slot];
+        const double w0 = now_sec();
+        while (job->state == DS4_SHARED1_QUEUED ||
+               job->state == DS4_SHARED1_RUNNING) {
+            os_cond_wait(&s->done_cond, &s->mutex);
+        }
+        const double w1 = now_sec();
+        const uint8_t state = job->state;
+        const double cpu_ms = job->cpu_ms;
+        job->state = DS4_SHARED1_FREE;
+        s->wait_s += w1 - w0;
+        ds4_shared1_hist_note(s->hist_wait, w1 - w0);
+        s->joins++;
+        os_mutex_unlock(&s->mutex);
+        if (s->verbose) {
+            fprintf(stderr,
+                    "ds4: [shared-cpu] layer=%u cpu_ms=%.3f wait_ms=%.3f ok=%d\n",
+                    il, cpu_ms, (w1 - w0) * 1000.0,
+                    state == DS4_SHARED1_DONE_OK);
+        }
+        if (state != DS4_SHARED1_DONE_OK) {
+            reason = "cpu-eval-failed";
+        } else if (!ds4_gpu_tensor_write_async_ordered_slot(
+                       s->write_ring, slot, g->shared_out, 0,
+                       (uint64_t)DS4_N_EMBD * sizeof(float))) {
+            reason = "h2d-enqueue-failed";
+        } else {
+            return true;
+        }
+    }
+
+    metal_graph_shared1_fallback_note(s, il, reason);
+    s->vram_dirty = 1;
+    bool ok;
+    if (fuse_shared_gate_up) {
+        ok = ds4_gpu_shared_gate_up_swiglu_q8_0_tensor(g->shared_gate,
+                                                         g->shared_up,
+                                                         g->shared_mid,
+                                                         model->map,
+                                                         model->size,
+                                                         layer->ffn_gate_shexp->abs_offset,
+                                                         layer->ffn_up_shexp->abs_offset,
+                                                         DS4_N_EMBD,
+                                                         shared_dim,
+                                                         g->ffn_norm) != 0;
+    } else {
+        ok = ds4_gpu_matmul_q8_0_tensor(g->shared_gate, model->map, model->size,
+                                          layer->ffn_gate_shexp->abs_offset,
+                                          DS4_N_EMBD, shared_dim,
+                                          g->ffn_norm, 1) != 0;
+        if (ok) ok = ds4_gpu_matmul_q8_0_tensor(g->shared_up, model->map, model->size,
+                                                  layer->ffn_up_shexp->abs_offset,
+                                                  DS4_N_EMBD, shared_dim,
+                                                  g->ffn_norm, 1) != 0;
+        if (ok) ok = ds4_gpu_swiglu_tensor(g->shared_mid, g->shared_gate, g->shared_up,
+                                             shared_dim, 0.0f, 1.0f) != 0;
+    }
+    if (ok) ok = ds4_gpu_matmul_q8_0_tensor(g->shared_out, model->map, model->size,
+                                              layer->ffn_down_shexp->abs_offset,
+                                              shared_dim, DS4_N_EMBD,
+                                              g->shared_mid, 1) != 0;
+    return ok;
+}
