+static void cuda_moe_tiering_log_route_ids(
+        const cuda_moe_route_request &request) {
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char *value = getenv("DS4_EXPERT_TIERING_LOG_IDS");
+        enabled = value && strcmp(value, "1") == 0;
+    }
+    if (!enabled || request.route_count != CUDA_MOE_ROUTE_COUNT) return;
+
+    /* T0 uses a process-local ordinal: every ordinary decode restarts at
+     * layer zero, including a new request in the same process. */
+    static uint64_t token_pos = 0u;
+    static uint32_t prior_layer = UINT32_MAX;
+    if (prior_layer != UINT32_MAX &&
+        request.layer_index == 0u) token_pos++;
+    prior_layer = request.layer_index;
+    fprintf(stderr,
+            "[route-ids] token=%llu layer=%u ids=%d,%d,%d,%d,%d,%d\n",
+            (unsigned long long)token_pos, request.layer_index,
+            request.selected[0], request.selected[1],
+            request.selected[2], request.selected[3],
+            request.selected[4], request.selected[5]);
+}
