+/* 05-B1/05-B2 (raccordi ledgerfix): con il route worker provabilmente MORTO
+ * (join riuscito o mai partito; mai col ramo detach) il thread chiamante e'
+ * l'unico proprietario dello slot ledger differito.  Decide il pendente con
+ * la prova piu' forte disponibile: stream_proven_drained=1 (sync riuscita
+ * del chiamante) o una cudaStreamQuery diretta -> commit; errore duro o
+ * force_decide=1 (lo stato DOV sta per essere azzerato: nessun decisore
+ * futuro) -> batch omesso con complete=0, la semantica del batch errato del
+ * percorso classico.  NotReady senza force lascia il pendente al prossimo
+ * decisore (release, request-end, worker respawnato o fail-safe del defer):
+ * mai degradare una prova che un decisore successivo avrebbe piu' forte.
+ * Ritorna 1 se lo slot e' deciso (o vuoto), 0 se resta pendente. */
+static int cuda_moe_drain_overlap4_decide_pending_joined(
+        cuda_moe_expert_cache *cache, int stream_proven_drained,
+        int force_decide) {
+    if (!cuda_moe_drain_overlap4_requested()) return 1;
+    if (!cuda_moe_drain_overlap4_outstanding()) return 1;
+    if (stream_proven_drained) {
+        cuda_moe_drain_overlap4_retire(0, 1);
+        return 1;
+    }
+    cudaError_t status = cudaErrorInvalidValue;
+    if (cache && cache->route_upload_stream) {
+        status = cudaStreamQuery(cache->route_upload_stream);
+        if (status == cudaSuccess) {
+            cuda_moe_drain_overlap4_retire(0, 1);
+            return 1;
+        }
+    }
+    if (status == cudaErrorNotReady && !force_decide) return 0;
+    cuda_moe_drain_overlap4_retire(0, 0);
+    return 1;
+}
