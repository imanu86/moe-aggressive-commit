+/* 05-B3: al request-end il thread di decode fa ritirare (o ritira esso
+ * stesso) il batch DOV di coda PRIMA della riga final del transport ledger.
+ * Finestra bounded di 50 ms: un batch di coda e' <=6 esperti (~42 MB, ~15 ms
+ * a ~3 GiB/s).  Con worker vivo si aspetta il SUO poll idle (una
+ * cudaStreamQuery per giro); con worker detached niente mani sullo slot;
+ * con worker joinato decide questo thread, da unico proprietario. */
+static int cuda_moe_drain_overlap4_tail_retire(void) {
+    if (!cuda_moe_drain_overlap4_requested()) return 1;
+    if (!cuda_moe_drain_overlap4_outstanding()) return 1;
+    cuda_moe_expert_cache *cache = &g_moe_expert_cache;
+    const double deadline = cuda_wall_sec() + 0.050;
+    if (cache->route_thread_started) {
+        while (cuda_moe_drain_overlap4_outstanding() &&
+               cuda_wall_sec() < deadline) {
+#ifdef _WIN32
+            (void)SwitchToThread();
+#else
+            usleep(0);
+#endif
+        }
+        return cuda_moe_drain_overlap4_outstanding() ? 0 : 1;
+    }
+    if (g_moe_route_worker_detached.load(std::memory_order_acquire)) {
+        return 0;
+    }
+    for (;;) {
+        if (cuda_moe_drain_overlap4_decide_pending_joined(cache, 0, 0)) {
+            return 1;
+        }
+        if (cuda_wall_sec() >= deadline) return 0;
+#ifdef _WIN32
+        (void)SwitchToThread();
+#else
+        usleep(0);
+#endif
+    }
+}
