+/* TIMEOUTFIX B3 - pubblicazione unica dello stato transiente della richiesta:
+ * reset dello slot cancellabile, azzeramento di byte e marcatori, deadline,
+ * sequence.  E' il blocco storico del percorso transiente, estratto per poter
+ * essere eseguito PRIMA di ogni lettura SSD del servizio route: anche le
+ * ammissioni SSD_COLD -> RAM devono stare sotto lo stesso guardiano,
+ * altrimenti il consumer le classifica "starved", il cancel colpisce uno slot
+ * che nessuno sta usando e il join scaduto lascia cache e worker safe-leaked
+ * permanenti.
+ *
+ * DRAIN3-STRUM: budget residuo del guardiano al PRIMO ingresso transiente
+ * della richiesta.  Il timer parte all'ingresso in enforce
+ * (transient_request_deadline, testa della funzione): quel che manca qui e'
+ * stato bruciato DENTRO la richiesta prima di leggere (drain anticipato), non
+ * dalla lettura stessa.  Discrimina "IO lento" da "budget consumato a monte"
+ * nei run che abortiscono con transient-io-timeout.  TIMEOUTFIX B4:
+ * WP_DEADLINE_EXHAUSTED non viene piu' incrementato qui; ora conta le
+ * scadenze osservate dalle letture stesse, in
+ * cuda_moe_transient_pread_chunked. */
+static void cuda_moe_transient_read_publish_once(
+        cuda_moe_expert_cache *cache,
+        const cuda_moe_route_request &request,
+        double transient_request_deadline, int wprof,
+        int *transient_read_published) {
+    if (*transient_read_published) return;
+    os_pread_cancellable_reset(&cache->route_transient_pread);
+    cache->route_transient_read_bytes.store(
+        0u, std::memory_order_release);
+    cache->route_transient_cancel_sequence.store(
+        0u, std::memory_order_release);
+    cache->route_transient_timeout_cancel_sequence.store(
+        0u, std::memory_order_release);
+    cache->route_transient_read_deadline.store(
+        transient_request_deadline, std::memory_order_release);
+    cache->route_transient_read_sequence.store(
+        request.sequence, std::memory_order_release);
+    if (wprof && transient_request_deadline > 0.0) {
+        const double drain3_slack_sec =
+            transient_request_deadline - cuda_wall_sec();
+        ds4_workerprof_add(WP_DEADLINE_SLACK_EVENTS, 1u);
+        if (drain3_slack_sec > 0.0) {
+            ds4_workerprof_add(
+                WP_DEADLINE_SLACK_NS,
+                (uint64_t)(drain3_slack_sec * 1.0e9));
+        }
+    }
+    *transient_read_published = 1;
+}
+
+/* TIMEOUTFIX B3 - lettura di ammissione SSD -> arena RAM.  Con un contesto
+ * transiente la lettura passa dal percorso cancellabile a chunk: deadline
+ * assoluta controllata a ogni chunk, cancel del consumer onorato, byte
+ * pubblicati per il watchdog di stallo, contabilita' transport per byte
+ * realmente letti.  Senza contesto (chiamanti di promozione fuori dal
+ * servizio route) resta la os_pread bloccante storica, byte-identica. */
+static int cuda_moe_tiering_admission_pread(
+        cuda_moe_expert_cache *transient_cache,
+        const cuda_moe_route_request &request,
+        uint32_t layer, int transport_repeat,
+        void *buf, uint64_t bytes, uint64_t offset,
+        double transient_deadline) {
+    if (transient_cache) {
+        return cuda_moe_transient_pread_chunked(
+            transient_cache, request.sequence, request.trace_sample_id,
+            layer, transport_repeat, &g_model_file, buf, bytes,
+            offset, transient_deadline) == 1;
+    }
+    if (!cuda_pread_full(&g_model_file, buf, bytes, offset)) return 0;
+    ds4_transport_record_file_bytes(transport_repeat, bytes);
+    return 1;
+}
