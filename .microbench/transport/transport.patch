+/* =======================================================================
+ * TRANSPORT LEDGER - request-scoped, exact pair traffic accounting.
+ *
+ * DS4_CUDA_TRANSPORT_LEDGER=1 enables the ledger.  With the default 0 the
+ * table is never cleared or touched, no clock is read and no line is emitted.
+ * DS4_CUDA_TRANSPORT_LEDGER_EVERY_TOKENS (default 32) controls periodic rows.
+ *
+ * "File read" means bytes actually returned by an explicit positioned read.
+ * Mmap page faults and host-mapped GPU reads cannot be attributed exactly to
+ * (layer, expert) here and are deliberately not inferred.  H2D bytes are
+ * committed only after the stream carrying the expert payload drained
+ * successfully.  The active interval is the measured wall-clock union during
+ * which at least one such submitted batch has not yet reached its drain.
+ * ======================================================================= */
+enum {
+    DS4_TRANSPORT_EXPERT_COUNT = 256,
+    DS4_TRANSPORT_PAIR_COUNT =
+        CUDA_MOE_LAYER_COUNT * DS4_TRANSPORT_EXPERT_COUNT,
+};
+
+struct ds4_transport_pair_counters {
+    uint32_t h2d_transfers;
+    uint32_t file_reads;
+};
+static_assert(
+    sizeof(ds4_transport_pair_counters) == 2u * sizeof(uint32_t),
+    "transport pair ledger must use exactly two 32-bit counters");
+static_assert(
+    sizeof(ds4_transport_pair_counters) * DS4_TRANSPORT_PAIR_COUNT == 88064u,
+    "transport pair ledger must be 43*256*2*4 bytes");
+
+struct ds4_transport_ledger_state {
+    std::atomic<int> armed{0};
+    std::atomic_flag lock = ATOMIC_FLAG_INIT;
+    ds4_transport_pair_counters pair[DS4_TRANSPORT_PAIR_COUNT];
+    uint64_t first_touch_bytes;
+    uint64_t repeat_h2d_bytes;
+    uint64_t repeat_file_bytes;
+    uint64_t h2d_bytes_total;
+    uint64_t tokens;
+    uint64_t next_log;
+    double decode_started;
+    double h2d_active_seconds;
+    double h2d_active_started;
+    uint32_t h2d_active_batches;
+    int complete;
+};
+static ds4_transport_ledger_state g_transport_ledger;
+
+struct ds4_transport_h2d_batch_entry {
+    uint32_t layer;
+    uint32_t expert;
+    uint64_t bytes;
+};
+
+struct ds4_transport_h2d_batch {
+    ds4_transport_h2d_batch_entry entries[CUDA_MOE_ROUTE_COUNT];
+    uint32_t count;
+    int active;
+    int complete;
+};
+
+struct ds4_transport_report_snapshot {
+    uint64_t unique_pairs_touched;
+    uint64_t first_touch_bytes;
+    uint64_t repeat_h2d_bytes;
+    uint64_t repeat_file_bytes;
+    uint64_t h2d_bytes_total;
+    uint64_t tokens;
+    double decode_seconds;
+    double h2d_active_seconds;
+    int complete;
+};
+
+static int cuda_transport_ledger_enabled(void) {
+    static int cached = -1;
+    if (cached < 0) {
+        const char *env = getenv("DS4_CUDA_TRANSPORT_LEDGER");
+        cached = env && env[0] && strcmp(env, "0") != 0;
+    }
+    return cached;
+}
+
+static uint64_t cuda_transport_ledger_every_tokens(void) {
+    static int resolved = 0;
+    static uint64_t cached = 32u;
+    if (resolved) return cached;
+    resolved = 1;
+    const char *env = getenv("DS4_CUDA_TRANSPORT_LEDGER_EVERY_TOKENS");
+    if (!env || !env[0]) return cached;
+    char *end = NULL;
+    errno = 0;
+    const unsigned long long parsed = strtoull(env, &end, 10);
+    if (errno == 0 && end != env && end && *end == '\0' && parsed > 0u) {
+        cached = (uint64_t)parsed;
+    } else {
+        fprintf(stderr,
+                "ds4: invalid DS4_CUDA_TRANSPORT_LEDGER_EVERY_TOKENS=%s; "
+                "using 32\n",
+                env);
+    }
+    return cached;
+}
+
+static void ds4_transport_lock(void) {
+    while (g_transport_ledger.lock.test_and_set(std::memory_order_acquire)) {
+    }
+}
+
+static void ds4_transport_unlock(void) {
+    g_transport_ledger.lock.clear(std::memory_order_release);
+}
+
+static int ds4_transport_pair_index(
+        uint32_t layer, uint32_t expert, uint32_t *index) {
+    if (layer >= CUDA_MOE_LAYER_COUNT ||
+        expert >= DS4_TRANSPORT_EXPERT_COUNT || !index) {
+        return 0;
+    }
+    *index = layer * DS4_TRANSPORT_EXPERT_COUNT + expert;
+    return 1;
+}
+
+static int ds4_transport_add_u64(uint64_t *value, uint64_t add) {
+    if (!value || *value > UINT64_MAX - add) return 0;
+    *value += add;
+    return 1;
+}
+
+static void ds4_transport_mark_incomplete(void) {
+    if (!cuda_transport_ledger_enabled() ||
+        !g_transport_ledger.armed.load(std::memory_order_acquire)) {
+        return;
+    }
+    ds4_transport_lock();
+    g_transport_ledger.complete = 0;
+    ds4_transport_unlock();
+}
+
+/* Begin one conceptual file materialization of a pair. Gate/up/down reads and
+ * their chunking share the returned classification, so distinct first-touch
+ * bytes are never mislabeled as repeats merely because GGUF has three planes. */
+static int ds4_transport_file_load_begin(
+        uint32_t layer, uint32_t expert) {
+    if (!cuda_transport_ledger_enabled() ||
+        !g_transport_ledger.armed.load(std::memory_order_acquire)) {
+        return -1;
+    }
+    uint32_t index = 0;
+    if (!ds4_transport_pair_index(layer, expert, &index)) {
+        ds4_transport_mark_incomplete();
+        return -1;
+    }
+    ds4_transport_lock();
+    if (!g_transport_ledger.armed.load(std::memory_order_relaxed)) {
+        ds4_transport_unlock();
+        return -1;
+    }
+    ds4_transport_pair_counters &pair = g_transport_ledger.pair[index];
+    const int repeat = pair.file_reads != 0u;
+    if (pair.file_reads == UINT32_MAX) {
+        g_transport_ledger.complete = 0;
+    } else {
+        pair.file_reads++;
+    }
+    ds4_transport_unlock();
+    return repeat;
+}
+
+static void ds4_transport_record_file_bytes(
+        int repeat, uint64_t bytes) {
+    if (repeat <= 0 || bytes == 0u || !cuda_transport_ledger_enabled() ||
+        !g_transport_ledger.armed.load(std::memory_order_acquire)) {
+        return;
+    }
+    ds4_transport_lock();
+    if (!ds4_transport_add_u64(
+            &g_transport_ledger.repeat_file_bytes, bytes)) {
+        g_transport_ledger.complete = 0;
+    }
+    ds4_transport_unlock();
+}
+
+static void ds4_transport_h2d_batch_begin(ds4_transport_h2d_batch *batch) {
+    if (!batch || batch->active || !cuda_transport_ledger_enabled() ||
+        !g_transport_ledger.armed.load(std::memory_order_acquire)) {
+        return;
+    }
+    const double now = cuda_wall_sec();
+    ds4_transport_lock();
+    if (g_transport_ledger.armed.load(std::memory_order_relaxed)) {
+        if (g_transport_ledger.h2d_active_batches++ == 0u) {
+            g_transport_ledger.h2d_active_started = now;
+        }
+        batch->active = 1;
+    }
+    ds4_transport_unlock();
+}
+
+static void ds4_transport_h2d_batch_append(
+        ds4_transport_h2d_batch *batch,
+        uint32_t layer, uint32_t expert, uint64_t bytes) {
+    if (!batch || bytes == 0u || !cuda_transport_ledger_enabled() ||
+        !g_transport_ledger.armed.load(std::memory_order_acquire)) {
+        return;
+    }
+    if (batch->count >= CUDA_MOE_ROUTE_COUNT ||
+        layer >= CUDA_MOE_LAYER_COUNT ||
+        expert >= DS4_TRANSPORT_EXPERT_COUNT) {
+        ds4_transport_mark_incomplete();
+        batch->complete = 0;
+        return;
+    }
+    if (batch->count == 0u) batch->complete = 1;
+    batch->entries[batch->count++] =
+        ds4_transport_h2d_batch_entry{layer, expert, bytes};
+}
+
+static void ds4_transport_h2d_batch_invalidate(
+        ds4_transport_h2d_batch *batch) {
+    if (!batch) return;
+    batch->complete = 0;
+    ds4_transport_mark_incomplete();
+}
+
+static void ds4_transport_h2d_batch_finish(
+        ds4_transport_h2d_batch *batch, int drain_ok) {
+    if (!batch || !batch->active) return;
+    const double now = cuda_wall_sec();
+    ds4_transport_lock();
+    if (g_transport_ledger.h2d_active_batches == 0u) {
+        g_transport_ledger.complete = 0;
+    } else if (--g_transport_ledger.h2d_active_batches == 0u) {
+        const double elapsed = now - g_transport_ledger.h2d_active_started;
+        if (elapsed >= 0.0) {
+            g_transport_ledger.h2d_active_seconds += elapsed;
+        } else {
+            g_transport_ledger.complete = 0;
+        }
+        g_transport_ledger.h2d_active_started = 0.0;
+    }
+    if (!drain_ok || !batch->complete) {
+        /* CUDA does not reveal which subset of an errored async batch crossed
+         * PCIe.  Keep all byte totals exact by omitting it and expose the gap. */
+        g_transport_ledger.complete = 0;
+    } else {
+        for (uint32_t i = 0; i < batch->count; i++) {
+            const ds4_transport_h2d_batch_entry &entry = batch->entries[i];
+            uint32_t index = 0;
+            if (!ds4_transport_pair_index(
+                    entry.layer, entry.expert, &index)) {
+                g_transport_ledger.complete = 0;
+                continue;
+            }
+            ds4_transport_pair_counters &pair =
+                g_transport_ledger.pair[index];
+            const int repeat = pair.h2d_transfers != 0u;
+            if (pair.h2d_transfers == UINT32_MAX) {
+                g_transport_ledger.complete = 0;
+            } else {
+                pair.h2d_transfers++;
+            }
+            uint64_t *classification = repeat
+                ? &g_transport_ledger.repeat_h2d_bytes
+                : &g_transport_ledger.first_touch_bytes;
+            if (!ds4_transport_add_u64(classification, entry.bytes) ||
+                !ds4_transport_add_u64(
+                    &g_transport_ledger.h2d_bytes_total, entry.bytes)) {
+                g_transport_ledger.complete = 0;
+            }
+        }
+    }
+    ds4_transport_unlock();
+    *batch = ds4_transport_h2d_batch{};
+}
+
+static void ds4_transport_clear(int arm_for_decode) {
+    if (!cuda_transport_ledger_enabled()) return;
+    g_transport_ledger.armed.store(0, std::memory_order_release);
+    ds4_transport_lock();
+    memset(g_transport_ledger.pair, 0, sizeof(g_transport_ledger.pair));
+    g_transport_ledger.first_touch_bytes = 0u;
+    g_transport_ledger.repeat_h2d_bytes = 0u;
+    g_transport_ledger.repeat_file_bytes = 0u;
+    g_transport_ledger.h2d_bytes_total = 0u;
+    g_transport_ledger.tokens = 0u;
+    g_transport_ledger.next_log = cuda_transport_ledger_every_tokens();
+    g_transport_ledger.decode_started =
+        arm_for_decode ? cuda_wall_sec() : 0.0;
+    g_transport_ledger.h2d_active_seconds = 0.0;
+    g_transport_ledger.h2d_active_started = 0.0;
+    g_transport_ledger.h2d_active_batches = 0u;
+    g_transport_ledger.complete = 1;
+    ds4_transport_unlock();
+    if (arm_for_decode) {
+        g_transport_ledger.armed.store(1, std::memory_order_release);
+    }
+}
+
+static void ds4_transport_request_reset(void) {
+    ds4_transport_clear(0);
+}
+
+static void ds4_transport_decode_begin(void) {
+    ds4_transport_clear(1);
+}
+
+static ds4_transport_report_snapshot ds4_transport_snapshot(void) {
+    ds4_transport_report_snapshot snapshot = {};
+    const double now = cuda_wall_sec();
+    ds4_transport_lock();
+    for (uint32_t i = 0; i < DS4_TRANSPORT_PAIR_COUNT; i++) {
+        const ds4_transport_pair_counters &pair =
+            g_transport_ledger.pair[i];
+        if (pair.h2d_transfers != 0u || pair.file_reads != 0u) {
+            snapshot.unique_pairs_touched++;
+        }
+    }
+    snapshot.first_touch_bytes = g_transport_ledger.first_touch_bytes;
+    snapshot.repeat_h2d_bytes = g_transport_ledger.repeat_h2d_bytes;
+    snapshot.repeat_file_bytes = g_transport_ledger.repeat_file_bytes;
+    snapshot.h2d_bytes_total = g_transport_ledger.h2d_bytes_total;
+    snapshot.tokens = g_transport_ledger.tokens;
+    snapshot.decode_seconds = now >= g_transport_ledger.decode_started
+        ? now - g_transport_ledger.decode_started : 0.0;
+    snapshot.h2d_active_seconds = g_transport_ledger.h2d_active_seconds;
+    if (g_transport_ledger.h2d_active_batches != 0u &&
+        now >= g_transport_ledger.h2d_active_started) {
+        snapshot.h2d_active_seconds +=
+            now - g_transport_ledger.h2d_active_started;
+    }
+    snapshot.complete = g_transport_ledger.complete;
+    ds4_transport_unlock();
+    return snapshot;
+}
+
+static void ds4_transport_report(const char *phase) {
+    if (!cuda_transport_ledger_enabled() ||
+        !g_transport_ledger.armed.load(std::memory_order_acquire)) {
+        return;
+    }
+    const ds4_transport_report_snapshot s = ds4_transport_snapshot();
+    const uint64_t classified_h2d =
+        s.first_touch_bytes + s.repeat_h2d_bytes;
+    const double repeat_ratio = classified_h2d != 0u
+        ? (double)s.repeat_h2d_bytes / (double)classified_h2d : 0.0;
+    const double pcie_busy_pct = s.decode_seconds > 0.0
+        ? 100.0 * s.h2d_active_seconds / s.decode_seconds : 0.0;
+    fprintf(stderr,
+            "ds4: [transport] phase=%s tokens=%llu "
+            "unique_pairs_touched=%llu first_touch_bytes=%llu "
+            "repeat_h2d_bytes=%llu repeat_file_bytes=%llu "
+            "repeat_ratio=%.9f h2d_bytes_total=%llu "
+            "h2d_active_ms=%.3f decode_ms=%.3f pcie_busy_pct=%.6f "
+            "ledger_complete=%d\n",
+            phase ? phase : "unknown",
+            (unsigned long long)s.tokens,
+            (unsigned long long)s.unique_pairs_touched,
+            (unsigned long long)s.first_touch_bytes,
+            (unsigned long long)s.repeat_h2d_bytes,
+            (unsigned long long)s.repeat_file_bytes,
+            repeat_ratio,
+            (unsigned long long)s.h2d_bytes_total,
+            s.h2d_active_seconds * 1000.0,
+            s.decode_seconds * 1000.0,
+            pcie_busy_pct,
+            s.complete);
+}
+
+static void ds4_transport_token_end(uint32_t token_count) {
+    if (token_count == 0u || !cuda_transport_ledger_enabled() ||
+        !g_transport_ledger.armed.load(std::memory_order_acquire)) {
+        return;
+    }
+    int due = 0;
+    ds4_transport_lock();
+    if (g_transport_ledger.tokens <= UINT64_MAX - token_count) {
+        g_transport_ledger.tokens += token_count;
+    } else {
+        g_transport_ledger.complete = 0;
+    }
+    if (g_transport_ledger.tokens >= g_transport_ledger.next_log) {
+        const uint64_t every = cuda_transport_ledger_every_tokens();
+        g_transport_ledger.next_log =
+            g_transport_ledger.tokens <= UINT64_MAX - every
+                ? g_transport_ledger.tokens + every : UINT64_MAX;
+        due = 1;
+    }
+    ds4_transport_unlock();
+    if (due) ds4_transport_report("periodic");
+}
+
+static void ds4_transport_request_end(void) {
+    if (!cuda_transport_ledger_enabled() ||
+        !g_transport_ledger.armed.load(std::memory_order_acquire)) {
+        return;
+    }
+    ds4_transport_report("final");
+    g_transport_ledger.armed.store(0, std::memory_order_release);
+}
