 #include "llama-kv-cache.h"
 #include "llama-kv-cache-iswa.h"
 
+// DIAGNOSTICA (locale, non da portare a monte): DSPARK_NO_MARKOV=1 salta la
+// testa di Markov, il cui ciclo e' l'unica parte del grafo del draft che gira
+// una volta PER POSIZIONE del blocco. Misurato: draft(n) = 128 ms fissi + 158
+// per posizione. Serve a stabilire se quei 158 ms sono questo ciclo oppure il
+// campionamento lato host, che scala allo stesso modo.
+// Senza la testa i draft restano validi ma non polarizzati (DFlash puro),
+// quindi l'accettazione cala: si confronta il COSTO per ciclo, non i t/s.
+static bool dspark_markov_disabled() {
+    static const bool disabilitata = [] {
+        const char * s = getenv("DSPARK_NO_MARKOV");
+        const bool v = s && atoi(s) != 0;
+        if (v) {
+            LLAMA_LOG_WARN("%s: DSPARK_NO_MARKOV=1 -- testa di Markov SALTATA (misura)\n", __func__);
+        }
+        return v;
+    }();
+    return disabilitata;
+}
