+// RAM_STORE: a graph that does not go through the demand cache (more than three rows, or
+// any row count while the cache holds no slot) reads the managed expert sources as plain
+// host memory, so every page must be present before it runs.
+static bool llama_ram_store_missing() {
+    if (!getenv("LLAMA_MOE_RAM_LAYERS")) return false;
+    using missing_fn = bool (*)();
+    auto reg = ggml_backend_reg_by_name("CUDA");
+    auto missing = reg ? reinterpret_cast<missing_fn>(ggml_backend_reg_get_proc_address(
+            reg, "ggml_backend_cuda_ram_has_missing")) : nullptr;
+    return missing && missing();
+}
+
+// Reloads the absent triples from the GGUF; the canary refuses only when that fails.
+static bool llama_ram_store_restore(const char * what) {
+    using restore_fn = int64_t (*)();
+    auto reg = ggml_backend_reg_by_name("CUDA");
+    auto restore = reg ? reinterpret_cast<restore_fn>(ggml_backend_reg_get_proc_address(
+            reg, "ggml_backend_cuda_ram_restore_all")) : nullptr;
+    const int64_t restored = restore ? restore() : -1;
+    if (restored < 0 || llama_ram_store_missing()) {
+        LLAMA_LOG_ERROR("RAM decode canary rejects %s while expert pages are absent (restore failed)\n", what);
+        return false;
+    }
+    LLAMA_LOG_INFO("RAM_STORE: restored %lld expert triples before %s\n", (long long) restored, what);
+    return true;
+}
