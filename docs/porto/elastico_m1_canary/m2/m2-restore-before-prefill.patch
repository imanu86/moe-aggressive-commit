+        (long long) restored, (unsigned long long) restored_bytes,
+        (long long) std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - started).count(),
+        (unsigned long long) registry.missing_groups, (unsigned long long) registry.resident_bytes,
+        (unsigned long long) memory.ullAvailPhys, memory.ullAvailPhys < 2ull*1024*1024*1024 ? 1 : 0, ok ? 1 : 0);
+    return ok ? restored : -1;
+}
