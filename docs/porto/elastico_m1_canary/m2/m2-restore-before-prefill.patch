+// Graphs that do not go through the demand cache (more than three rows, or any row count
+// while the cache holds no slot) read the managed sources as plain host memory: the
+// scheduler's expert copy and the whole-tensor prefill staging know nothing about
+// residency.  Every absent triple is therefore committed and reloaded from the GGUF
+// before such a graph runs.  Commit charge is the only hard limit: these pages are all
+// needed, so the 2 GiB courtesy floor is reported but not enforced here, and the decode
+// policy resumes eviction afterwards.  Returns the number of restored triples, or -1
+// when one could not be restored; that triple is rolled back and stays published cold,
+// so the caller's guard remains valid.
+static int64_t ggml_cuda_ram_restore_all() {
+    auto & registry = ggml_cuda_ram_store_registry_get();
+    const auto started = std::chrono::steady_clock::now();
+    std::lock_guard<std::mutex> lock(registry.mutex);
+    if (!registry.missing_groups) return 0;
+    int64_t restored = 0;
+    uint64_t restored_bytes = 0;
+    bool ok = true;
+    for (auto & item : registry.tensors) {
+        if (!ok) break;
+        auto & first = item.second;
+        if (first.bank != 0) continue;
+        ggml_cuda_ram_store_tensor * banks[3] = {&first, nullptr, nullptr};
+        for (auto & peer : registry.tensors) {
+            if (peer.second.layer == first.layer && peer.second.n_experts == first.n_experts && peer.second.bank >= 0 && peer.second.bank < 3) {
+                banks[peer.second.bank] = &peer.second;
+            }
+        }
+        if (!banks[1] || !banks[2]) continue;
+        const uint64_t record_bytes = banks[0]->stride + banks[1]->stride + banks[2]->stride;
+        for (int expert = 0; expert < first.n_experts && ok; ++expert) {
+            if (banks[0]->resident[expert] && banks[1]->resident[expert] && banks[2]->resident[expert]) continue;
+            try {
+                PERFORMANCE_INFORMATION commit{};
+                commit.cb = sizeof(commit);
+                if (!GetPerformanceInfo(&commit, sizeof(commit))) throw std::runtime_error("RAM_STORE restore commit sensor failed");
+                const uint64_t headroom = commit.CommitLimit > commit.CommitTotal ? uint64_t(commit.CommitLimit - commit.CommitTotal)*commit.PageSize : 0;
+                if (headroom <= record_bytes + 64ull*1024*1024) throw std::runtime_error("RAM_STORE restore has no commit headroom");
+                for (auto * bank : banks) {
+                    if (!ggml_cuda_ram_store_commit(*bank, expert)) throw std::runtime_error("RAM_STORE restore commit failed");
+                }
+                for (auto * bank : banks) {
+                    if (!ggml_cuda_ram_store_read_locked(*bank, expert,
