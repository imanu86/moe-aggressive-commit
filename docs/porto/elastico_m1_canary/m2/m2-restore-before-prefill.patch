+                ++restored;
+            } catch (const std::exception & error) {
+                uint64_t ignored = 0;
+                // publish_warm is the last step, so the triple is still published cold here.
+                for (auto * bank : banks) (void) ggml_cuda_ram_store_drop(*bank, expert, &ignored);
