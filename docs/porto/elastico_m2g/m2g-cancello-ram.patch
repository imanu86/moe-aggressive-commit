+
+#if defined(_WIN32)
+// M2g (28/9/2026): host RAM the next growth would allocate, i.e. the pinned staging and plan buffers of RAM
+// transports that do not exist yet. Zero means that growing the VRAM slots costs no host RAM.
+uint64_t elastic_pending_ram_bytes(moe_cache & mc) {
+    using required_fn = size_t (*)(const ggml_tensor * const *);
+    auto reg = ggml_backend_dev_backend_reg(mc.device);
+    auto required = reinterpret_cast<required_fn>(ggml_backend_reg_get_proc_address(reg,
+            "ggml_backend_cuda_moe_ram_transport_required_bytes"));
+    if (!required) return 0;
+    uint64_t pending = 0;
+    for (const auto & layer : mc.layers) {
+        const ggml_tensor * sources[] = {layer.pub.up_src, layer.pub.gate_src, layer.pub.down_src};
+        const uint64_t bytes = required(sources);
+        if (bytes > UINT64_MAX - pending) return UINT64_MAX;
+        pending += bytes;
+    }
+    return pending;
+}
+#endif
 } // namespace
 
