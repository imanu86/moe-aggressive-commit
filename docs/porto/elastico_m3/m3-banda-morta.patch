+bool llama_moe_cache_m3_restart(uint32_t kv) {
+    auto * mc = g_cache;
+    if (!mc || !mc->elastic || !mc->m3 || mc->release_pending) return false;
+    if (mc->n_slots > 0) return true; // cache tenuta durante il prefill (o appena inizializzata): niente da fare
