+// Cambio d'area verso un prefill, con l'area precedente gia' liberata. true = la cache resta dov'e'.
+bool llama_moe_cache_m3_keep_for_prefill(uint32_t tokens, uint32_t kv) {
+    auto * mc = g_cache;
+    if (!mc || !mc->elastic || !mc->m3_keep || mc->n_slots == 0 || mc->release_pending) return false;
+    // limite superiore appreso: la piu' piccola area gia' misurata con token e kv non inferiori
+    uint64_t bound = 0;
+    for (const auto & item : mc->workspace_bytes) {
+        if (item.first.first >= tokens && item.first.second >= kv && (bound == 0 || item.second < bound)) bound = item.second;
+    }
+    const auto m = read_elastic_memory(*mc);
+    const bool keep = llama_moe_keep_cache_for_workspace(m.policy_headroom, bound, mc->transient_bytes,
+            mc->keep_margin_bytes, tokens >= 512 ? mc->prefetch_ring_bytes : 0);
+    LLAMA_LOG_INFO("moe-elastic-json {\"event\":\"m3_prefill\",\"keep\":%d,\"slots\":%d,\"tokens\":%u,\"kv\":%u"
+            ",\"workspace_bound\":%" PRIu64 ",\"policy_headroom\":%" PRId64 ",\"monotonic_us\":%" PRIu64 "}\n",
+            keep, mc->n_slots, tokens, kv, bound, m.policy_headroom, monotonic_us());
+    return keep;
+}
+
+// Subito prima di riservare un'area di lavoro (nessuna area allocata) e subito dopo: la differenza di
+// VRAM libera e' la taglia dell'area, che serve a decidere i prefill successivi.
+void llama_moe_cache_m3_workspace_begin() {
+    auto * mc = g_cache;
+    if (!mc || !mc->elastic || !mc->m3) return;
+    const auto m = read_elastic_memory(*mc);
+    mc->workspace_probe_valid = true;
+    mc->workspace_probe_cuda = m.cuda_free;
+    mc->workspace_probe_physical = m.os.physical_free;
+    mc->workspace_probe_physical_valid = m.os.physical_valid;
+    mc->workspace_probe_slots = mc->n_slots;
+}
+
+void llama_moe_cache_m3_workspace_reserved(uint32_t tokens, uint32_t kv) {
+    auto * mc = g_cache;
+    if (!mc || !mc->elastic || !mc->m3 || !mc->workspace_probe_valid) return;
+    mc->workspace_probe_valid = false;
+    if (mc->workspace_probe_slots != mc->n_slots) return; // la cache e' cambiata nel mezzo: la differenza non e' l'area
+    const auto m = read_elastic_memory(*mc);
+    uint64_t bytes = mc->workspace_probe_cuda > m.cuda_free ? mc->workspace_probe_cuda - m.cuda_free : 0;
+    if (mc->workspace_probe_physical_valid && m.os.physical_valid && mc->workspace_probe_physical > m.os.physical_free) {
+        bytes = std::max(bytes, mc->workspace_probe_physical - m.os.physical_free);
+    }
+    if (bytes == 0) return;
+    if (mc->workspace_bytes.size() >= 4096) mc->workspace_bytes.clear();
+    auto & known = mc->workspace_bytes[{tokens, kv}];
+    known = std::max(known, bytes);
+}
+
+// Ritorno al decode dopo un prefill: un solo ridimensionamento, alla capacita' fresca o all'ultima taglia
