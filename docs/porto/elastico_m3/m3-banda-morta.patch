+#pragma once
+
+// M3 (21/9/2026): politica della cache elastica con banda morta.
+// Un ridimensionamento non ritocca la cache: libera tutti i buffer, rialloca e rifa' il bind, quindi
+// butta via ogni esperto residente (anche per un solo slot di differenza). Qui si decide QUANDO vale
+// la pena pagarlo. Funzioni pure, condivise col test autonomo (tests/policy_m3_test.cpp).
+
+#include "llama-moecache-policy.h"
+
+#include <initializer_list>
+
+struct llama_moe_band {
+    // VRAM lasciata libera sopra il transiente dopo ogni ridimensionamento: assorbe il jitter di
+    // cuda_free (±150 MiB misurati a taglia fissa) senza far scattare la riduzione.
+    uint64_t cushion_bytes  = 256ull * 1024 * 1024;
+    // crescita minima che giustifica lo svuotamento dell'intera cache
+    int32_t  min_grow_slots = 4;
+};
+
+// Decisione nel decode. Ritorna la nuova capacita', oppure `current` = non toccare.
+//   headroom        lettura corrente (la riduzione la usa subito, come in M2)
+//   growth_headroom minimo sulla finestra di 10 s (la crescita usa questo)
+// La riduzione scatta ESATTAMENTE quando scatterebbe in M2 (riserva violata: headroom < transient),
+// ma scende fino a lasciare anche il cuscino: un solo svuotamento invece della scaletta 67-66-65-64-62.
+// La crescita parte solo se guadagna almeno min_grow_slots lasciando il cuscino intatto.
+inline int32_t llama_moe_choose_capacity_banded(
+        int32_t current, int32_t minimum, int32_t maximum, uint64_t bytes_per_slot,
+        int64_t headroom, int64_t growth_headroom, uint64_t transient,
+        const llama_moe_band & band, bool growth_allowed) {
+    const int64_t cushion = band.cushion_bytes > uint64_t(std::numeric_limits<int64_t>::max())
+            ? std::numeric_limits<int64_t>::max() : int64_t(band.cushion_bytes);
+    const int32_t brim = llama_moe_choose_capacity(current, minimum, maximum, bytes_per_slot, headroom, 0, transient);
+    if (brim < current) {
+        const int32_t target = llama_moe_choose_capacity(current, minimum, maximum, bytes_per_slot,
+                llama_moe_policy_sat_sub(headroom, cushion), 0, transient);
+        // il cuscino non deve costare la cache intera quando il minimo rispetta ancora la riserva
+        if (target < minimum && brim >= minimum) return minimum;
+        return target < brim ? target : brim;
+    }
+    if (!growth_allowed) return current;
+    const int64_t stable = growth_headroom < headroom ? growth_headroom : headroom;
+    const int32_t target = llama_moe_choose_capacity(current, minimum, maximum, bytes_per_slot,
+            llama_moe_policy_sat_sub(stable, cushion), 0, transient);
+    if (current < minimum && target < minimum) {
+        // decode senza cache: il cuscino non deve impedire il minimo che M2 avrebbe concesso
+        const int32_t stable_brim = llama_moe_choose_capacity(current, minimum, maximum, bytes_per_slot, stable, 0, transient);
+        return stable_brim >= minimum ? minimum : current;
+    }
+    return target - current >= band.min_grow_slots ? target : current;
+}
+
+// Ripartenza dopo un prefill: la cache e' vuota e l'area del prefill e' gia' stata liberata, quindi
+// scegliere la taglia giusta adesso non costa niente. `headroom_empty` e' la lettura in quel momento,
+// `decode_workspace` la stima dell'area di lavoro del decode che verra' riservata subito dopo.
+// Se le condizioni non sono cambiate (capacita' fresca entro min_grow_slots dall'ultima taglia buona)
+// si riparte esattamente dall'ultima taglia buona, che era stabile con l'area del decode gia' allocata:
+// la capacita' fresca viene da una lettura sola e ne porta il jitter. L'ultima taglia buona deve pero'
+// lasciare almeno meta' cuscino, altrimenti la prima oscillazione la farebbe ridurre subito.
+inline int32_t llama_moe_restart_capacity(
+        int32_t last_good, int32_t minimum, int32_t maximum, uint64_t bytes_per_slot,
+        int64_t headroom_empty, uint64_t transient, uint64_t decode_workspace,
+        const llama_moe_band & band) {
+    const auto clamp = [](uint64_t v) {
+        return v > uint64_t(std::numeric_limits<int64_t>::max()) ? std::numeric_limits<int64_t>::max() : int64_t(v);
+    };
+    const int64_t after_workspace = llama_moe_policy_sat_sub(headroom_empty, clamp(decode_workspace));
+    const int32_t ceiling = llama_moe_choose_capacity(0, minimum, maximum, bytes_per_slot,
+            llama_moe_policy_sat_sub(after_workspace, clamp(band.cushion_bytes/2)), 0, transient);
+    const int32_t fresh = llama_moe_choose_capacity(0, minimum, maximum, bytes_per_slot,
+            llama_moe_policy_sat_sub(after_workspace, clamp(band.cushion_bytes)), 0, transient);
+    // M2 ripartiva comunque dal minimo: non fare peggio (resize() ha la sua verifica dopo l'allocazione)
+    if (fresh < minimum) return minimum;
+    if (last_good >= minimum && last_good <= ceiling) {
+        const int32_t delta = fresh > last_good ? fresh - last_good : last_good - fresh;
+        if (delta < band.min_grow_slots) return last_good;
+    }
+    return fresh;
+}
+
+// Prefill con la cache al suo posto: solo se l'area di lavoro (limite superiore appreso), il transiente,
+// un margine per il pool CUDA e l'eventuale anello di staging del prefill stanno nella VRAM libera ADESSO
+// (cache allocata, area del decode gia' liberata). `workspace_bytes == 0` = taglia sconosciuta: si svuota.
+inline bool llama_moe_keep_cache_for_workspace(
+        int64_t headroom_with_cache, uint64_t workspace_bytes, uint64_t transient,
+        uint64_t margin, uint64_t prefetch_ring) {
+    if (workspace_bytes == 0 || headroom_with_cache <= 0) return false;
+    uint64_t need = workspace_bytes;
+    for (const uint64_t part : {transient, margin, prefetch_ring}) {
+        if (part > std::numeric_limits<uint64_t>::max() - need) return false;
+        need += part;
+    }
+    return uint64_t(headroom_with_cache) >= need;
+}
