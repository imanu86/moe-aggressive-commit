+// lane-adattiva (2/9): il contatore «voci fuori tabella» della mul_mat_id CPU.
+//
+// Vive QUI (ggml-base) e non in ggml-cpu per un motivo di link, non di gusto:
+// la riga che lo stampa e' quella del worker, che sta in questo file, e la
+// dipendenza fra le due librerie e' a SENSO UNICO -- ggml/src/CMakeLists.txt
+// :283 «target_link_libraries(BACKEND PRIVATE ggml-base)». ggml-base NON puo'
+// chiamare ggml-cpu (simbolo irrisolto al link); ggml-cpu puo' chiamare
+// ggml-base. Quindi: incremento da ggml-cpu.c, definizione e lettura qui.
+//
+// Le due dichiarazioni stanno QUI e non in ggml-impl.h di proposito:
+// ggml-impl.h e' incluso da tutto l'albero e una riga li' ricompilerebbe
+// l'intero backend CUDA per un contatore. `ggml-cpu.c` porta la sua
+// dichiarazione `extern` locale, accanto agli include.
+//
+// A leva SPENTA questo contatore deve leggere ESATTAMENTE 0: e' il rilevatore
+// pre-registrato del ledger 25 §63-quater p.1 -- se leggesse > 0 sarebbe la
+// prova che un id -1 raggiunge GIA' oggi la mul_mat_id CPU in Release, dove
+// l'assert() di ggml-cpu.c sparisce sotto NDEBUG.
+extern "C" {
+GGML_API void     ggml_mmid_fuori_tabella_inc(void);
+GGML_API uint64_t ggml_mmid_fuori_tabella_get(void);
+}
+
+// L'atomica serve davvero: il worker della lane overlap gira su un thread suo,
+// in parallelo al threadpool principale, e la mul_mat_id CPU e' raggiunta da
+// entrambi.
+static std::atomic<uint64_t> g_mmid_fuori_tabella{0};
+
+void ggml_mmid_fuori_tabella_inc(void) {
+    g_mmid_fuori_tabella.fetch_add(1, std::memory_order_relaxed);
+}
+
+uint64_t ggml_mmid_fuori_tabella_get(void) {
+    return g_mmid_fuori_tabella.load(std::memory_order_relaxed);
+}
