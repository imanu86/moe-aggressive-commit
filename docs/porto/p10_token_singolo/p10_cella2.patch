+// diversi (lo stream di calcolo e' creato con `cudaStreamCreateWithFlags`,
+// `ggml-cuda/common.cuh:1492`), quindi l'ordine e' garantito solo dalle due attese
+// dell'host. A 131k, a riga singola, sono ~2,8 sincronizzazioni per ingresso e tutta
+// la consegna e' seriale dentro il buco fra il grafo N e il grafo N+1.
+//
+// Qui la garanzia passa dall'host allo STREAM: si svuota la coda UNA volta sola per
+// split e poi ogni ingresso viene copiato con `set_tensor_async` sullo STESSO stream
+// su cui gira il grafo. L'ordine dello stream garantisce (a) che la copia non
+// anticipi il grafo precedente che rilegge lo stesso buffer di ingresso e (b) che il
+// grafo successivo non parta prima che la copia sia finita.
+//
+// Perche' e' senza perdita: con la sorgente su host `ggml_backend_tensor_copy` fa
+// esattamente `ggml_backend_tensor_set(dst, src->data, 0, ggml_nbytes(src))`
+// (`ggml-backend.cpp:495`), cioe' la stessa `cudaMemcpyAsync` H2D con gli stessi byte,
+// lo stesso offset e la stessa destinazione. Cambia solo lo stream su cui e' accodata
+// e chi garantisce l'ordine.
+//
+// PRECONDIZIONE del chiamante: fra `ggml_backend_sched_graph_compute_async` e la
+// successiva riscrittura dei tensori d'ingresso ci deve essere una sincronizzazione.
+// `ggml_backend_sched_graph_compute` (versione non async) la fa gia'; llama.cpp la fa
+// esplicitamente prima di `set_inputs` (`llama-context.cpp`, `process_ubatch`).
+static bool ggml_backend_sched_ingressi_async(void) {
+    static const int abilitato = []() {
+        const char * v = getenv("GGML_SCHED_ASYNC_INPUTS");
+        return v ? atoi(v) : 1;
+    }();
+    return abilitato != 0;
+}
