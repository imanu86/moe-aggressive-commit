+// Senza perdita: a uid e numero di nodi invariati la scansione darebbe, nodo per nodo,
+// esattamente il valore memorizzato.
+static std::mutex ggml_cuda_compat_mutex;
+static std::unordered_map<const void *, std::pair<uint64_t, std::pair<int, bool>>> ggml_cuda_compat_cache;
+
+static bool ggml_cuda_graph_check_compability_cached(ggml_cgraph * cgraph, const void * graph_key) {
+    static const bool cache_on = []() {
+        const char * v = std::getenv("GGML_CUDA_GRAPH_COMPAT_CACHE");
+        return v ? std::atoi(v) != 0 : true;
+    }();
+    if (!cache_on || cgraph->uid == 0) {
+        return ggml_cuda_graph_check_compability(cgraph);
+    }
+    {
+        std::lock_guard<std::mutex> lock(ggml_cuda_compat_mutex);
+        const auto it = ggml_cuda_compat_cache.find(graph_key);
+        if (it != ggml_cuda_compat_cache.end() &&
+            it->second.first == cgraph->uid &&
+            it->second.second.first == cgraph->n_nodes) {
+            return it->second.second.second;
+        }
+    }
+    const bool ok = ggml_cuda_graph_check_compability(cgraph);
+    {
+        std::lock_guard<std::mutex> lock(ggml_cuda_compat_mutex);
+        ggml_cuda_compat_cache[graph_key] = { cgraph->uid, { cgraph->n_nodes, ok } };
+    }
+    return ok;
+}
