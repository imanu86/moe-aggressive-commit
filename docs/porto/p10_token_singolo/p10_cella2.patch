+// Vero se `src` (host) puo' essere versato in `dst` con `set_tensor_async` di `backend`:
+// stesse condizioni che l'assert di `ggml_backend_cuda_set_tensor_async` pretende.
+static bool ggml_backend_sched_puo_versare_async(ggml_backend_t backend,
+        const struct ggml_tensor * src, const struct ggml_tensor * dst) {
+    if (backend->iface.set_tensor_async == NULL) { return false; }
+    if (!src->buffer || !ggml_backend_buffer_is_host(src->buffer)) { return false; }
+    // I PESI non passano di qui: quando un tensore di esperti sta su host lo scheduler
+    // copia solo gli esperti instradati (ramo `copy_experts`), e una copia intera
+    // sarebbe un'altra cosa. Vanno lasciati al loro ramo.
+    if (ggml_backend_buffer_get_usage(src->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS) { return false; }
+    if (!dst->buffer || dst->view_src) { return false; }
+    if (dst->buffer->buft != ggml_backend_get_default_buffer_type(backend)) { return false; }
+    if (!ggml_are_same_layout(src, dst)) { return false; }
+    return true;
+}
