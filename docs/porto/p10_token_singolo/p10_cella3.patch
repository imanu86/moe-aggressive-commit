+// P10 cella 3 - tetto ai registri per i tipi a tabella sul forward a UNA riga.
+//
+// Sul percorso ncols_dst == 1 con small_k il blocco porta rows_per_cuda_block = nwarps
+// righe: il compilatore srotola tutto e, per iq2_s con la fusione gate+up, arriva a
+// 110 registri per thread. A 128 thread per blocco significa 4 blocchi per SM
+// (512 thread su 1536, cioe' il 33% dell'occupazione): un kernel che legge i pesi
+// degli esperti SENZA NESSUN RIUSO non ha abbastanza letture in volo per coprire la
+// latenza della VRAM, e si ferma a 182 GB/s su 340.
+//
+// Dichiarare un minimo di blocchi per SM obbliga ptxas a stare sotto i 64 registri.
+// Non cambia una sola operazione aritmetica ne' il loro ordine: e' lossless per
+// costruzione, ed e' verificato bit a bit nel microbanco
+// (docs/porto/p10_token_singolo/micro_iq2s_p10.cu) e con le impronte al banco.
+//
+// Livelli (GGML_CUDA_MMVQ_OCCUPANCY): 0 = spento (comportamento di V2),
+// 1 = solo iq2_s (default), 2 = iq2_s + iq4_nl.
+static constexpr __host__ __device__ int mmvq_occ_livello(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_IQ2_S:   return 1;
+        case GGML_TYPE_IQ4_NL:  return 2;
+        default:                return 0;
+    }
+}
+
+static constexpr __host__ __device__ int mmvq_occ_min_blocks(ggml_type type, int ncols_dst, bool small_k) {
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+    GGML_UNUSED(type); GGML_UNUSED(ncols_dst); GGML_UNUSED(small_k);
+    return 1;
+#else
+    if (ncols_dst != 1 || !small_k) {
+        return 1;
+    }
+    return mmvq_occ_livello(type) > 0 ? 8 : 1;
+#endif
+}
+
+static int mmvq_occ_livello_richiesto() {
+    static const int livello = [] {
+        const char * v = getenv("GGML_CUDA_MMVQ_OCCUPANCY");
+        return v ? atoi(v) : 1;
+    }();
+    return livello;
+}
