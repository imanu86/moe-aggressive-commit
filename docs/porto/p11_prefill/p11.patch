+// P11 (15/9): ubatch di PREFILL in funzione della profondita' del contesto.
+//
+// La workspace richiesta cresce come  a + b*T + c*T*K  (T = token dell'ubatch,
+// K = celle di KV): misurata a 131k, 2048 token costano 4408 MiB e 4096 ne
+// costano 8942, cioe' oltre la VRAM disponibile. Un batch grande conviene
+// all'inizio (meno lanci, GEMM piu' larghe) e sfonda in profondita'.
+//
+// QWEN_PREFILL_UBATCH_DEEP e' una SCALETTA "kv_soglia:ubatch" separata da virgole,
+// in ordine crescente di soglia. Esempio:
+//
+//     QWEN_PREFILL_UBATCH_DEEP="49152:4096,81920:3072,131072:2048"   con  -b 6144 -ub 6144
+//
+// significa: 6144 token per ubatch fino a 49k di KV, poi 4096, poi 3072, poi 2048.
+// Vale l'ultima soglia superata. Non impostata, o malformata, il comportamento e'
+// identico a prima: la leva e' SPENTA di default e non tocca il decode (il decode
+// gira a 1-3 token, sotto qualunque ubatch della scaletta).
+struct qwen_deep_ubatch_cfg {
+    std::vector<std::pair<uint32_t, uint32_t>> scaletta;   // (kv_soglia, ubatch)
+};
+
+static const qwen_deep_ubatch_cfg & qwen_deep_ubatch() {
+    static const qwen_deep_ubatch_cfg cfg = []() {
+        qwen_deep_ubatch_cfg c;
+        const char * e = getenv("QWEN_PREFILL_UBATCH_DEEP");
+        if (!e || !*e) { return c; }
+        const char * p = e;
+        while (*p) {
+            unsigned long kv = 0, ub = 0;
+            int letti = 0;
+            if (sscanf(p, "%lu:%lu%n", &kv, &ub, &letti) == 2 && kv > 0 && ub > 0) {
+                c.scaletta.emplace_back((uint32_t) kv, (uint32_t) ub);
+                p += letti;
+            } else {
+                LLAMA_LOG_INFO("qwen_deep_ubatch: scaletta malformata a \"%s\", leva SPENTA\n", p);
+                c.scaletta.clear();
+                return c;
+            }
+            if (*p == ',') { ++p; } else { break; }
+        }
+        std::sort(c.scaletta.begin(), c.scaletta.end());
+        for (const auto & s : c.scaletta) {
+            LLAMA_LOG_INFO("qwen_deep_ubatch: kv>=%u -> ubatch %u\n", s.first, s.second);
+        }
+        return c;
+    }();
+    return cfg;
+}
+
+// ubatch effettivo per una valutazione che arrivera' a n_kv celle
+static uint32_t qwen_ubatch_effettivo(uint32_t n_ubatch, uint32_t n_kv) {
+    uint32_t scelto = n_ubatch;
+    for (const auto & s : qwen_deep_ubatch().scaletta) {
+        if (n_kv >= s.first && s.second < scelto) {
+            scelto = s.second;
+        }
+    }
+    return scelto;
+}
