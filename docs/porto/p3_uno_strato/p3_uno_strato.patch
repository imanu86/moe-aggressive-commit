+// P3 — esecutore CPU degli esperti: una sola tabella per processo.
+// Calco esatto della coppia qui sopra: ggml-base la possiede, libllama la
+// installa, il backend CUDA la legge. Nessun tipo CUDA la attraversa.
+static struct ggml_moe_cpu_hooks g_moe_cpu_hooks;
+static bool                      g_moe_cpu_hooks_set = false;
+
+bool ggml_moe_cpu_set_hooks(const struct ggml_moe_cpu_hooks * hooks) {
+    if (hooks == NULL) {
+        memset(&g_moe_cpu_hooks, 0, sizeof(g_moe_cpu_hooks));
+        g_moe_cpu_hooks_set = false;
+        return true;
+    }
+    // Una seconda installazione mentre una e' attiva e' un errore di
+    // configurazione: si rifiuta, non si sovrascrive (R8 del progetto P2).
+    if (g_moe_cpu_hooks_set) {
+        return false;
+    }
+    g_moe_cpu_hooks     = *hooks;
+    g_moe_cpu_hooks_set = true;
+    return true;
+}
+
+const struct ggml_moe_cpu_hooks * ggml_moe_cpu_get_hooks(void) {
+    return g_moe_cpu_hooks_set ? &g_moe_cpu_hooks : NULL;
+}
