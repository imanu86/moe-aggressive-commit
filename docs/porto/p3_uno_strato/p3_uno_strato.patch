+#pragma once
+
+// P3 — Ibrido CPU/GPU degli esperti MoE: il lato di libllama.
+//
+// Questo file possiede l'esecutore CPU di P2 (`moe_cpu_executor`), i buffer
+// mappati che il backend CUDA vede come ingressi di graph, l'installazione
+// della tabella di hook di ggml-base e le opzioni di controllo. Il backend
+// CUDA non conosce `llama_context`; libllama non linka ggml-cuda.
+//
+// OPZIONI (tutte da ambiente, lette una volta sola: cambiarle richiede il
+// riavvio del processo; default SPENTO).
+//
+//   LLAMA_MOE_CPU=0|1           abilitazione generale                (0)
+//   LLAMA_MOE_CPU_LAYERS=1      elenco strati ammessi, separati da , (vuoto)
+//   LLAMA_MOE_CPU_MAX=0|1|2     massimo esperti CPU per strato       (2)
+//   LLAMA_MOE_CPU_THREADS=N     core del pool                        (4)
+//   LLAMA_MOE_CPU_DIAG=0|1      modalita' diagnostica                (0)
+//   LLAMA_MOE_CPU_REPORT=N      stampa i contatori ogni N lanci      (0)
+//   LLAMA_MOE_CPU_WAIT_US=N     scadenza del nodo host `wait`        (2000000)
+//   LLAMA_MOE_CPU_ACK_US=N      scadenza del riconoscimento          (200000)
+//
+// Le stesse variabili `LLAMA_MOE_CPU`, `_LAYERS`, `_MAX`, `_DIAG`, `_REPORT`
+// sono lette anche dal backend CUDA (moe-demand.cuh): il planner deve decidere
+// sul dispositivo, e il confine di P2 non porta configurazione.
+
+#include <cstdint>
+
+struct llama_model;
+struct ggml_tensor;
+
+// Crea l'esecutore e installa i hook. Non fa nulla quando la funzione e'
+// spenta, quando il modello non e' idoneo o quando `n_seq_max > 1`.
+// Non lancia: un fallimento spegne la funzione e lo registra nel log.
+void llama_moe_cpu_init(const llama_model & model, uint32_t n_seq_max);
+
+// Disinstalla i hook e distrugge l'esecutore. Da chiamare DOPO la
+// sincronizzazione del dispositivo e DOPO la distruzione dei graph che
+// referenziano i buffer.
+void llama_moe_cpu_free();
+
+bool llama_moe_cpu_enabled();
+bool llama_moe_cpu_diag();
+bool llama_moe_cpu_layer_enabled(int il);
+int  llama_moe_cpu_max_rows();
+
+// Vista stabile sul buffer `y` (il contributo CPU), F32 [n_embd, n_tokens].
+// nullptr quando la funzione e' spenta o le forme non combaciano. Le viste
+// sono create UNA VOLTA per contesto e riusate da tutti i graph: se fossero
+// create per strato o per replay, i puntatori dei nodi cambierebbero e il
+// graph CUDA verrebbe ricatturato a ogni token.
+ggml_tensor * llama_moe_cpu_y(int64_t n_embd, int64_t n_tokens);
+
+// Fase del pool: fuori dal decode e durante il prefill i thread dormono.
+void llama_moe_cpu_set_phase_decode();
+void llama_moe_cpu_set_phase_prefill();
+void llama_moe_cpu_set_phase_idle();
+
+// Vero quando un esito ha lasciato `y` o lo stato della cache incoerenti: il
+// decode deve fallire e l'incarnazione della cache va buttata.
+bool llama_moe_cpu_contaminated();
+
+// Attende che non ci sia lavoro in volo. Falso con un messaggio nel log se non
+// ci riesce entro il limite.
+bool llama_moe_cpu_quiesce();
+
+// Riepilogo per il registro: job pubblicati, conclusi, falliti.
+void llama_moe_cpu_log_counters(const char * where);
--- a/src/llama-moecpu.cpp
+++ b/src/llama-moecpu.cpp
@@ -0,0 +1,329 @@
+// P3 — Ibrido CPU/GPU degli esperti MoE: il lato di libllama.
+// Vedi llama-moecpu.h per le opzioni e P3_UNO_STRATO_14_SETTEMBRE.md per il
+// progetto complessivo.
+
+#include "llama-moecpu.h"
+
+#include "llama-impl.h"
+#include "llama-model.h"
+
+#include "moe_cpu_executor.h"
+#include "moe_cpu_host_memory.h"
+
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "ggml-moe-cpu.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace {
+
+struct options {
+    bool     enabled  = false;
+    bool     diag     = false;
+    int      cpu_max  = 2;
+    int      threads  = 4;
+    uint64_t wait_us  = 2000000;
+    uint64_t ack_us   = 200000;
+    bool     layer[512] = {};
+    bool     any_layer = false;
+};
+
+const options & opts() {
+    static const options o = [] {
+        options r;
+        const char * on = getenv("LLAMA_MOE_CPU");
+        r.enabled = on && strcmp(on, "0") != 0;
+        const char * diag = getenv("LLAMA_MOE_CPU_DIAG");
+        r.diag = diag && strcmp(diag, "0") != 0;
+        if (const char * v = getenv("LLAMA_MOE_CPU_MAX"))     { r.cpu_max = atoi(v); }
+        if (const char * v = getenv("LLAMA_MOE_CPU_THREADS")) { r.threads = atoi(v); }
+        if (const char * v = getenv("LLAMA_MOE_CPU_WAIT_US")) { r.wait_us = strtoull(v, nullptr, 10); }
+        if (const char * v = getenv("LLAMA_MOE_CPU_ACK_US"))  { r.ack_us  = strtoull(v, nullptr, 10); }
+        if (r.cpu_max < 0) r.cpu_max = 0;
+        if (r.cpu_max > MOE_CPU_MAX_PER_ROW) r.cpu_max = MOE_CPU_MAX_PER_ROW;
+        if (r.threads < 1) r.threads = 1;
+        if (const char * layers = getenv("LLAMA_MOE_CPU_LAYERS")) {
+            const char * p = layers;
+            while (*p) {
+                char * end = nullptr;
+                const long v = strtol(p, &end, 10);
+                if (end == p) break;
+                if (v >= 0 && v < 512) { r.layer[v] = true; r.any_layer = true; }
+                p = (*end == ',' || *end == ' ' || *end == ';') ? end + 1 : end;
+            }
+        }
+        return r;
+    }();
+    return o;
+}
+
+using mapped_host_fn = const void * (*)(const ggml_tensor *, size_t);
+
+struct state {
+    bool active = false;
+    int  max_rows = 1;
+    int64_t n_embd = 0;
+    std::unique_ptr<moe_cpu_executor> exec;
+    moe_cpu_host_memory * memory = nullptr;   // posseduta dall'esecutore
+    ggml_context * ctx_views = nullptr;
+    std::vector<ggml_tensor *> y_view;        // indice = n_tokens - 1
+    ggml_moe_cpu_hooks hooks{};
+};
+
+state g_state;
+
+// Indirizzo HOST di un tensore mappato. `tensor->data` e' l'indirizzo DEVICE:
+// su x86-64 coincidono per UVA, ma il codice non ci si appoggia (progetto P2 §7).
+const uint8_t * host_ptr_of(const ggml_tensor * t, std::string * err) {
+    if (!t || !t->buffer) { if (err) *err = "tensore senza buffer"; return nullptr; }
+    ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(t->buffer);
+    ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+    if (dev) {
+        ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+        if (reg) {
+            auto fn = (mapped_host_fn) ggml_backend_reg_get_proc_address(reg, "ggml_cuda_mapped_tensor_host_ptr");
+            if (fn) {
+                const void * p = fn(t, 0);
+                if (p) return (const uint8_t *) p;
+            }
+        }
+    }
+    // Ripiego dichiarato: un buffer host ordinario porta gia' l'indirizzo host.
+    if (ggml_backend_buffer_is_host(t->buffer)) return (const uint8_t *) t->data;
+    if (err) *err = std::string("i pesi di '") + t->name + "' non sono in memoria host mappata";
+    return nullptr;
+}
+
+} // namespace
+
+bool llama_moe_cpu_enabled()          { return g_state.active; }
+bool llama_moe_cpu_diag()             { return g_state.active && opts().diag; }
+int  llama_moe_cpu_max_rows()         { return g_state.active ? g_state.max_rows : 0; }
+
+bool llama_moe_cpu_layer_enabled(int il) {
+    return g_state.active && il >= 0 && il < 512 && opts().layer[il];
+}
+
+void llama_moe_cpu_init(const llama_model & model, uint32_t n_seq_max) {
+    const auto & o = opts();
+    if (g_state.active || !o.enabled) return;
+    if (!o.any_layer || o.cpu_max <= 0) {
+        LLAMA_LOG_WARN("moe cpu: LLAMA_MOE_CPU e' acceso ma LLAMA_MOE_CPU_LAYERS/_MAX non selezionano nulla: funzione spenta\n");
+        return;
+    }
+    if (n_seq_max != 1) {
+        LLAMA_LOG_WARN("moe cpu: richiede --parallel 1 (n_seq_max=%u): funzione spenta\n", n_seq_max);
+        return;
+    }
+    if (model.hparams.no_alloc) return;
+
+    const auto & hparams = model.hparams;
+
+    // Raccolta dei banchi degli strati ammessi, con le guardie di forma e tipo.
+    struct bank_entry { int il; moe_cpu_bank bank; };
+    std::vector<bank_entry> banks;
+    ggml_type t_gate = GGML_TYPE_COUNT, t_up = GGML_TYPE_COUNT, t_down = GGML_TYPE_COUNT;
+    int64_t n_embd = 0, n_ff_exp = 0;
+
+    for (int il = 0; il < (int) model.layers.size() && il < 512; ++il) {
+        if (!o.layer[il]) continue;
+        const auto & l = model.layers[il];
+        std::string err;
+        if (!l.ffn_gate_exps || !l.ffn_up_exps || !l.ffn_down_exps) {
+            LLAMA_LOG_WARN("moe cpu: strato %d senza esperti separati: escluso\n", il);
+            continue;
+        }
+        if (l.ffn_gate_exps_b || l.ffn_up_exps_b || l.ffn_down_exps_b) {
+            LLAMA_LOG_WARN("moe cpu: strato %d ha bias degli esperti: escluso\n", il);
+            continue;
+        }
+        if (l.ffn_gate_exps->type != l.ffn_up_exps->type) {
+            LLAMA_LOG_WARN("moe cpu: strato %d ha gate e up di tipo diverso: escluso\n", il);
+            continue;
+        }
+        const uint8_t * g = host_ptr_of(l.ffn_gate_exps, &err);
+        const uint8_t * u = host_ptr_of(l.ffn_up_exps,   &err);
+        const uint8_t * d = host_ptr_of(l.ffn_down_exps, &err);
+        if (!g || !u || !d) {
+            LLAMA_LOG_WARN("moe cpu: strato %d escluso (%s)\n", il, err.c_str());
+            continue;
+        }
+        if (banks.empty()) {
+            t_gate   = l.ffn_gate_exps->type;
+            t_up     = l.ffn_up_exps->type;
+            t_down   = l.ffn_down_exps->type;
+            n_embd   = l.ffn_gate_exps->ne[0];
+            n_ff_exp = l.ffn_gate_exps->ne[1];
+        } else if (l.ffn_gate_exps->type != t_gate || l.ffn_down_exps->type != t_down ||
+                   l.ffn_gate_exps->ne[0] != n_embd || l.ffn_gate_exps->ne[1] != n_ff_exp) {
+            LLAMA_LOG_WARN("moe cpu: strato %d ha forme/tipi diversi dal primo strato ammesso: escluso\n", il);
+            continue;
+        }
+        moe_cpu_bank b;
+        b.gate = g; b.gate_stride = l.ffn_gate_exps->nb[2];
+        b.up   = u; b.up_stride   = l.ffn_up_exps->nb[2];
+        b.down = d; b.down_stride = l.ffn_down_exps->nb[2];
+        b.n_experts = (int32_t) l.ffn_gate_exps->ne[2];
+        banks.push_back({il, b});
+    }
+
+    if (banks.empty()) {
+        LLAMA_LOG_WARN("moe cpu: nessuno strato ammesso e' risultato idoneo: funzione spenta\n");
+        return;
+    }
+    if (n_embd != (int64_t) hparams.n_embd) {
+        LLAMA_LOG_WARN("moe cpu: n_embd degli esperti (%lld) diverso da hparams (%u): funzione spenta\n",
+            (long long) n_embd, hparams.n_embd);
+        return;
+    }
+
+    moe_cpu_caps caps;
+    caps.n_embd          = (int32_t) n_embd;
+    caps.n_ff_exp        = (int32_t) n_ff_exp;
+    caps.type_gate       = t_gate;
+    caps.type_up         = t_up;
+    caps.type_down       = t_down;
+    caps.max_rows        = 1;               // D06: MTP spento nella prima integrazione
+    caps.max_per_row     = (int32_t) o.cpu_max;
+    caps.n_threads       = (int32_t) o.threads;
+    caps.wait_timeout_us = o.wait_us;
+    caps.ack_timeout_us  = o.ack_us;
+
+    auto memory = moe_cpu_host_memory_cuda_mapped(0);
+    moe_cpu_host_memory * mem_raw = memory.get();
+    std::string err;
+    auto exec = moe_cpu_executor::create(caps, std::move(memory), &err);
+    if (!exec) {
+        LLAMA_LOG_WARN("moe cpu: esecutore non creato (%s): funzione spenta\n", err.c_str());
+        return;
+    }
+    for (const auto & e : banks) {
+        if (!exec->register_layer(e.il, e.bank, &err)) {
+            LLAMA_LOG_WARN("moe cpu: registrazione dello strato %d fallita (%s): funzione spenta\n", e.il, err.c_str());
+            return;
+        }
+    }
+
+    // Vista stabile su `y`. Si costruisce sopra il tensore che copre il blocco
+    // mappato: `y` e' quindi un tensore ggml su un buffer che il backend CUDA
+    // riconosce come proprio, e l'`add` del contributo CPU lo legge in
+    // ZERO-COPY, senza nessuna copia H2D.
+    ggml_tensor * base = mem_raw->base_tensor();
+    if (!base || !base->buffer || !base->data) {
+        LLAMA_LOG_WARN("moe cpu: il fornitore di memoria non espone un tensore di base: funzione spenta\n");
+        return;
+    }
+    const size_t off_y = (const char *) exec->y_dev() - (const char *) base->data;
+
+    ggml_init_params ip{};
+    ip.mem_size = ggml_tensor_overhead() * (size_t) (caps.max_rows + 2);
+    ip.no_alloc = true;
+    g_state.ctx_views = ggml_init(ip);
+    if (!g_state.ctx_views) {
+        LLAMA_LOG_WARN("moe cpu: contesto delle viste non creato: funzione spenta\n");
+        return;
+    }
+    g_state.y_view.assign((size_t) caps.max_rows, nullptr);
+    for (int r = 1; r <= caps.max_rows; ++r) {
+        ggml_tensor * v = ggml_new_tensor_2d(g_state.ctx_views, GGML_TYPE_F32, n_embd, r);
+        // Allocazione esplicita sopra il blocco gia' esistente: stesso buffer,
+        // indirizzo fisso per tutta la vita del contesto.
+        v->buffer = base->buffer;
+        v->data   = (char *) base->data + off_y;
+        ggml_format_name(v, "moe_cpu_y.%d", r);
+        g_state.y_view[(size_t) r - 1] = v;
+    }
+
+    g_state.hooks.abi         = MOE_CPU_ABI_VERSION;
+    g_state.hooks.user        = exec.get();
+    g_state.hooks.submit      = &moe_cpu_executor::submit_hook;
+    g_state.hooks.wait        = &moe_cpu_executor::wait_hook;
+    g_state.hooks.job_dev     = exec->job_dev();
+    g_state.hooks.flags_dev   = exec->flags_dev();
+    g_state.hooks.x_dev       = exec->x_dev();
+    g_state.hooks.y_dev       = exec->y_dev();
+    g_state.hooks.max_rows    = caps.max_rows;
+    g_state.hooks.max_per_row = caps.max_per_row;
+    g_state.hooks.n_embd      = caps.n_embd;
+    g_state.hooks.n_ff_exp    = caps.n_ff_exp;
+
+    if (!ggml_moe_cpu_set_hooks(&g_state.hooks)) {
+        LLAMA_LOG_WARN("moe cpu: una tabella di hook e' gia' installata (un solo pool per processo): funzione spenta\n");
+        ggml_free(g_state.ctx_views);
+        g_state.ctx_views = nullptr;
+        return;
+    }
+
+    g_state.exec     = std::move(exec);
+    g_state.memory   = mem_raw;
+    g_state.max_rows = caps.max_rows;
+    g_state.n_embd   = n_embd;
+    g_state.active   = true;
+
+    std::string layer_list;
+    for (const auto & e : banks) {
+        layer_list += (layer_list.empty() ? "" : ",") + std::to_string(e.il);
+    }
+    LLAMA_LOG_INFO("moe cpu: ATTIVO, modo %s, strati [%s], cpu_max %d, thread %d, attesa %s, "
+                   "n_embd %lld, n_ff_exp %lld, tipi %s/%s/%s, %zu byte di buffer\n",
+        o.diag ? "DIAGNOSTICA (nessuna somma)" : "attiva (righe fittizie a peso GPU zero)",
+        layer_list.c_str(), o.cpu_max, o.threads, moe_cpu_wait_backend(),
+        (long long) n_embd, (long long) n_ff_exp,
+        ggml_type_name(t_gate), ggml_type_name(t_up), ggml_type_name(t_down),
+        g_state.exec->allocated_bytes());
+}
+
+void llama_moe_cpu_free() {
+    if (!g_state.active) return;
+    g_state.exec->set_phase(moe_cpu_phase::idle);
+    std::string err;
+    if (!g_state.exec->quiesce(2000000, &err)) {
+        LLAMA_LOG_WARN("moe cpu: quiesce fallita alla chiusura (%s)\n", err.c_str());
+    }
+    llama_moe_cpu_log_counters("chiusura");
+    ggml_moe_cpu_set_hooks(nullptr);
+    if (g_state.ctx_views) { ggml_free(g_state.ctx_views); g_state.ctx_views = nullptr; }
+    g_state.y_view.clear();
+    g_state.exec.reset();
+    g_state.memory = nullptr;
+    g_state.active = false;
+}
+
+ggml_tensor * llama_moe_cpu_y(int64_t n_embd, int64_t n_tokens) {
+    if (!g_state.active) return nullptr;
+    if (n_embd != g_state.n_embd) return nullptr;
+    if (n_tokens < 1 || n_tokens > (int64_t) g_state.max_rows) return nullptr;
+    return g_state.y_view[(size_t) n_tokens - 1];
+}
+
+void llama_moe_cpu_set_phase_decode()  { if (g_state.active) g_state.exec->set_phase(moe_cpu_phase::decode); }
+void llama_moe_cpu_set_phase_prefill() { if (g_state.active) g_state.exec->set_phase(moe_cpu_phase::prefill); }
+void llama_moe_cpu_set_phase_idle()    { if (g_state.active) g_state.exec->set_phase(moe_cpu_phase::idle); }
+
+bool llama_moe_cpu_contaminated() {
+    return g_state.active && g_state.exec->contaminated();
+}
+
+bool llama_moe_cpu_quiesce() {
+    if (!g_state.active) return true;
+    std::string err;
+    if (g_state.exec->quiesce(2000000, &err)) return true;
+    LLAMA_LOG_WARN("moe cpu: quiesce fallita (%s)\n", err.c_str());
+    return false;
+}
+
+void llama_moe_cpu_log_counters(const char * where) {
+    if (!g_state.active) return;
+    LLAMA_LOG_INFO("moe cpu [%s]: pubblicati %llu, conclusi %llu, falliti %llu, contaminato %s, irrecuperabile %s\n",
+        where ? where : "",
+        (unsigned long long) g_state.exec->submitted(),
+        (unsigned long long) g_state.exec->completed(),
+        (unsigned long long) g_state.exec->failures(),
+        g_state.exec->contaminated() ? "SI" : "no",
+        g_state.exec->unrecoverable() ? "SI" : "no");
+}
