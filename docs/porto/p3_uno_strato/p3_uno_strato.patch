+// ---------------------------------------------------------------------------
+// P3 — kernel di EXPORT: scrive il descrittore del job e l'attivazione in
+// memoria host mappata, e (solo in modalita' attiva) azzera il peso GPU delle
+// route servite dalla CPU.
+//
+// Perche' qui e non dall'host: il piano CPU nasce SUL DISPOSITIVO (contratto
+// P1 §4.2 passo 5), quindi il job non puo' essere consegnato al momento
+// dell'accodamento. Il nodo host `submit` viene accodato DOPO questo kernel
+// sullo stesso stream: l'ordinamento di stream rende visibili all'host le
+// scritture, e il __threadfence_system() finale e' comunque richiesto.
+//
+// La maschera si applica DOPO la normalizzazione e la scala del routing
+// (llama-graph.cpp), sul tensore dei pesi effettivamente consumato dalla
+// pesatura e dalla sua eventuale fusione: azzerando IN LOCO non esiste un
+// secondo tensore che una fusione possa leggere al posto di quello mascherato
+// (rischio R3 del progetto P2, chiuso per costruzione). I pesi delle altre
+// route restano identici bit per bit: NESSUNA rinormalizzazione.
+static __global__ void moe_cpu_export_kernel(
+        const moe_grouped_decode_plan * plan,
+        uint32_t plan_capacity,
+        uint32_t top_k,
+        uint32_t n_rows,
+        const float * activation,
+        uint64_t act_row_stride,      // in float
+        float * router_weights,       // [top_k * n_rows], contiguo
+        uint32_t n_embd,
+        uint32_t n_ff_exp,
+        int32_t  layer,
+        bool     diag,
+        moe_cpu_job * job,
+        float * x,
+        const uint64_t * device_step) {
+    const uint32_t thread = threadIdx.x;
+    if (plan->status != MOE_GROUPED_PLAN_READY) {
+        // Il piano e' fallito: non si pubblica nulla di consumabile. Il magic
+        // invalidato fa rifiutare il job dall'esecutore (invariante 7).
+        if (thread == 0) job->magic = 0;
+        return;
+    }
+
+    const int32_t * route_unique = moe_grouped_plan_array_ptr(plan, plan_capacity, MOE_GROUPED_PLAN_ROUTE_UNIQUE);
+    const int32_t * cpu_unique   = moe_grouped_plan_array_ptr(plan, plan_capacity, MOE_GROUPED_PLAN_CPU_UNIQUE);
+    const int32_t * cpu_experts  = moe_grouped_plan_array_ptr(plan, plan_capacity, MOE_GROUPED_PLAN_CPU_EXPERTS);
+
+    if (thread == 0) {
+        job->magic    = MOE_CPU_JOB_MAGIC;
+        job->abi      = MOE_CPU_ABI_VERSION;
+        job->layer    = layer;
+        job->n_rows   = (int32_t) n_rows;
+        job->n_embd   = (int32_t) n_embd;
+        job->n_ff_exp = (int32_t) n_ff_exp;
+        job->sequence = device_step ? *device_step : 0ULL;
+        for (int r = 0; r < MOE_CPU_MAX_ROWS; ++r) job->n_routes[r] = 0;
+        for (int i = 0; i < MOE_CPU_MAX_ROUTES; ++i) { job->expert[i] = 0; job->weight[i] = 0.0f; }
+
+        const uint32_t n_cpu    = plan->n_cpu;
+        const uint32_t n_routes = plan->n_routes;
+        for (uint32_t route = 0; route < n_routes && n_cpu > 0; ++route) {
+            const int32_t u = route_unique[route];
+            for (uint32_t i = 0; i < n_cpu; ++i) {
+                if (cpu_unique[i] != u) continue;
+                const uint32_t row = top_k ? route / top_k : 0;
+                if (row >= n_rows || row >= (uint32_t) MOE_CPU_MAX_ROWS) break;
+                const int32_t j = job->n_routes[row];
+                if (j >= (int32_t) MOE_CPU_MAX_PER_ROW) break;
+                const uint32_t idx = row * MOE_CPU_MAX_PER_ROW + (uint32_t) j;
+                job->expert[idx]   = cpu_experts[i];
+                job->weight[idx]   = router_weights ? router_weights[route] : 0.0f;
+                job->n_routes[row] = j + 1;
+                // Ogni coppia token/esperto contribuisce ESATTAMENTE UNA VOLTA
+                // (invariante 5): o con il peso GPU originale, o con peso GPU
+                // zero e un job CPU che porta lo stesso peso originale.
+                if (!diag && router_weights) router_weights[route] = 0.0f;
+                break;
+            }
+        }
+    }
+    __syncthreads();
+
+    const uint32_t total = n_rows * n_embd;
+    for (uint32_t i = thread; i < total; i += blockDim.x) {
+        const uint32_t row = i / n_embd;
+        const uint32_t col = i - row * n_embd;
+        x[i] = activation[row * act_row_stride + col];
+    }
+    __threadfence_system();
+}
