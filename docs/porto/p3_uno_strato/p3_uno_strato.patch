+// ---------------------------------------------------------------------------
+// P3 — guardia del merge, accodata fra il nodo host `wait` e l'`add` che legge
+// `y`.
+//
+//  - VELENO: se `flags->poison` vale 1 il contenuto di `y` NON e' un risultato
+//    valido. Si scrive NaN, non zero: un errore non puo' diventare uno zero
+//    silenzioso e plausibile (invariante 7). La prima cintura resta il
+//    controllo di `contaminated()` in decode(), che fa fallire il passo.
+//  - DIAGNOSTICA: si confronta il contributo CPU con il contributo che la GPU
+//    calcola per le STESSE route (somma di peso * riga di `experts`), si
+//    accumulano NRMSE e massimo assoluto, e poi `y` viene AZZERATO, cosi'
+//    l'uscita del modello resta esattamente quella del percorso GPU.
+static __global__ void moe_cpu_merge_guard_kernel(
+        const moe_cpu_flags * flags,
+        float * y,
+        uint32_t n_embd,
+        uint32_t n_rows,
+        bool diag,
+        const float * experts,
+        uint64_t exp_nb1,             // in float
+        uint64_t exp_nb2,             // in float
+        const float * router_weights,
+        const moe_grouped_decode_plan * plan,
+        uint32_t plan_capacity,
+        uint32_t top_k,
+        double * diag_acc,
+        unsigned long long * diag_u,
+        float * diag_ring) {
+    __shared__ double sh_err[128];
+    __shared__ double sh_ref[128];
+    __shared__ float  sh_max[128];
+    const uint32_t thread = threadIdx.x;
+    const bool poison = flags && flags->poison.value != 0ULL;
+
+    const bool can_diag = diag && experts && router_weights && plan && diag_acc && diag_u &&
+                          plan->status == MOE_GROUPED_PLAN_READY && plan->n_cpu > 0 && !poison;
+
+    if (can_diag) {
+        const int32_t * route_unique = moe_grouped_plan_array_ptr(plan, plan_capacity, MOE_GROUPED_PLAN_ROUTE_UNIQUE);
+        const int32_t * cpu_unique   = moe_grouped_plan_array_ptr(plan, plan_capacity, MOE_GROUPED_PLAN_CPU_UNIQUE);
+        for (uint32_t row = 0; row < n_rows; ++row) {
+            double err = 0.0, ref = 0.0;
+            float  mx  = 0.0f;
+            for (uint32_t i = thread; i < n_embd; i += blockDim.x) {
+                float r = 0.0f;
+                for (uint32_t route = row * top_k; route < (row + 1) * top_k && route < plan->n_routes; ++route) {
+                    const int32_t u = route_unique[route];
+                    bool is_cpu = false;
+                    for (uint32_t c = 0; c < plan->n_cpu; ++c) {
+                        if (cpu_unique[c] == u) { is_cpu = true; break; }
+                    }
+                    if (!is_cpu) continue;
+                    const uint32_t k = route - row * top_k;
+                    r += router_weights[route] * experts[row * exp_nb2 + k * exp_nb1 + i];
+                }
+                const float got = y[row * n_embd + i];
+                const float d   = got - r;
+                err += (double) d * (double) d;
+                ref += (double) r * (double) r;
+                mx   = fmaxf(mx, fabsf(d));
+            }
+            // Il kernel gira SEMPRE con 128 thread (vedi il punto di lancio):
+            // una cella per thread, nessuna atomica in memoria condivisa.
+            sh_err[thread] = err;
+            sh_ref[thread] = ref;
+            sh_max[thread] = mx;
+            __syncthreads();
+            if (thread == 0) {
+                double e = 0.0, f = 0.0; float m = 0.0f;
+                for (int i = 0; i < 128; ++i) { e += sh_err[i]; f += sh_ref[i]; m = fmaxf(m, sh_max[i]); }
+                atomicAdd(&diag_acc[0], e);
+                atomicAdd(&diag_acc[1], f);
+                atomicAdd(&diag_acc[2], 1.0);
+                atomicMax(diag_u, (unsigned long long) __float_as_uint(m));
+                const unsigned long long pos = atomicAdd(&diag_u[2], 1ULL) % MOE_CPU_DIAG_RING;
+                diag_ring[2 * pos + 0] = f > 0.0 ? (float) sqrt(e / f) : (e > 0.0 ? 1.0f : 0.0f);
+                diag_ring[2 * pos + 1] = m;
+            }
+            __syncthreads();
+        }
+    }
+
+    // Conteggio dei non finiti in `y`: vale in entrambe le modalita'.
+    if (diag_u) {
+        unsigned long long bad = 0;
+        for (uint32_t i = thread; i < n_rows * n_embd; i += blockDim.x) {
+            if (!isfinite(y[i])) ++bad;
+        }
+        if (bad) atomicAdd(&diag_u[1], bad);
+    }
+    __syncthreads();
+
+    if (poison) {
+        const float nan_value = __int_as_float(0x7fc00000);
+        for (uint32_t i = thread; i < n_rows * n_embd; i += blockDim.x) y[i] = nan_value;
+    } else if (diag) {
+        for (uint32_t i = thread; i < n_rows * n_embd; i += blockDim.x) y[i] = 0.0f;
+    }
 }
 
