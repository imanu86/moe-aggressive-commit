+// Contatori e diagnostica del ramo CPU. Chiamata dallo stesso punto di
+// report_hits (dopo il lancio del graph, fuori dalla cattura).
+static void report_cpu() {
+    const auto & opts = cpu_opts();
+    if (!opts.enabled || opts.report <= 0) return;
+    static std::atomic<uint64_t> n_calls{0};
+    if ((n_calls.fetch_add(1, std::memory_order_relaxed) + 1) % (uint64_t) opts.report) return;
+    std::lock_guard<std::mutex> lock(bindings_mutex);
+    bound_group * group = cpu_group.load(std::memory_order_acquire);
+    if (!group) return;
+    moe_grouped_device_scope scope(group->device);
+    CUDA_CHECK(cudaDeviceSynchronize());
+    unsigned long long c[8] = {0};
+    CUDA_CHECK(cudaMemcpy(c, group->counters, sizeof(c), cudaMemcpyDeviceToHost));
+    double acc[4] = {0};
+    unsigned long long du[4] = {0};
+    if (group->diag_acc) CUDA_CHECK(cudaMemcpy(acc, group->diag_acc, sizeof(acc), cudaMemcpyDeviceToHost));
+    if (group->diag_u)   CUDA_CHECK(cudaMemcpy(du,  group->diag_u,   sizeof(du),  cudaMemcpyDeviceToHost));
+    const unsigned long long hits = c[5];
+    const unsigned long long bytes = c[1] * group->words_per_miss * sizeof(uint4);
