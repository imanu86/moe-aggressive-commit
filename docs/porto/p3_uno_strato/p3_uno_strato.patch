+// ---------------------------------------------------------------------------
+// P3 — opzioni di controllo dell'ibrido CPU/GPU.
+//
+// Tutte da AMBIENTE, tutte lette UNA VOLTA SOLA (static locale): cambiarle
+// richiede il riavvio del processo, come stabilito dal piano. Default: spento.
+//
+//   LLAMA_MOE_CPU=0|1            abilitazione generale             (default 0)
+//   LLAMA_MOE_CPU_LAYERS=1[,7]   elenco strati ammessi al ramo CPU (default vuoto = nessuno)
+//   LLAMA_MOE_CPU_MAX=0|1|2      massimo esperti CPU per strato    (default 2)
+//   LLAMA_MOE_CPU_DIAG=0|1       modalita' diagnostica             (default 0)
+//   LLAMA_MOE_CPU_REPORT=N       stampa i contatori ogni N lanci   (default 0 = mai)
+// (LLAMA_MOE_CPU_THREADS, _WAIT_US, _ACK_US sono letti da libllama: riguardano
+//  l'esecutore, non il planner.)
+struct cpu_options {
+    bool     enabled = false;
+    bool     diag    = false;
+    uint32_t cpu_max = 2;
+    int      report  = 0;
+    bool     layer[512] = {};
+};
+
+static const cpu_options & cpu_opts() {
+    static const cpu_options opts = [] {
+        cpu_options o;
+        const char * on = getenv("LLAMA_MOE_CPU");
+        o.enabled = on && strcmp(on, "0") != 0;
+        const char * diag = getenv("LLAMA_MOE_CPU_DIAG");
+        o.diag = diag && strcmp(diag, "0") != 0;
+        const char * mx = getenv("LLAMA_MOE_CPU_MAX");
+        if (mx && *mx) {
+            const int v = atoi(mx);
+            o.cpu_max = v < 0 ? 0 : (v > (int) MOE_CPU_MAX_PER_ROW ? MOE_CPU_MAX_PER_ROW : (uint32_t) v);
+        }
+        const char * rep = getenv("LLAMA_MOE_CPU_REPORT");
+        o.report = rep ? atoi(rep) : 0;
+        const char * layers = getenv("LLAMA_MOE_CPU_LAYERS");
+        if (layers && *layers) {
+            const char * p = layers;
+            while (*p) {
+                char * end = nullptr;
+                const long v = strtol(p, &end, 10);
+                if (end == p) break;
+                if (v >= 0 && v < 512) o.layer[v] = true;
+                p = (*end == ',' || *end == ' ' || *end == ';') ? end + 1 : end;
+            }
+        }
+        return o;
+    }();
+    return opts;
+}
