+    // fondere «wait di L» e «submit di L+1» e' impossibile per ordine di
+    // stream, e metterli insieme al posto del `wait` significherebbe fare il
+    // calcolo CPU DOPO il lavoro GPU dello strato, cioe' buttare via tutta la
+    // concorrenza (progetto P2 §9.2).
+    //
+    // Il risultato chiesto — UN nodo host per strato invece di due — si ottiene
+    // togliendo l'altro: la PUBBLICAZIONE non ha bisogno di un nodo host. La fa
+    // il kernel di export, scrivendo `flags->publish` dopo il proprio fence; il
+    // coordinatore si arma da solo guardando quella cella. Il nodo host che
+    // resta e' quello della regola 3, che nessun meccanismo host puo'
+    // sostituire: e' l'unico modo di ordinare l'`add` dopo la fine del calcolo.
+    //
+    // Invariante 6 (nessun mutex, nessuna API CUDA nel nodo host): il nodo host
+    // del modo fuso legge due parole e blocca su indirizzo, esattamente come il
+    // `wait_hook` di P3. Non prende nessun lock e non chiama nessuna API CUDA.
+    //
+    // Stallo col replay del graph: il nodo host NON attende «il job», attende un
+    // NUMERO — quello che il kernel di export dello stesso strato ha appena
+    // scritto in `publish`. Se quel numero e' gia' stato concluso (strato che
+    // non ha esportato, piano fallito, pool gia' avanti) il nodo ritorna
+    // immediatamente. Un job non pubblicato non ha un numero da attendere, e un
+    // numero pubblicato viene SEMPRE concluso: il kernel di export pubblica
+    // anche quando il piano e' fallito, proprio per non lasciare il nodo host
+    // davanti a un numero che nessuno alzera' mai.
+    void coordinator_loop_fused() {
+        pin(0);
+        uint64_t last = cell_load_acquire(&flags_h->publish.value);
+        seq_taken.store(last, std::memory_order_release);
+        seq_done.store(last, std::memory_order_release);
+        for (;;) {
+            uint64_t seq = last;
+            const uint64_t spin_deadline = caps.fuse_spin_us ? now_us() + caps.fuse_spin_us : 0;
+            for (;;) {
+                if (stopping.load(std::memory_order_acquire)) break;
+                seq = cell_load_acquire(&flags_h->publish.value);
+                if (seq != last) break;
+                const bool decode = phase.load(std::memory_order_relaxed) == (uint32_t) moe_cpu_phase::decode;
+                if (decode && (!spin_deadline || now_us() < spin_deadline)) { MOE_CPU_PAUSE(); continue; }
+                // Fuori dal decode il pool non deve rubare core (D09). Qui non
+                // c'e' nessuno che possa svegliarci — la pubblicazione la scrive
+                // il dispositivo — quindi si dorme a grana di millisecondo.
+                block_until_changed((volatile uint64_t *) &seq_taken,
+                                    seq_taken.load(std::memory_order_relaxed), 1);
+            }
+
+            if (stopping.load(std::memory_order_acquire)) {
+                // Chiusura: si liberano tutti i nodi host eventualmente fermi su
+                // un numero di pubblicazione, poi si pubblica l'esito `stopped`.
+                seq_done.store(cell_load_acquire(&flags_h->publish.value) + 1, std::memory_order_release);
+                wake_waiters((volatile uint64_t *) &seq_done);
+                if (in_flight.load(std::memory_order_acquire) != 0) {
+                    record(gen_current.load(std::memory_order_acquire), moe_cpu_state::stopped);
+                    in_flight.store(0, std::memory_order_release);
+                    wake_waiters((volatile uint64_t *) &in_flight);
+                }
+                publish_flags(moe_cpu_state::stopped);
+                retire();
+                return;
+            }
+
+            last = seq;
+            const uint64_t generation = n_submitted.fetch_add(1, std::memory_order_relaxed) + 1;
+            gen_current.store(generation, std::memory_order_release);
+            job_claim.store(CLAIM_COORD, std::memory_order_release);   // nel modo fuso il coordinatore possiede sempre l'esito
+            record(generation, moe_cpu_state::running);
+            in_flight.store(1, std::memory_order_release);
+            seq_taken.store(seq, std::memory_order_release);
+            cell_store_release(&flags_h->done.value, 0);
+            cell_store_release(&flags_h->poison.value, 0);
+            cell_store_release(&flags_h->result.value, (uint64_t) moe_cpu_state::running);
+
+            moe_cpu_state result = validate_and_prepare();
+            if (result == moe_cpu_state::ok && cancelled.load(std::memory_order_acquire)) {
+                result = moe_cpu_state::cancelled;
+            }
+            if (result == moe_cpu_state::ok) {
+                if (!flat.empty()) {
+                    work.fetch_add(1, std::memory_order_release);
+                    wake_waiters((volatile uint64_t *) &work);
+                    compute(0);
+                } else {
+                    std::memset(y_h, 0, (size_t) cur_rows * (size_t) caps.n_embd * sizeof(float));
+                }
+                if (caps.check_finite && !y_is_finite()) {
+                    // Il controllo che P3 faceva sul DISPOSITIVO leggendo `y`
+                    // attraverso il PCIe. Qui costa una passata su memoria
+                    // locale, e il suo esito arriva alla guardia dentro il
+                    // veleno: `y` non finito non diventa mai una somma.
+                    n_nonfinite.fetch_add(1, std::memory_order_relaxed);
+                    result = moe_cpu_state::rejected;
+                }
+            }
+
+            record(generation, result);
+            n_completed.fetch_add(1, std::memory_order_release);
+            gen_reaped.store(generation, std::memory_order_seq_cst);
+            publish_flags(result);
+            in_flight.store(0, std::memory_order_release);
+            wake_waiters((volatile uint64_t *) &in_flight);
+            // Ultima scrittura: da questo istante il nodo host dello strato puo'
+            // passare. `y` e i flag sono gia' pubblicati (release sopra).
+            seq_done.store(seq, std::memory_order_release);
+            wake_waiters((volatile uint64_t *) &seq_done);
+        }
+    }
+
+    // Blocco vero del nodo host in attesa di una pubblicazione: si dorme
+    // sull'indirizzo di `seq_done`, che il coordinatore sveglia quando lo alza.
+    void block_until_seq(uint64_t want) {
+        const uint64_t seen = seq_done.load(std::memory_order_acquire);
+        if (seen >= want) return;
+        block_until_changed((volatile uint64_t *) &seq_done, seen, 20);
+    }
+
+    bool y_is_finite() const {
+        const size_t n = (size_t) cur_rows * (size_t) caps.n_embd;
+        for (size_t i = 0; i < n; ++i) {
+            if (!std::isfinite(y_h[i])) return false;
+        }
+        return true;
+    }
