+// P4-estensione — l'UNICO nodo host dello strato, nel modo fuso.
+//
+// Legge il numero che il kernel di export dello stesso strato ha appena scritto
+// in `publish` (una parola di memoria host, gia' visibile per ordine di stream)
+// e attende che il coordinatore abbia concluso quel numero. Nessun mutex,
+// nessuna API CUDA, ritorno in tempo finito: invariante 6 intatto.
+void moe_cpu_executor::wait_seq_hook(void * user) {
+    impl * p = ((moe_cpu_executor *) user)->p_.get();
+
+    const uint64_t want = cell_load_acquire(&p->flags_h->publish.value);
+    if (p->seq_done.load(std::memory_order_acquire) >= want) {
+        // Niente da attendere: questo strato non ha pubblicato nulla (ripiego
+        // sul percorso GPU), oppure il pool ha gia' finito. E' la stessa
+        // guardia del `wait_hook` di P3 su `in_flight`, scritta sul numero.
+        return;
+    }
+
+    const uint64_t start      = now_us();
+    const uint64_t spin_until = start + p->caps.spin_us;
+    const uint64_t deadline   = start + p->caps.wait_timeout_us;
+
+    for (;;) {
+        const uint64_t done = p->seq_done.load(std::memory_order_acquire);
+        if (done >= want) return;
+        const uint64_t t = now_us();
+        if (t >= deadline) {
+            // Scadenza. Non si strappa il job al coordinatore (nel modo fuso e'
+            // lui il proprietario unico dell'esito: strapparglielo aprirebbe
+            // proprio la corsa che la macchina a stati di P2 chiude). Si
+            // registra l'esito che CONTAMINA — il decode fallira' sul controllo
+            // di `contaminated()`, prima cintura — e si alza il veleno, cosi'
+            // anche la guardia scrive NaN invece di una somma plausibile.
+            p->record(p->gen_current.load(std::memory_order_acquire), moe_cpu_state::timeout);
+            cell_store_release(&p->flags_h->poison.value, 1);
+            return;
+        }
+        if (t < spin_until) { MOE_CPU_PAUSE(); continue; }
+        p->block_until_seq(want);
+    }
+}
