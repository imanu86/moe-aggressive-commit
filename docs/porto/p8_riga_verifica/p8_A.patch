+// A split costs one graph launch on its backend, one full synchronize of that backend
+// before its inputs are copied, and one copy of every one of its inputs. When the number
+// of inputs reaches the split capacity the splitter opens a new split on the SAME backend
+// (see [TAG_SPLIT_INPUTS_CAP] below), so a graph with many host inputs is cut into several
+// launches for bookkeeping reasons alone. The decode graph of qwen4exp has ~63 of them at
+// two verification rows and is cut in three. Keep 30 as the default and allow a larger
+// value at run time, so both settings can be compared with a single binary.
+static int ggml_sched_max_split_inputs(void) {
+    static int value = -1;
+    if (value < 0) {
+        const char * env = getenv("GGML_SCHED_SPLIT_INPUTS");
+        const int    req = env ? atoi(env) : 0;
+        value = req > 0 ? req : GGML_SCHED_MAX_SPLIT_INPUTS;
+    }
+    return value;
+}
