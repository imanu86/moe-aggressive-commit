+namespace {
+bool g_commit_async = false;
+// STRATA_COMMIT_ASYNC=1 (fork, opt-in): a layer split's commits are asynchronous too (Verifier::split_commit_async)
+const bool g_split_commit_async = [] {
+    const char* v = std::getenv("STRATA_COMMIT_ASYNC");
+    return v != nullptr && std::atoi(v) != 0 && std::getenv("STRATA_COMMIT_SYNC") == nullptr;
+}();
+}  // namespace
 void Verifier::set_commit_async(bool on) { g_commit_async = on && std::getenv("STRATA_COMMIT_SYNC") == nullptr; }
