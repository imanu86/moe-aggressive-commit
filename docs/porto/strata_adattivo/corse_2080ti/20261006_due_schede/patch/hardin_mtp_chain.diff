+    for (int j = 1; ok && j < jmax; ++j) {
+        cudaStreamCaptureStatus cst;
+        cudaGraph_t cg = nullptr;
+        const cudaGraphNode_t* deps = nullptr;
+        const cudaGraphEdgeData* edges = nullptr;
+        size_t nd = 0;
+        cudaGraphConditionalHandle h = 0;
+#if CUDART_VERSION >= 13000
+        auto cap_info = [&] { return cudaStreamGetCaptureInfo(cs_, &cst, nullptr, &cg, &deps, &edges, &nd); };
+#else
+        auto cap_info = [&] { return cudaStreamGetCaptureInfo_v3(cs_, &cst, nullptr, &cg, &deps, &edges, &nd); };
+#endif
+        if (cap_info() != cudaSuccess || cudaGraphConditionalHandleCreate(&h, cg, 0, cudaGraphCondAssignDefault) != cudaSuccess) {
+            why = "conditional handle";
+            ok = false;
+            break;
+        }
+        mtp_chain_gate((unsigned long long) h, m_prob_, j, m_cg_minp_, cs_);
+        if (cap_info() != cudaSuccess) {
+            why = "capture info";
+            ok = false;
+            break;
+        }
+        cudaGraphNodeParams np{};
+        np.type = cudaGraphNodeTypeConditional;
+        np.conditional.handle = h;
+        np.conditional.type = cudaGraphCondTypeIf;
+        np.conditional.size = 1;
+        cudaGraphNode_t cn = nullptr;
+#if CUDART_VERSION >= 13000
+        const bool added = cudaGraphAddNode(&cn, cg, deps, edges, nd, &np) == cudaSuccess &&
+                           cudaStreamUpdateCaptureDependencies(cs_, &cn, nullptr, 1, cudaStreamSetCaptureDependencies) == cudaSuccess;
+#else
+        const bool added = cudaGraphAddNode_v2(&cn, cg, deps, edges, nd, &np) == cudaSuccess &&
+                           cudaStreamUpdateCaptureDependencies_v2(cs_, &cn, nullptr, 1, cudaStreamSetCaptureDependencies) == cudaSuccess;
+#endif
+        if (!added) {
+            why = "conditional node";
+            ok = false;
+            break;
+        }
+        cudaGraph_t body = np.conditional.phGraph_out[0];
+        if (cudaStreamBeginCaptureToGraph(cg_stream_, body, nullptr, nullptr, 0, cudaStreamCaptureModeThreadLocal) != cudaSuccess) {
+            why = "body capture";
+            ok = false;
+            break;
+        }
+        const int row = max_t_ + j - 1;   // capture_step's nodes
+        const MappedCopy sin[2] = {{step_ + row * 4, m_step_ + row * 4, 4},
+                                   {pos_ + row * NH, m_pos_ + row * NH, NH}};
+        copy_from_mapped_multi(sin, 2, cg_stream_);
+        coupled_rec_ = false;
+        coupled_j_ = j;
+        std::string berr;
+        const bool bok = record_forward(1, row, cg_stream_, berr);
+        if (bok) mtp_select(R_, HCN, out_ids_, row_ + 1, Rin_, tok_, m_out_, j, cg_stream_, probs_, m_prob_);
+        cudaGraph_t bg = nullptr;
+        const cudaError_t be = cudaStreamEndCapture(cg_stream_, &bg);   // bg is `body`, owned by the node
+        if (!bok || be != cudaSuccess) {
+            why = !bok ? berr : std::string("body end capture: ") + cudaGetErrorString(be);
+            ok = false;
+            break;
+        }
+    }
+    cudaGraph_t graph = nullptr;
+    const cudaError_t ce = cudaStreamEndCapture(cs_, &graph);
+    cudaGraphExec_t exec = nullptr;
+    if (ok && ce == cudaSuccess && graph != nullptr && cudaGraphInstantiate(&exec, graph, 0) == cudaSuccess) {
+        cudaGraphDestroy(graph);
+        cudaGraphUpload(exec, cs_);
+        cudaStreamSynchronize(cs_);
+        cg_exec_[T] = exec;
+        cg_jmax_[T] = jmax;
+        std::fprintf(stderr, "strata mtp: STRATA_MTP_CHAIN: the %d-row round and its %d-step chain captured as one graph\n",
+                     T, jmax - 1);
+        return true;
+    }
+    if (graph) cudaGraphDestroy(graph);
+    const cudaError_t le = cudaGetLastError();   // clear it: the per-step graphs carry on
+    std::fprintf(stderr, "strata mtp: STRATA_MTP_CHAIN is not available (%s%s%s): one graph per step\n",
+                 why.c_str(), why.empty() ? "" : "; ", cudaGetErrorString(ce != cudaSuccess ? ce : le));
+    cg_failed_ = true;
+    return false;
+#endif
+}
