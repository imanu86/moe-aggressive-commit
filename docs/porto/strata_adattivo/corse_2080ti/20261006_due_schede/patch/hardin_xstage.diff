+// ---- STRATA_XSTAGE (fork, after Hardin22 bce7fbb3's handoff_publish / handoff_take, adapted to this tree's hand-off
+// layout: R | bo | inj2, each contiguous over the window's rows).  The copy is the same bytes; only who waits changes.
+namespace {
+template <typename V>
+__device__ __forceinline__ V xstage_load(const V* p) {
+#if defined(__HIPCC__)
+    return *p;
+#else
+    return __ldcv(p);   // mapped memory another GPU wrote: no cached copy
+#endif
+}
+template <typename V>
+__global__ void xstage_publish_kernel(const V* __restrict__ R, const V* __restrict__ bo, const V* __restrict__ inj,
+                                      long long a, long long b, long long c, V* hand, uint32_t* flag,
+                                      unsigned int* counter) {
+    const long long total = a + b + c;
+    for (long long i = (long long) blockIdx.x * blockDim.x + threadIdx.x; i < total;
+         i += (long long) gridDim.x * blockDim.x) {
+        V v;
+        if (i < a) v = R[i];
+        else if (i < a + b) v = bo[i - a];
+        else v = inj[i - a - b];
+        hand[i] = v;
+    }
+    __threadfence_system();   // this thread's stores, before its block counts itself done
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        const unsigned int prev = atomicAdd(counter, 1u);
+        if (prev == gridDim.x - 1) {   // the last block: every block's stores are visible
+            *counter = 0u;
+            __threadfence_system();
+            *(volatile uint32_t*) flag = 1u;
+            __threadfence_system();
+        }
+    }
+}
+template <typename V>
+__global__ void xstage_take_kernel(const V* hand, long long a, long long b, long long c, V* __restrict__ R,
+                                   V* __restrict__ bo, V* __restrict__ inj) {
+    const long long total = a + b + c;
+    for (long long i = (long long) blockIdx.x * blockDim.x + threadIdx.x; i < total;
+         i += (long long) gridDim.x * blockDim.x) {
+        const V v = xstage_load(hand + i);
+        if (i < a) R[i] = v;
+        else if (i < a + b) bo[i - a] = v;
+        else inj[i - a - b] = v;
+    }
+}
+bool xstage_vec4(const void* p0, const void* p1, const void* p2, const void* p3, int64_t a, int64_t b, int64_t c) {
+    const uintptr_t m = (uintptr_t) p0 | (uintptr_t) p1 | (uintptr_t) p2 | (uintptr_t) p3;
+    return (m & 15u) == 0 && ((a | b | c) & 3) == 0;
+}
+}  // namespace
+
+void xstage_publish(const float* R, const float* bo, const float* inj2, int64_t nR, int64_t nbo, int64_t ninj,
+                    float* hand_out, uint32_t* flag, unsigned int* counter, void* stream) {
+    if (xstage_vec4(R, bo, inj2, hand_out, nR, nbo, ninj))
+        xstage_publish_kernel<float4><<<32, 256, 0, (cudaStream_t) stream>>>(
+            (const float4*) R, (const float4*) bo, (const float4*) inj2, nR / 4, nbo / 4, ninj / 4, (float4*) hand_out,
+            flag, counter);
+    else
+        xstage_publish_kernel<float><<<32, 256, 0, (cudaStream_t) stream>>>(R, bo, inj2, nR, nbo, ninj, hand_out, flag,
+                                                                           counter);
+    check("xstage_publish");
+}
+
+void xstage_take(const float* hand_in, int64_t nR, int64_t nbo, int64_t ninj, float* R, float* bo, float* inj2,
+                 void* stream) {
+    if (xstage_vec4(hand_in, R, bo, inj2, nR, nbo, ninj))
+        xstage_take_kernel<float4><<<64, 256, 0, (cudaStream_t) stream>>>(
+            (const float4*) hand_in, nR / 4, nbo / 4, ninj / 4, (float4*) R, (float4*) bo, (float4*) inj2);
+    else
+        xstage_take_kernel<float><<<64, 256, 0, (cudaStream_t) stream>>>(hand_in, nR, nbo, ninj, R, bo, inj2);
+    check("xstage_take");
+}
