new file mode 100644
index 00000000..9436393d
--- /dev/null
+++ b/include/strata/core/turing_compat.cuh
@@ -0,0 +1,21 @@
+// Local Turing (sm_75) port: what sm_80 has as one instruction, done otherwise below sm_80.
+#pragma once
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ < 800
+// warp reductions by shuffles
+template <class T> __device__ __forceinline__ T sf_rmax(unsigned m, T v) {
+    for (int o = 16; o; o >>= 1) { const T u = __shfl_xor_sync(m, v, o); v = u > v ? u : v; }
+    return v;
+}
+template <class T> __device__ __forceinline__ T sf_rmin(unsigned m, T v) {
+    for (int o = 16; o; o >>= 1) { const T u = __shfl_xor_sync(m, v, o); v = u < v ? u : v; }
+    return v;
+}
+#define __reduce_max_sync(m, v) sf_rmax((m), (v))
+#define __reduce_min_sync(m, v) sf_rmin((m), (v))
+// cp.async as plain copies: the same data in shared memory at the same barriers, without the overlap
+#define SF_CP_COMMIT() ((void) 0)
+#define SF_CP_WAIT(n) ((void) 0)
+#else
+#define SF_CP_COMMIT() asm volatile("cp.async.commit_group;\n" ::)
+#define SF_CP_WAIT(n) asm volatile("cp.async.wait_group " #n ";\n" ::)
+#endif
