+        ggml_backend_dev_t dev = ggml_backend_get_device(compute);
+        size_t free_bytes = 0, total_bytes = 0;
+        ggml_backend_dev_memory(dev, &free_bytes, &total_bytes);
+        const size_t reserve = 512ull * 1024 * 1024;
+        if (free_bytes < reserve || max_size > (free_bytes - reserve)/2) {
+            GGML_LOG_INFO("qwen_prefetch: skipped, insufficient free VRAM for %zu MiB plus reserve\n", 2*max_size/1024/1024);
