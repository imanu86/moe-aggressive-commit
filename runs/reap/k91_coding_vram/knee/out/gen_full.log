<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bean & Brew</title>
    <style>
        /* minimal styling — about 12 rules */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: system-ui, sans-serif; background: #faf7f2; color: #2c2c2c; }
        nav { background: #4e3629; padding: 0.8rem 1.5rem; display: flex; gap: 1.5rem; }
        nav a { color: #f5e6d3; text-decoration: none; font-weight: 500; }
        nav a:hover { color: #fff; }
        .hero { background: #d9b99c; padding: 3rem 1.5rem; text-align: center; }
        .hero h1 { font-size: 2.5rem; color: #2c1e14; margin-bottom: 0.3rem; }
        .hero p { font-size: 1.1rem; color: #3d2b1f; }
        #order { margin-top: 1.2rem; padding: 0.7rem 2rem; font-size: 1.1rem;
            background: #2c1e14; color: #f5e6d3; border: none; border-radius: 6px; cursor: pointer; }
        #order:hover { background: #4e3629; }
        form { max-width: 400px; margin: 2rem auto; padding: 1.5rem; background: #fff;
            border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        form label { display: block; margin-bottom: 0.3rem; font-weight: 500; }
        form input { width: 100%; padding: 0.5rem; margin-bottom: 1rem; border: 1px solid #ccc;
            border-radius: 6px; }
        form button { background: #4e3629; color: #f5e6d3; border: none; padding: 0.6rem 1.5rem;
            border-radius: 6px; cursor: pointer; font-size: 1rem; }
        form button:hover { background: #2c1e14; }
        footer { text-align: center; padding: 1rem; color: #5a4a3a; font-size: 0.9rem; }
    </style>
</head>
<body>
    <!-- navigation -->
    <nav>
        <a href="#">Home</a>
        <a href="#">Menu</a>
        <a href="#">Contact</a>
    </nav>

    <!-- hero section -->
    <section class="hero">
        <h1>Bean & Brew</h1>
        <p>Freshly roasted · crafted with care</p>
        <button id="order">Order Now</button>
    </section>

    <!-- contact form -->
    <form id="contactForm" action="/submit" method="POST">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required placeholder="Your name">

        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="you@example.com">

        <button type="submit">Send message</button>
    </form>

    <footer>© Bean & Brew</footer>

    <script>
        // order button alert
        document.getElementById('order').addEventListener('click', function() {
            alert('Thank you for your order!');
        });

        // form handler with preventDefault and confirmation
        document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();
            alert('Thank you, we received your message!');
        });
    </script>
</body>
</html>
