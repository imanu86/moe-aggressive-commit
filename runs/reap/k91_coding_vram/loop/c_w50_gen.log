    /* ----- theme variables ----- */
    :root {
      --bg: #ffffff;
      --text: #000;
      --nav-bg: #light;
      --hero-bg: #fff;
      --card-bg: #fff;
      --border-color: #light;
      --primary-btn-bg: #blue;
      --primary-btn-text: #white;
      --ac1: #blue;
    }

    /* dark mode class later applied via JS */
    body.dark {
      --bg: #12130;
      --text: #gray-100;
      --nav-bg: #dark-sone;
      --hero-bg: #12130;
      --card-bg: #12130;
      --border-color: #gray-700;
      --primary-btn-bg: #blue-500;
      --primary-btn-text: #white;
    }

    /* ----- navigation ----- */
    nav {
      background: var(--nav-bg, #fff);
      border-bottom: 1px solid var(--border-color, #gray-200);
      padding: 0.5rem 1rem;
      display: flex;
      justify-content: center;
      align-items: center;
      transition: background 0.3s, border-color 0.3s;
    }

    .nav-l {
      list-style: none;
      display: flex;
      gap: 2rem;
      margin: 0;
      padding: 0;
    }

    .nav-l li a {
      text-decoration: none;
      color: var(--text, #dark);
      font-weight 600;
      padding: 0.5rem 0.5rem;
      transition: color 0.3s;
    }

    .nav-l li a:hover {
      color: var(--ac1, #blue);
    }

    /* ----- hero section ----- */
    .hero {
      background: var(--hero-bg, #fff);
      padding: 8rem 2rem;
      text-align: center;
      transition: background 0.3s;
    }

    .hero h1 {
      font-size: 3rem;
      margin-bottom: 0.5rem;
    }

    .hero p {
      font-size: 1.5rem;
      max-width: 600;
      margin: 0 auto 1rem;
    }

    .hero .cta-btn {
      background: var(--primary-btn-bg, #blue);
      color: var(--primary-btn-text, #white);
      border: none;
      padding: 0.5rem 2rem;
      font-size: 1.5rem;
      border-radius: 4px;
      cursor: pointer;
      transition: background 0.3s, color 0.3s;
    }

    .hero .cta-btn:hover {
      background: var(--ac1, #blue-700);
    }

    /* ----- contact form ----- */
    .form-section {
      padding: 2rem 2rem;
      display: flex;
      justify-content: center;
      background: var(--bg, #fff);
      transition: background 0.3s;
    }

    .form-card {
      max-width: 450;
      width: 100%;
      background: var(--card-bg, #fff);
      padding: 2rem;
      border-radius: 8px;
      border: 1px solid var(--border-color, #gray-200);
      transition: background 0.3s, border-color 0.3s;
    }

    .form-card h2 {
      margin-bottom: 1rem;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight 600;
    }

    input, textarea {
      width: 100%;
      padding: 0.5rem;
      border: 1px solid var(--border-color, #gray-200);
      border-radius: 4px;
      background: var(--bg, #fff);
      color: var(--text, #dark);
      transition: background 0.3s, border-color 0.3s;
    }

    textarea {
      rows: 4;
      resize: vertical;
    }

    .error-m {
      margin-top: 0.5rem;
      color: red;
      font-size: 0.5rem;
      display: none;
    }

    .error-m.show {
      display: block;
    }

    .submit-btn {
      background: var(--primary-btn-bg, #blue);
      color: var(--primary-btn-text, #white);
      border: none;
      padding: 0.5rem 2rem;
      font-size: 1rem;
      border-radius: 4px;
      cursor: pointer;
      transition: background 0.3s;
    }

    .submit-btn:hover {
      background: var(--ac1, #blue-700);
    }

    /* ----- theme toggle button ----- */
    .theme-toggle {
      position: fixed;
      bottom: 1rem;
      right: 1rem;
      background: var(--primary-btn-bg, #blue);
      color: var(--primary-btn-text, #white);
      border: none;
      padding: 0.5rem 1rem;
      font-size: 1rem;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.3s, color 0.3s;
      z-index: 100;
    }

    .theme-toggle:hover {
      background: var(--ac1, #blue-700);
    }

    /* ----- footer ----- */
    footer {
      text-align: center;
      padding: 1rem;
      background: var(--nav-bg, #fff);
      border-top: 1px solid var(--border-color, #gray-200);
      transition: background 0.3s, border-color 0.3s;
    }

    /* ----- utilities ----- */
    .container {
      max-width: 800;
      margin: 0 auto;
      width: 100%;
    }

    /* ----- responsive ----- */
    @media (max-width: 600px) {
      .nav-l {
        gap: 0.5rem;
        flex-wrap: wrap;
        justify-content: center;
      }
      .hero h1 {
        font-size: 2rem;
      }
    }
