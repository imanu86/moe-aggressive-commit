<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>One‑file · Light+Dark</title>
    <!-- clean, minimal styles + theme variables -->
    <style>
        /* ----- reset / base ----- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: system-ui, -apple-system, 'ds4: CUDA loading model tensors 7.86 GiB cached
Segoe UI', Roboto, sans-serif;
            line-height: 1.5;
            /* default light theme */
            --bg: #f8fafc;
            --text: #0f172a;
            --nav-bg: #e2e8f0;
            --nav-link: #0f172a;
            --hero-bg: #d9e2f0;
            --hero-headline: #0f172a;
            --hero-sub: #334155;
            --btn-bg: #2563eb;
            --btn-text: #f8fafc;
            --card-bg: #ffffff;
            --border: #cbd5e1;
            --error: #dc2626;
            --footer-bg: #e2e8f0;
            transition: background-color 0.25s, color 0.25s, border-color 0.25s;
        }

        /* ----- dark theme (applied via .dark-theme on body) ----- */
        body.dark-theme {
            --bg: #1e293b;
            --text: #f1f5f9;
            --nav-bg: #334155;
            --nav-link: #f1f5f9;
            --hero-bg: #2d3a4f;
            --hero-headline: #f1f5f9;
            --hero-sub: #cbd5e1;
            --btn-bg: #60a5fa;
            --btn-text: #1e293b;
            --card-bg: #2d3a4f;
            --border: #475569;
            --error: #fca5a5;
            --footer-bg: #334155;
        }

        /* ----- layout / components ----- */
        body {
            background-color: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* navigation */
        nav {
            background: var(--nav-bg);
            padding: 0.8rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border);
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            color: var(--nav-link);
            text-decoration: none;
            font-weight: 500;
            padding: 0.3rem 0.2rem;
            border-bottom: 2px solid transparent;
            transition: border-color 0.2s;
        }

        .nav-links a:hover {
            border-bottom-color: var(--btn-bg);
        }

        .theme-toggle {
            background: var(--card-bg);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 0.4rem 1rem;
            border-radius: 40px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s, border-color 0.2s;
        }

        .theme-toggle:hover {
            background: var(--hero-bg);
        }

        /* hero */
        .hero {
            background: var(--hero-bg);
            padding: 4rem 2rem;
            text-align: center;
            border-bottom: 1px solid var(--border);
        }

        .hero h1 {
            font-size: 2.8rem;
            margin-bottom: 0.5rem;
            color: var(--hero-headline);
        }

        .hero p {
            font-size: 1.2rem;
            max-width: 480px;
            margin: 0 auto 1.8rem;
            color: var(--hero-sub);
        }

        .hero .cta {
            background: var(--btn-bg);
            color: var(--btn-text);
            border: none;
            padding: 0.9rem 2.5rem;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 40px;
            cursor: pointer;
            transition: transform 0.1s, filter 0.2s;
            box-shadow: 0 4px 8px rgba(0,0,0,0.05);
        }

        .hero .cta:hover {
            filter: brightness(1.1);
            transform: scale(1.02);
        }

        /* main content (contact form) */
        .main-content {
            flex: 1;
            max-width: 700px;
            margin: 2rem auto;
            padding: 0 2rem;
            width: 100%;
        }

        .form-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 2rem 2.2rem;
            box-shadow: 0 8px 20px rgba(0,0,0,0.03);
        }

        .form-card h2 {
            margin-bottom: 1.2rem;
            font-size: 1.8rem;
        }

        .form-group {
            margin-bottom: 1.2rem;
        }

        label {
            display: block;
            margin-bottom: 0.3rem;
            font-weight: 500;
        }

        input, textarea {
            width: 100%;
            padding: 0.7rem 0.8rem;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--bg);
            color: var(--text);
            font-size: 1rem;
            transition: border-color 0.2s;
        }

        input:focus, textarea:focus {
            outline: 2px solid var(--btn-bg);
            outline-offset: 2px;
        }

        textarea {
            min-height: 120px;
            resize: vertical;
        }

        .error-message {
            color: var(--error);
            font-size: 0.9rem;
            margin-top: 0.3rem;
            min-height: 1.2rem;
        }

        .submit-btn {
            background: var(--btn-bg);
            color: var(--btn-text);
            border: none;
            padding: 0.8rem 2rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 40px;
            cursor: pointer;
            margin-top: 0.5rem;
            transition: filter 0.2s;
        }

        .submit-btn:hover {
            filter: brightness(1.1);
        }

        /* footer */
        footer {
            background: var(--footer-bg);
            text-align: center;
            padding: 1.2rem 2rem;
            border-top: 1px solid var(--border);
            font-size: 0.95rem;
        }

        /* responsive */
        @media (max-width: 480px) {
            nav {
                flex-wrap: wrap;
                gap: 0.8rem;
            }
            .nav-links {
                gap: 1rem;
                flex-wrap: wrap;
            }
            .hero h1 {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <!--  top navigation bar (three links) + theme toggle -->
    <nav>
        <ul class="nav-links">
            <li><a href="#">Home</a></li>
            <li><a href="#">About</a></li>
            <li><a href="#">Contact</a></li>
        </ul>
        <button class="theme-toggle" id="themeToggle">🌙 Dark</button>
    </nav>

    <!-- hero section -->
    <section class="hero">
        <h1>Build something great</h1>
        <p>Clean, responsive, and ready for your next project. Light or dark, you choose.</p>
        <button class="cta" id="heroCta">Get started</button>
    </section>

    <!-- contact form with validation -->
    <main class="main-content">
        <div class="form-card">
            <h2>✉️ Contact us</h2>
            <form id="contactForm" novalidate>
                <!-- name -->
                <div class="form-group">
                    <label for="name">Full name</label>
                    <input type="text" id="name" name="name" placeholder="Jane Doe">
                    <div class="error-message" id="nameError"></div>
                </div>
                <!-- email -->
                <div class="form-group">
                    <label for="email">Email address</label>
                    <input type="email" id="email" name="email" placeholder="jane@example.com">
                    <div class="error-message" id="emailError"></div>
                </div>
                <!-- message -->
                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" placeholder="Write something..."></textarea>
                    <div class="error-message" id="msgError"></div>
                </div>

                <button type="submit" class="submit-btn">Send message</button>
            </form>
            <!-- optional success message (inline) -->
            <p id="formSuccess" style="margin-top: 1rem; font-weight: 500; min-height: 1.5rem; color: var(--text);"></p>
        </div>
    </main>

    <!-- small footer -->
    <footer>
        <span>© 2025 · light/dark demo</span>
    </footer>

