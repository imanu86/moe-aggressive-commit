        .theme-toggle {
            background: #eee;
            border: 1px solid #ccc;
            padding: 0.4rem 1rem;
            border-radius: 30px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s, border 0.2s, color 0.2s;
            font-size: 0.9rem;
        }

        .theme-toggle:hover {
            background: #ddd;
        }

