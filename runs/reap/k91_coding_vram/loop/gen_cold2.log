        }

        .error-message {
            color: #b22222;
            font-size: 0.9rem;
            margin-top: 0.3rem;
            min-height: 1.2rem;
        }

        .submit-btn {
            background: #1e1e1e;
            color: #f9f9f9;
            border: none;
            padding: 0.7rem 2rem;
            font-size: 1rem;
            font-weight: 500;
            border-radius: 40px;
            cursor: pointer;
            transition: background 0.2s;
            margin-top: 0.4rem;
        }

        .submit-btn:hover {
            background: #333;
        }

        body.dark .submit-btn {
            background: #f1f1f1;
            color: #1e1e1e;
        }

        body.dark .submit-btn:hover {
            background: #ddd;
        }

        /* ----- footer / spacing ----- */
        .footer-note {
            text-align: center;
            margin: 2.5rem 0 1.5rem;
            opacity: 0.6;
            font-size: 0.9rem;
        }

        /* responsive */
        @media (max-width: 480px) {
            .navbar {
                flex-direction: column;
                align-items: stretch;
                gap: 0.6rem;
            }
            .nav-links {
                justify-content: center;
                gap: 1.2rem;
            }
            .hero h1 {
                font-size: 2rem;
            }
        }
    </style>
