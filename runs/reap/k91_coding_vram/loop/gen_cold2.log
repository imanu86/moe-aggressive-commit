    <!--  top navigation bar with at least three links  -->
    <nav class="navbar">
        <div class="nav-links">
            <a href="#">Home</a>
            <a href="#">About</a>
            <a href="#">Services</a>
            <a href="#">Contact</a>
        </div>
        <!-- light/dark theme toggle button -->
        <button class="theme-toggle" id="themeToggle">🌙 Dark</button>
    </nav>

    <!--  hero section  -->
    <section class="hero">
        <h1>Build something great</h1>
        <p>Simple, clean, and ready to adapt. Your next project starts here.</p>
        <button class="cta-button" id="heroCTA">Get started</button>
    </section>

    <!--  contact form with validation  -->
    <div class="card">
        <h2>✉️ Contact us</h2>
        <form id="contactForm">
            <div class="form-group">
                <label for="name">Name</label>
                <input type="text" id="name" name="name" placeholder="Your name">
                <div class="error-message" id="nameError"></div>
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="you@example.com">
                <div class="error-message" id="emailError"></div>
            </div>

            <div class="form-group">
                <label for="message">Message</label>
                <textarea id="message" name="message" placeholder="Write something..."></textarea>
                <div class="error-message" id="messageError"></div>
            </div>

            <button type="submit" class="submit-btn">Send message</button>
        </form>
        <!-- optional success message (inline) -->
        <p style="margin-top: 1rem; font-size: 0.95rem; min-height: 1.5rem;" id="formFeedback"></p>
    </div>

    <div class="footer-note">✨ light/dark toggle · client-side validation</div>

