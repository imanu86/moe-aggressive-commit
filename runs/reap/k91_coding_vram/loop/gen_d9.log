        /* ----- light theme (default ----- */
        :root {
            --bg: #f5f7fa;
            --text: #1a1a1a;
            --nav-bg: #ffffff;
            --nav-shadow: 0 2px 4px rgba(0,0,0,0.08);
            --hero-bg: #e8f0ff;
            --hero-text: #0b223f;
            --card-bg: #ffffff;
            --border: #d1d9e6;
            --button-primary: #0066cc;
            --button-primary-text: #ffffff;
            --error-bg: #ffe9e9;
            --error-text: #b01a1a;
        }

        /* ----- dark theme ----- */
        [data-theme="dark"] {
            --bg: #12161f;
            --text: #e7eaee;
            --nav-bg: #1f2a3a;
            --nav-shadow: 0 2px 4px rgba(0,0,0,0.5);
            --hero-bg: #2a3f4d;
            --hero-text: #dae6f0;
            --card-bg: #2a3b3f;
            --border: #5f6d7a;
            --button-primary: #99caff;
            --button-primary-text: #0a1a1f;
            --error-bg: #3d2a2a;
            --error-text: #ffb3b3;
        }

        /* ----- layout ----- */
        .page {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
            width: 100%;
            flex: 1;
        }

        /* ----- navigation ----- */
        .topnav {
            background: var(--nav-bg);
            box-shadow: 0 2px 4px var(--nav-shadow);
            padding: 0.5rem 1.5rem;
            border-radius: 0 0 2px 2px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            transition: background 0.3s, box-shadow 0.3s;
        }

        .topnav-links {
            display: flex;
            gap: 2.5rem;
            list-style: none;
            flex-wrap: wrap;
        }

        .topnav-links a {
            text-decoration: none;
            color: var(--text);
            font-weight: 500;
            padding: 0.5rem 0.2rem;
            border-bottom: 2px solid transparent;
            transition: border-color 0.2s, color 0.2s;
        }

        .topnav-links a:hover {
            border-bottom-color: var(--button-primary);
            color: var(--button-primary);
        }

        .theme-toggle {
            background: transparent;
            border: 1px solid var(--border);
            padding: 0.5rem 1.2rem;
            border-radius: 2px;
            font-weight: 600;
            font-size: 1.2rem;
            cursor: pointer;
            background-color: var(--card-bg);
            color: var(--text);
            transition: background 0.2s, border 0.2s;
        }

        .theme-toggle:hover {
            background: var(--hero-bg);
        }

        /* ----- hero section ----- */
        .hero {
            background: var(--hero-bg);
            color: var(--hero-text);
            padding: 4rem 2rem;
            margin: 2.5rem 0;
            border-radius: 2px;
            text-align: center;
            transition: background 0.3s, color 0.3s;
        }

        .hero h1 {
            font-size: 3.2rem;
            margin-bottom: 0.5rem;
        }

        .hero p {
            font-size: 1.5rem;
            max-width: 40ch;
            margin: 0 auto 1.5rem;
            opacity: 0.9;
        }

        .hero .cta-button {
            background: var(--button-primary);
            color: var(--button-primary-text);
            border: none;
            padding: 1.2rem 2.5rem;
            font-size: 1.5rem;
            font-weight: 600;
            border-radius: 2px;
            cursor: pointer;
            transition: filter 0.2s, transform 0.1s;
            box-shadow: 0 2px 2px rgba(0,0,0,0.15);
        }

        .hero .cta-button:hover {
            filter: brightness(1.25);
            transform: scale(1.02);
        }

        /* ----- contact form ----- */
        .contact-form {
            background: var(--card-bg);
            border: 1px solid var(--border);
            padding: 2.5rem 2.2rem;
            border-radius: 2px;
            margin: 2.5rem 0;
            transition: background 0.3s, border 0.3s;
        }

        .contact-form h2 {
            margin-bottom: 1.5rem;
            font-size: 2.2rem;
        }

        .form-group {
            margin-bottom: 1.2rem;
        }

        label {
            display: block;
            margin-bottom: 0.25rem;
            font-weight: 500;
        }

        input, textarea {
            width: 100%;
            padding: 0.5rem 0.7rem;
            font-size: 1.2rem;
            border: 1px solid var(--border);
            border-radius: 2px;
            background: var(--bg);
            color: var(--text);
            transition: border 0.2s, background 0.2s;
        }

        input:focus, textarea:focus {
            outline: 2px solid var(--button-primary);
            outline-offet: 2px;
        }

        textarea {
            min-height: 150px;
            resize: vertical;
        }

        .error-message {
            background: var(--error-bg);
            color: var(--error-text);
            padding: 0.5rem 1.2rem;
            border-radius: 2px;
            margin: 1.2rem 0 0;
            font-weight: 500;
            display: none;  /* hidden by JS */
        }

        .error-message.show {
            display: block;
        }

        .submit-button {
            background: var(--button-primary);
            color: var(--button-primary-text);
            border: none;
            padding: 1.2rem 2.5rem;
            font-size: 1.3rem;
            font-weight: 600;
            border-radius: 2px;
            cursor: pointer;
            margin-top: 1.2rem;
            transition: filter 0.2s;
        }

        .submit-button:hover {
            filter: brightness(1.25);
        }

        /* ----- footer / spacing ----- */
        .footer {
            text-align: center;
            padding: 1.5rem 0;
            margin-top: auto;
            border-top: 1px solid var(--border);
            color: var(--text);
            opacity: 0.7;
            font-size: 0.9rem;
        }

        /* ----- responsive ----- */
        @media (max-width: 600px) {
            .topnav-links {
                gap: 1.5rem;
                margin-bottom: 0.5rem;
            }
            .hero h1 { font-size: 2.8rem; }
        }
    </style>
</head>
