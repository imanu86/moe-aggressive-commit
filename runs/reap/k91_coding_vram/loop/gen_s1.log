        body.dark .navbar a {
            color: #e0e0e0;
        }

        body.dark .hero {
            background: #2a2a2a;
            border-radius: 2px;
        }

        body.dark .hero .btn {
            background: #3a7bd5;
            color: #fff;
        }

        body.dark .form-group input,
        body.dark .form-group textarea {
            background: #2e2e2e;
            border: 1px solid #555;
            color: #e0e0e0;
        }

        body.dark .form-group input:focus,
        body.dark .form-group textarea:focus {
            border-color: #7aa7ff;
            outline: none;
        }

        body.dark .error-message {
            color: #ff8b8b;
        }

        /* ----- layout & components ----- */
        .navbar {
            background: #f6f6f6;
            padding: 0.8rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #ddd;
            transition: background 0.3s;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            text-decoration: none;
            color: #1a1a1a;
            font-weight: 500;
            padding: 0.5rem 0.2rem;
            border-radius: 2px;
            transition: background 0.2s;
        }

        .nav-links a:hover {
            background: rgba(0, 0, 0, 0.1);
        }

        .theme-toggle {
            background: transparent;
            border: 1px solid currentColor;
            padding: 0.5rem 1.2rem;
            font-size: 1rem;
            font-weight: 500;
            border-radius: 2px;
            cursor: pointer;
            transition: background 0.2s, color 0.2s;
        }

        .theme-toggle:hover {
            background: rgba(0, 0, 0, 0.1);
        }

        body.dark .theme-toggle {
            border-color: #bbb;
            color: #eee;
        }

        /* ----- hero section ----- */
        .hero {
            background: #f0f9ff;
            padding: 4rem 2rem;
            text-align: center;
            transition: background 0.3s;
        }

        .hero h1 {
            font-size: 3rem;
            margin-bottom: 0.3rem;
        }

        .hero p {
            font-size: 1.2rem;
            max-width: 600px;
            margin: 0 auto 2rem;
            opacity: 0.8;
        }

        .hero .btn {
            display: inline-block;
            background: #1a1a1a;
            color: white;
            padding: 1rem 2.5rem;
            font-size: 1.2rem;
            font-weight: 600;
            border: none;
            border-radius: 2px;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.2s, transform 0.1s;
        }

        .hero .btn:hover {
            background: #333;
            transform: scale(95);
        }

        body.dark .hero .btn {
            background: #3a7bd5;
        }

        /* ----- contact form ----- */
        .form-section {
            padding: 2rem 2rem;
            max-width: 600px;
            margin: 2rem auto;
            width: 100%;
        }

        .form-section h2 {
            margin-bottom: 1.5rem;
        }

        .form-group {
            margin-bottom: 1.2rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.3rem;
            font-weight: 500;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 0.8rem 0.5rem;
            border: 1px solid #ccc;
            border-radius: 2px;
            font-size: 1rem;
            background: #fff;
            transition: border 0.2s, background 0.2s;
        }

        .form-group textarea {
            min-height: 150px;
            resize: vertical;
        }

        .error-message {
            color: #b33333;
            font-size: 0.9rem;
            margin-top: 0.2rem;
        }

        .form .btn {
            background: #1a1a1a;
            color: white;
            padding: 0.8rem 2rem;
            font-size: 1rem;
            font-weight: 600;
            border: none;
            border-radius: 2px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .form .btn:hover {
            background: #333;
        }

        body.dark .form .btn {
            background: #3a7bd5;
        }

        /* ----- footer / spacing ----- */
        footer {
            margin-top: auto;
            padding: 1rem 2rem;
            text-align: center;
            border-top: 1px solid #ddd;
            font-size: 0.9rem;
        }

        body.dark footer {
            border-color: #444;
        }

        /* responsive */
        @media (max-width: 600px) {
            .navbar {
                flex-direction: column;
                gap: 0.5rem;
            }
            .nav-links {
                flex-wrap: wrap;
                justify-content: center;
            }
            .hero h1 {
                font-size: 2.2rem;
            }
        }
    </style>
