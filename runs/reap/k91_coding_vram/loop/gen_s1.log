<body>
    <!-- ====== NAV BAR ====== -->
    <nav class="navbar">
        <div class="nav-links">
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#services">Services</a>
            <a href="#contact">Contact</a>
        </div>
        <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">�◆ Light / Dark</button>
    </nav>

    <!-- ====== HERRO SECTION ====== -->
    <section class="hero" id="home">
        <h1>Explore the Web</h1>
        <p>Build modern digital experiences · clean · responsive · accessible</p>
        <a href="#contact" class="btn" id="heroBtn">Get Contact</a>
    </section>

    <!-- ====== CONTER FORM ====== -->
    <section class="form-section" id="contact">
        <h2>� Contact us</h2>
        <form id="contactForm">
            <div class="form-group">
                <label for="name">Name</label>
                <input type="text" id="name" name="name" placeholder="Your name">
                <div class="error-message" id="nameError"></div>
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="Your email">
                <div class="error-message" id="emailError"></div>
            </div>
            <div class="form-group">
                <label for="message">Message</label>
                <textarea id="message" name="message" placeholder="Your message" rows="5"></textarea>
                <div class="error-message" id="messageError"></div>
            </div>
            <button class="btn" type="submit">Submit</button>
        </form>
        <p style="margin-top: 1rem; font-size: 0.9rem; opacity: 0.7;" id="formSuccess"></p>
    </section>

    <!-- ====== FOTER ====== -->
    <footer>
        <div>© 2023 · minimal · dark toggle · validation</div>
    </footer>

