</head>
<body>
  <div class="container">
    <!-- Navigation Bar -->
    <nav>
      <a href="#home">Home</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>

    <!-- Hero Section -->
    <div class="hero">
      <h1>Welcome to Our Platform</h1>
      <p>Discover insights, build skills, and connect with a community that grows together.</p>
      <button>Get Started Now</button>
    </div>

    <!-- Contact Form -->
    <div class="contact-form">
      <h3>Contact Us</h3>
      <form id="contactForm">
        <label>Name:</label>
        <input type="text" id="name" placeholder="Your name" required>

        <label>Email:</label>
        <input type="email" id="email" placeholder="your@email.com" required>

        <label>Message:</label>
        <textarea id="message" placeholder="Write your message here" required>

        <div class="error" id="formError"> </div>

        <button type="submit">Send Message</button>
      </form>
    </div>

    <!-- Theme Toggle -->
    <div class="theme-toggle">
      <button id="themeBtn">Toggle Theme</button>
    </div>
  </div>

  <script>
    (function() {
      'use strict';

      // --- Theme Toggle ---
      const themeBtn = document.getElementById('themeBtn');
      let darkMode = false;

      themeBtn.addEventListener('click', function() {
        darkMode = !darkMode;
        document.documentElement.setAttribute('data-theme', darkMode ? 'dark' : 'light');
        themeBtn.textContent = darkMode ? 'Switch to Light' : 'Switch to Dark';
      });

      // --- Contact Form Validation ---
      const form = document.getElementById('contactForm');
      const nameInput = document.getElementById('name');
      const emailInput = document.getElementById('email');
      const messageInput = document.getElementById('message');
      const errorDiv = document.getElementById('formError');

      form.addEventListener('submit', function(event) {
        event.preventDefault();
        let errorMsg = '';

        // Name validation
        const name = nameInput.value.trim();
        if (name === '') {
          errorMsg += 'Name cannot be empty. ';
        }

        // Email validation
        const email = emailInput.value.trim();
        if (email === '') {
          errorMsg += 'Email cannot be empty. ';
        } else {
          // Basic email format check
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(email)) {
            errorMsg += 'Please enter a valid email address. ';
          }
        }

        // Message validation
        const message = messageInput.value.trim();
        if (message === '') {
          errorMsg += 'Message cannot be empty.';
        }

        // Show error or success
        if (errorMsg !== '') {
          errorDiv.textContent = errorMsg;
          errorDiv.style.display = 'block';
        } else {
          errorDiv.textContent = 'Form submitted successfully!';
          errorDiv.style.display = 'block';
          // Optionally clear fields
          nameInput.value = '';
          emailInput.value = '';
          messageInput.value = '';
          // Hide success after 3 seconds
          setTimeout(() => {
            errorDiv.style.display = 'none';
          }, 3000);
        }
      });

      // Extra: clear error on input focus
      [nameInput, emailInput, messageInput].forEach(el => {
        el.addEventListener('focus', () => {
          errorDiv.style.display = 'none';
        });
      });

    })();
  </script>
</body>
</html>
```

### Interactive Features
- **Theme Toggle**: Click the button to switch between light and dark themes, changing the page's color palette.
- **Contact Form Validation**: The form checks for empty fields and validates the email format before showing a success or error message.
