      --btn-bg: #5a5a5a;
      --btn-text: #6a6a6a;
      --form-bg: #7a7a7a;
      --form-border: #8a8a8a;
      --error-color: #9a9a9a;
      --hero-bg: #1a1a1a;
      --hero-heading: #2b2b2b;
      --hero-subtitle: #3b3b3b;
      --hero-btn: #4b4b4b;
    }

    /* Dark theme overrides */
    [data-theme="dark"] {
      --bg-color: #2d2d2d;
      --text-color: #3d3d3d;
      --heading-color: #4d4d4d;
      --link-color: #5d5d5d;
      --btn-bg: #6d6d6d;
      --btn-text: #7d7d7d;
      --form-bg: #8d8d8d;
      --form-border: #9d9d9d;
      --error-color: #adadad;
      --hero-bg: #1d1d1d;
      --hero-heading: #2d2d2d;
      --hero-subtitle: #3d3d3d;
      --hero-btn: #4d4d4d;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-color);
      font-family: 'Segoe UI', 'Arial', sans-serif;
      padding: 20px;
    }

    /* Navigation */
    nav {
      background-color: var(--heading-color);
      padding: 10px 20px;
      display: flex;
      justify-content: space-around;
    }

    nav a {
      color: var(--link-color);
      margin: 0 10px;
      text-decoration: none;
      font-weight: bold;
    }

    /* Hero */
    .hero {
      background-color: var(--hero-bg);
      padding: 40px;
      text-align: center;
    }

    .hero h1 {
      color: var(--hero-heading);
      font-size: 2.5rem;
      margin-bottom: 10px;
    }

    .hero p {
      color: var(--hero-subtitle);
      font-size: 1.2rem;
      margin: 10px 0 20px;
    }

    .hero button {
      background-color: var(--hero-btn);
      padding: 12px 24px;
      border: 2px solid var(--hero-btn);
      color: var(--hero-btn);
      font-size: 1.2rem;
      cursor: pointer;
    }

    /* Contact form */
    .contact-form {
      background-color: var(--form-bg);
      border: 2px solid var(--form-border);
      padding: 20px;
      max-width: 500px;
    }

    .contact-form label {
      display: block;
      margin: 8px 0;
    }

    .contact-form input, 
    .contact-form textarea {
      width: 100%;
      padding: 8px 12px;
      border: 1px solid var(--form-border);
      background-color: var(--form-bg);
    }

    .contact-form .error {
      color: var(--error-color);
      font-size: 0.9rem;
      margin: 4px 0;
    }

    .contact-form button {
      background-color: var(--btn-bg);
      color: var(--btn-text);
      padding: 10px 20px;
      border: 1px solid var(--btn-bg);
      cursor: pointer;
    }

    /* Theme toggle */
    .theme-toggle {
      background-color: var(--btn-bg);
      color: var(--btn-text);
      padding: 10px 20px;
      border: 1px solid var(--btn-bg);
      cursor: pointer;
      margin: 20px 0;
    }

    /* Layout helpers */
    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 20px;
    }

    /* Responsive */
    @media (max-width: 600px) {
      nav { flex-direction: column; }
      .hero { padding: 20px; }
      .contact-form { max-width: 100%; }
    }
