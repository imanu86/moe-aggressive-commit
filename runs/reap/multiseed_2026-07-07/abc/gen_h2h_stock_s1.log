        /* ----- light theme (default) ----- */
        :root {
            --bg: #fafafa;
            --text: #1e1e1e;
            --nav-bg: #ffffff;
            --nav-border: #d0d0d0;
            --hero-bg: #f0f4ff;
            --btn-bg: #1e3a5f;
            --btn-text: #ffffff;
            --card-bg: #ffffff;
            --input-border: #bbb;
            --error-color: #b00020;
        }

        /* ----- dark theme (toggled via .dark-mode) ----- */
        .dark-mode {
            --bg: #1a1a1a;
            --text: #eaeaea;
            --nav-bg: #2a2a2a;
            --nav-border: #444;
            --hero-bg: #2b2b3a;
            --btn-bg: #7c8bff;
            --btn-text: #0f0f0f;
            --card-bg: #2e2e2e;
            --input-border: #666;
            --error-color: #ff7a7a;
        }

        /* apply variables */
        body {
            background-color: var(--bg);
            color: var(--text);
        }

        /* ----- layout & components ----- */
        .container {
            max-width: 960px;
            margin: 0 auto;
            padding: 1rem 0;
        }

        /* --- navigation --- */
        nav {
            background: var(--nav-bg);
            border-bottom: 1px solid var(--nav-border);
            padding: 0.8rem 0;
            transition: background 0.3s, border 0.3s;
        }

        .nav-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text);
            font-weight: 500;
            padding: 0.3rem 0.2rem;
            border-bottom: 2px solid transparent;
            transition: border-color 0.2s;
        }

        .nav-links a:hover {
            border-bottom-color: var(--btn-bg);
        }

        .theme-toggle {
            background: var(--btn-bg);
            color: var(--btn-text);
            border: none;
            padding: 0.4rem 1.2rem;
            border-radius: 30px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.3s, color 0.3s, transform 0.1s;
            font-size: 0.9rem;
        }

        .theme-toggle:hover {
            transform: scale(1.02);
        }

        /* --- hero --- */
        .hero {
            background: var(--hero-bg);
            padding: 3rem 2rem;
            margin: 2rem 0;
            border-radius: 20px;
            text-align: center;
            transition: background 0.3s;
        }

        .hero h1 {
            font-size: 2.6rem;
            margin-bottom: 0.5rem;
            letter-spacing: -0.02em;
        }

        .hero p {
            font-size: 1.2rem;
            max-width: 480px;
            margin: 0.8rem auto 1.8rem;
            opacity: 0.85;
        }

        .hero .cta {
            background: var(--btn-bg);
            color: var(--btn-text);
            border: none;
            padding: 0.8rem 2.5rem;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 40px;
            cursor: pointer;
            transition: background 0.3s, color 0.3s, transform 0.1s;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        }

        .hero .cta:hover {
            transform: scale(1.02);
        }

        /* --- contact form --- */
        .form-section {
            background: var(--card-bg);
            padding: 2rem 2rem 2.5rem;
            border-radius: 20px;
            margin: 2rem 0;
            transition: background 0.3s;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        }

        .form-section h2 {
            margin-bottom: 1.2rem;
        }

        .form-group {
            margin-bottom: 1.2rem;
            display: flex;
            flex-direction: column;
        }

        label {
            font-weight: 500;
            margin-bottom: 0.3rem;
        }

        input, textarea {
            padding: 0.7rem 0.8rem;
            border: 1px solid var(--input-border);
            border-radius: 10px;
            font-size: 1rem;
            background: var(--bg);
            color: var(--text);
            transition: border 0.2s, background 0.3s, color 0.3s;
        }

        input:focus, textarea:focus {
            outline: 2px solid var(--btn-bg);
            outline-offset: 2px;
        }

        .error-message {
            color: var(--error-color);
            font-size: 0.9rem;
            margin-top: 0.3rem;
            min-height: 1.2rem;
        }

        .form-actions {
            margin-top: 0.8rem;
        }

        .form-actions button {
            background: var(--btn-bg);
            color: var(--btn-text);
            border: none;
            padding: 0.7rem 2rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 40px;
            cursor: pointer;
            transition: background 0.3s, color 0.3s;
        }

        .form-actions button:hover {
            filter: brightness(1.1);
        }

        /* --- footer / spacing --- */
        footer {
            text-align: center;
            padding: 1.5rem 0 2rem;
            opacity: 0.7;
            font-size: 0.9rem;
        }

        /* responsive */
        @media (max-width: 600px) {
            .nav-links {
                gap: 1rem;
                flex-wrap: wrap;
            }
            .hero h1 {
                font-size: 2rem;
            }
        }
    </style>
