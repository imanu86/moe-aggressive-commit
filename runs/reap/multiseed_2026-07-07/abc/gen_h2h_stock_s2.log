        /* ----- light theme (default) ----- */
        :root {
            --bg: #ffffff;
            --text: #1a1a1a;
            --nav-bg: #f8f9fa;
            --nav-link: #2c3e50;
            --nav-hover: #1a73e8;
            --hero-bg: #eef2f5;
            --hero-headline: #111;
            --hero-sub: #2c3e50;
            --btn-bg: #1a73e8;
            --btn-text: #fff;
            --btn-hover: #1557b0;
            --form-bg: #fafafa;
            --form-border: #ccc;
            --form-label: #333;
            --error-color: #d32f2f;
            --footer-text: #555;
        }

        /* ----- dark theme ----- */
        body.dark {
            --bg: #1e1e1e;
            --text: #f0f0f0;
            --nav-bg: #2c2c2c;
            --nav-link: #e0e0e0;
            --nav-hover: #8ab4f8;
            --hero-bg: #2a2a2a;
            --hero-headline: #f0f0f0;
            --hero-sub: #ccc;
            --btn-bg: #8ab4f8;
            --btn-text: #1e1e1e;
            --btn-hover: #a3c4ff;
            --form-bg: #2e2e2e;
            --form-border: #555;
            --form-label: #ddd;
            --error-color: #ff6b6b;
            --footer-text: #aaa;
        }

        /* ----- apply theme vars ----- */
        body {
            background-color: var(--bg);
            color: var(--text);
        }

        /* ----- navigation ----- */
        nav {
            background-color: var(--nav-bg);
            padding: 0.8rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(0,0,0,0.05);
            transition: background-color 0.3s;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--nav-link);
            font-weight: 500;
            transition: color 0.2s;
        }

        .nav-links a:hover {
            color: var(--nav-hover);
        }

        .theme-toggle {
            background: transparent;
            border: 1px solid var(--text);
            color: var(--text);
            padding: 0.4rem 1rem;
            border-radius: 20px;
            cursor: pointer;
            font-weight: 500;
            transition: background 0.2s, color 0.2s, border-color 0.2s;
        }

        .theme-toggle:hover {
            background: var(--text);
            color: var(--bg);
            border-color: var(--text);
        }

        /* ----- hero section ----- */
        .hero {
            background-color: var(--hero-bg);
            padding: 4rem 2rem;
            text-align: center;
            transition: background-color 0.3s;
        }

        .hero h1 {
            font-size: 2.8rem;
            margin-bottom: 0.5rem;
            color: var(--hero-headline);
        }

        .hero p {
            font-size: 1.2rem;
            color: var(--hero-sub);
            max-width: 600px;
            margin: 0 auto 1.5rem;
        }

        .hero .cta {
            background-color: var(--btn-bg);
            color: var(--btn-text);
            border: none;
            padding: 0.9rem 2.5rem;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 40px;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }

        .hero .cta:hover {
            background-color: var(--btn-hover);
            transform: scale(1.02);
        }

        /* ----- contact form ----- */
        .form-section {
            padding: 3rem 2rem;
            max-width: 700px;
            margin: 0 auto;
        }

        .form-section h2 {
            margin-bottom: 1.5rem;
            color: var(--text);
        }

        .contact-form {
            background-color: var(--form-bg);
            padding: 2rem;
            border-radius: 16px;
            border: 1px solid var(--form-border);
            transition: background-color 0.3s, border-color 0.3s;
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }

        .form-group label {
            font-weight: 500;
            color: var(--form-label);
        }

        .form-group input,
        .form-group textarea {
            padding: 0.7rem 0.8rem;
            border: 1px solid var(--form-border);
            border-radius: 10px;
            font-size: 1rem;
            background: var(--bg);
            color: var(--text);
            transition: border-color 0.2s, background 0.3s, color 0.3s;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--btn-bg);
        }

        .form-group textarea {
            min-height: 120px;
            resize: vertical;
        }

        .error-message {
            color: var(--error-color);
            font-size: 0.9rem;
            min-height: 1.2rem;
        }

        .submit-btn {
            background-color: var(--btn-bg);
            color: var(--btn-text);
            border: none;
            padding: 0.9rem 2rem;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 40px;
            cursor: pointer;
            transition: background 0.2s;
            align-self: flex-start;
        }

        .submit-btn:hover {
            background-color: var(--btn-hover);
        }

        /* ----- footer ----- */
        footer {
            text-align: center;
            padding: 1.5rem 2rem;
            color: var(--footer-text);
            border-top: 1px solid var(--form-border);
            margin-top: 2rem;
        }

        /* ----- responsive ----- */
        @media (max-width: 600px) {
            nav {
                flex-direction: column;
                gap: 0.8rem;
            }
            .nav-links {
                gap: 1.2rem;
                flex-wrap: wrap;
                justify-content: center;
            }
            .hero h1 {
                font-size: 2rem;
            }
        }
    </style>
</head>
